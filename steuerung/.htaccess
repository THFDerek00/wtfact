# Dashboard (steuerung.wtfact.xyz). Von außen erreichbar sind nur index.php, api.php, app.html und _astro/.
# lib/ (Code und Zugangsdaten), data/ (Ausweichort für die Datenbank) und config.* bleiben gesperrt.
DirectoryIndex index.php
<FilesMatch "^(config\..*\.php|\.deploy-manifest\.json)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/(lib|data)(/|$)
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>
# Immer HTTPS, damit Passwort und Sitzung nie unverschlüsselt übertragen werden.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>
