---
import Base from './Base.astro';
import type { Lang } from '../config';
interface Props { lang: Lang; title: string }
const { lang, title } = Astro.props;
---
<Base lang={lang} title={title}>
  <article class="narrow page"><h1>{title}</h1><slot /></article>
</Base>
<style>
  .page h1 { font-size: clamp(30px, 5vw, 44px); }
  .page :global(h2) { font-size: 22px; margin-top: 32px; }
</style>
