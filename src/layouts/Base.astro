---
import '../styles/global.css';
import NightSky from '../components/NightSky.astro';
import Icon from '../components/Icon.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { SITE, type Lang } from '../config';
import { t, catsPath, chartsPath, quizPath } from '../i18n/ui';
import { postsFor, postUrl } from '../lib';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  altUrl?: string;
  image?: string;
  /** Aktiver Menüpunkt, falls er sich nicht aus der Adresse ergibt (z. B. „facts“ auf einer Fakt-Seite) */
  section?: 'facts' | 'quiz' | 'cats' | 'charts' | 'game';
}
const { lang, title, description, altUrl, section, image = `/og-default-${Astro.props.lang}.png` } = Astro.props;
const ui = t(lang);
// Browser-Tab zeigt immer nur den Namen; og:title und Beschreibung bleiben aussagekräftig
const desc = description ?? ui.tagline;
const canonical = new URL(Astro.url.pathname, Astro.site);
const other: Lang = lang === 'de' ? 'en' : 'de';
const otherUrl = altUrl ?? `/${other}/`;
// Für „Überrasch mich“: alle Beitrags-URLs dieser Sprache
const allUrls = (await postsFor(lang)).map(postUrl);
// Hauptmenü: oben auf breiten Bildschirmen, als Leiste unten am Handy (gleiche Ziele, kurze Namen).
// Jeder Punkt führt auf eine eigene Seite (kein Springen innerhalb der Startseite), der aktive Bereich ist markiert.
const path = Astro.url.pathname;
const nav = [
  { id: 'facts', href: `/${lang}/`, label: ui.home.navFacts, tab: ui.home.tabs.facts, icon: 'zap' },
  { id: 'quiz', href: quizPath(lang), label: ui.home.navQuiz, tab: ui.home.tabs.quiz, icon: 'target' },
  { id: 'cats', href: catsPath(lang), label: ui.home.catsAll, tab: ui.home.tabs.cats, icon: 'layout-grid' },
  { id: 'charts', href: chartsPath(lang), label: ui.fame.name, tab: ui.home.tabs.charts, icon: 'trophy' },
  { id: 'game', href: `/${lang}/science-jumper/`, label: ui.game.name, tab: ui.home.tabs.game, icon: 'flask-conical' },
].map((n) => ({ ...n, current: section ? section === n.id : n.id === 'facts' ? path === n.href : path.startsWith(n.href) }));
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Hell/Dunkel vor dem ersten Zeichnen setzen, sonst blitzt kurz der falsche Modus auf
      try { const t = localStorage.getItem('wtfact-theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch {}
    </script>
    <title>{SITE.name}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={other} href={new URL(otherUrl, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={lang === 'de' ? canonical : new URL(otherUrl, Astro.site)} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffd23f" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href={`/${lang}/rss.xml`} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content={title ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    {image && <meta property="og:image:width" content="1200" />}
    {image && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="robots" content="max-image-preview:large" />
    {SITE.umami.websiteId && <script is:inline defer src={SITE.umami.script} data-website-id={SITE.umami.websiteId} data-domains="wtfact.xyz"></script>}
  </head>
  <body>
    <NightSky />
    <a class="skip" href="#main">{ui.skip}</a>
    <header class="top">
      <div class="wrap bar">
        <a href={`/${lang}/`} class="logo" aria-label={SITE.name}>
          WTF<span>act</span><b class="sticker">?!</b>
        </a>
        <p class="slogan">{ui.slogan}</p>
        <nav class="mainnav" aria-label={ui.home.nav}>
          {nav.map((n) => <a href={n.href} aria-current={n.current ? 'page' : undefined}>{n.label}</a>)}
        </nav>
        <div class="actions">
          <button class="btn btn--pink surprise" type="button" data-surprise={JSON.stringify(allUrls)} aria-label={ui.surprise}>
            <Icon name="dices" /><span class="label" aria-hidden="true">{ui.surprise}</span>
          </button>
          <button class="chip theme" type="button" data-theme-toggle aria-pressed="false" aria-label={ui.darkMode} title={ui.darkMode}>
            <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" /></svg>
            <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
          </button>
          <a class="chip lang" href={otherUrl} hreflang={other} lang={other}>
            <span aria-hidden="true">{other.toUpperCase()}</span><span class="sr-only">{other === 'de' ? 'Deutsch' : 'English'}</span>
          </a>
        </div>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="foot sec sec--yellow" data-edge>
      <div class="wrap">
        <a href={`/${lang}/`} class="logo big" aria-label={SITE.name}>WTF<span>act</span><b class="sticker">?!</b></a>
        <p class="claim">{ui.slogan}</p>
        <p class="note">{ui.tagline}</p>
        <p class="note">{ui.affiliateFooter} {ui.madeWith}</p>
        <nav>
          <a href={quizPath(lang)}>{ui.home.navQuiz}</a>
          <a href={chartsPath(lang)}>{ui.fame.name}</a>
          <a href={catsPath(lang)}>{ui.home.catsAll}</a>
          <a href={`/${lang}/science-jumper/`}>{ui.game.name}</a>
          <a href={`/${lang}/about/`}>{ui.about}</a>
          <a href={`/${lang}/korrekturen/`}>{ui.corrections}</a>
          <a href={`/${lang}/impressum/`}>{ui.imprint}</a>
          <a href={`/${lang}/datenschutz/`}>{ui.privacy}</a>
          <button class="linkish" type="button" data-consent-open hidden>{ui.consent.settings}</button>
        </nav>
        <p class="copy">© {new Date().getFullYear()} {SITE.name}</p>
      </div>
    </footer>
    <nav class="tabbar" aria-label={ui.home.nav}>
      {nav.map((n) => (
        <a href={n.href} aria-current={n.current ? 'page' : undefined}><Icon name={n.icon} /><span>{n.tab}</span></a>
      ))}
    </nav>
    <CookieConsent lang={lang} />
    <script>
      import { isNew } from '../week';
      // „Neu“ nach 7 Tagen ausblenden, auch wenn die Seite seitdem nicht neu gebaut wurde
      document.querySelectorAll<HTMLElement>('[data-new-date]').forEach((el) => (el.hidden = !isNew(el.dataset.newDate ?? '')));
      // Hell/Dunkel-Umschalter: ohne eigene Wahl gilt die Systemeinstellung
      const root = document.documentElement;
      const system = matchMedia('(prefers-color-scheme: dark)');
      const isDark = () => (root.dataset.theme ? root.dataset.theme === 'dark' : system.matches);
      const syncTheme = () => document.querySelectorAll('[data-theme-toggle]').forEach((b) => b.setAttribute('aria-pressed', String(isDark())));
      document.querySelectorAll('[data-theme-toggle]').forEach((b) =>
        b.addEventListener('click', () => {
          const next = isDark() ? 'light' : 'dark';
          root.dataset.theme = next;
          try { localStorage.setItem('wtfact-theme', next); } catch { /* privates Fenster: gilt nur bis zum Neuladen */ }
          syncTheme();
          dispatchEvent(new Event('wtfact-theme'));
        }),
      );
      system.addEventListener('change', syncTheme);
      syncTheme();
      document.querySelectorAll<HTMLElement>('[data-surprise]').forEach((el) =>
        el.addEventListener('click', () => {
          const urls: string[] = JSON.parse(el.dataset.surprise ?? '[]').filter((u: string) => u !== location.pathname);
          if (urls.length) location.href = urls[Math.floor(Math.random() * urls.length)];
        }),
      );
    </script>
  </body>
</html>

<style>
  .skip { position: absolute; left: var(--space-4); top: calc(-1 * var(--space-12)); z-index: 10; padding: var(--space-2) var(--space-3); background: var(--yellow); color: var(--on-accent); }
  .skip:focus { top: var(--space-4); }
  .top {
    position: sticky; top: 0; z-index: 5;
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: var(--bw) solid var(--line);
  }
  .bar { display: flex; justify-content: space-between; align-items: center; gap: var(--space-4); padding: var(--space-3) 0; }
  .logo {
    font-family: var(--font-display); font-size: var(--fs-3xl); font-weight: 800; line-height: 1;
    letter-spacing: -0.05em; text-decoration: none; white-space: nowrap;
  }
  .logo span { color: var(--pink-text); }
  .logo b { margin-left: var(--space-1); }
  .slogan {
    margin: 0 auto 0 0; font-family: var(--font-display); font-size: var(--fs-sm); font-weight: 700;
    line-height: 1.2; color: var(--muted);
  }
  .actions { display: flex; align-items: center; gap: var(--space-3); }
  /* Hauptmenü (Design „E“): nur auf breiten Bildschirmen, schmal reichen Logo, Zufall und Fußzeile */
  .mainnav { display: flex; gap: var(--space-5); margin-right: var(--space-4); }
  .mainnav a { font-family: var(--font-display); font-weight: 700; font-size: var(--fs-md); text-decoration: none; padding-bottom: var(--space-1); border-bottom: var(--bw-strong) solid transparent; }
  /* Hover nur angedeutet, damit der aktive Bereich (pink) eindeutig bleibt */
  .mainnav a:hover { border-color: color-mix(in srgb, var(--pink) 40%, transparent); }
  .mainnav a[aria-current='page'] { border-color: var(--pink); color: var(--pink-text); }
  @media (max-width: 1060px) { .mainnav { display: none; } }
  /* Leiste unten am Handy und Tablet: alle Bereiche immer mit einem Daumen erreichbar */
  .tabbar { display: none; }
  @media (max-width: 1060px) {
    .tabbar {
      position: fixed; inset: auto 0 0; z-index: 6; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr));
      padding: var(--space-1) var(--space-1) calc(var(--space-1) + env(safe-area-inset-bottom));
      background: var(--night); border-top: var(--bw-strong) solid var(--on-accent);
    }
    .tabbar a {
      display: flex; flex-direction: column; align-items: center; gap: var(--space-1); min-width: 0; padding: var(--space-2) var(--space-1);
      border-radius: var(--radius-sm); color: var(--on-night); text-decoration: none;
      font-family: var(--font-display); font-size: var(--fs-xs); font-weight: 700; line-height: 1.1;
    }
    .tabbar a span { max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .tabbar a :global(.icon) { width: var(--fs-xl); height: var(--fs-xl); }
    /* Gleiche Rückmeldung für jeden Punkt: Antippen drückt ein, aktiver Bereich gelb mit Strich oben */
    .tabbar a { position: relative; transition: background var(--dur) var(--ease), transform var(--dur) var(--ease); }
    .tabbar a:hover { background: color-mix(in srgb, var(--on-night) 12%, transparent); }
    .tabbar a:active { transform: scale(0.94); }
    .tabbar a[aria-current='page'] { background: var(--yellow); color: var(--on-accent); }
    .tabbar a[aria-current='page']::before {
      content: ''; position: absolute; inset: calc(-1 * var(--space-1)) var(--space-3) auto; height: var(--bw-strong);
      border-radius: var(--radius-pill); background: var(--pink);
    }
    /* Platz, damit die Leiste den Fuß nicht verdeckt */
    footer.foot { padding-bottom: calc(var(--space-12) + var(--space-12)); }
  }
  @media (max-width: 1360px) and (min-width: 1061px) { .slogan { display: none; } .mainnav { margin-left: auto; } }
  .surprise { padding: var(--space-2) var(--space-4); font-size: var(--fs-sm); }
  .lang { padding: var(--space-1) var(--space-3); font-size: var(--fs-sm); }
  .theme { padding: var(--space-1) var(--space-2); cursor: pointer; }
  .theme svg { width: var(--fs-lg); height: var(--fs-lg); fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  /* Zeigt, wohin man wechselt: im hellen Modus der Mond, im dunklen die Sonne */
  .theme .sun { display: none; }
  .theme[aria-pressed='true'] .sun { display: block; }
  .theme[aria-pressed='true'] .moon { display: none; }
  .theme[aria-pressed='true'] { box-shadow: none; transform: none; }
  .theme[aria-pressed='true']::before { content: none; }
  /* Fuß im Design „E“: gelb mit Punkten und schräger Kante, Logo riesig */
  .foot { margin-top: calc(var(--space-12) + var(--edge)); padding: var(--space-12) 0 var(--space-10); font-size: var(--fs-sm); }
  /* Endet die Seite mit einem farbigen Abschnitt, schließt der Fuß direkt an (schräge Kante statt Lücke) */
  main:has(> .sec:last-child) + .foot { margin-top: 0; }
  .foot .logo { font-size: var(--fs-display-2xl); }
  .foot .logo span { color: var(--on-accent); -webkit-text-stroke: 0; text-decoration: underline; text-decoration-color: var(--pink); text-decoration-thickness: var(--space-2); text-underline-offset: var(--space-1); }
  .claim { font-family: var(--font-display); font-size: var(--fs-xl); font-weight: 700; line-height: 1.3; margin: var(--space-4) 0 var(--space-6); max-width: 30ch; }
  .note + .note { margin-top: var(--space-2); }
  .note { margin: 0; max-width: 62ch; }
  .foot nav { display: flex; flex-wrap: wrap; gap: var(--space-5); margin: var(--space-5) 0; }
  .foot nav a, .foot nav .linkish { font-weight: 600; }
  .copy { margin: 0; font-weight: 600; }
  @media (max-width: 760px) {
    .slogan { display: none; }
  }
  @media (max-width: 520px) {
    .logo { font-size: var(--fs-2xl); }
    .surprise .label { display: none; }
  }
</style>
