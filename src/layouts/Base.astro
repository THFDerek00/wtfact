---
import '../styles/global.css';
import { SITE, type Lang } from '../config';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  altUrl?: string;
  image?: string;
}
const { lang, title, description, altUrl, image } = Astro.props;
const ui = t(lang);
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name}: ${ui.tagline}`;
const desc = description ?? ui.tagline;
const canonical = new URL(Astro.url.pathname, Astro.site);
const other: Lang = lang === 'de' ? 'en' : 'de';
const otherUrl = altUrl ?? `/${other}/`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={other} href={new URL(otherUrl, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href={`/${lang}/rss.xml`} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content={title ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class="top wrap">
      <a href={`/${lang}/`} class="logo" aria-label={SITE.name}>
        WTF<span>act</span><b class="accent">?!</b>
      </a>
      <a class="lang chip" href={otherUrl} hreflang={other} lang={other}>
        {other === 'de' ? '🇩🇪 Deutsch' : '🇬🇧 English'}
      </a>
    </header>
    <main><slot /></main>
    <footer class="wrap foot">
      <p class="note">{ui.affiliateFooter} {ui.madeWith}</p>
      <nav>
        <a href={`/${lang}/about/`}>{ui.about}</a>
        <a href={`/${lang}/impressum/`}>{ui.imprint}</a>
        <a href={`/${lang}/datenschutz/`}>{ui.privacy}</a>
      </nav>
      <p class="copy">© {new Date().getFullYear()} {SITE.name}</p>
    </footer>
  </body>
</html>

<style>
  .top { display: flex; justify-content: space-between; align-items: center; padding: var(--space-5) 0; }
  .logo {
    font-family: var(--font-display); font-size: var(--fs-3xl); font-weight: 800; line-height: 1;
    letter-spacing: -0.04em; text-decoration: none;
  }
  .logo span { color: var(--pink-text); }
  .logo b { display: inline-block; margin-left: var(--space-1); padding: 0 var(--space-2); border-radius: var(--radius-sm); transform: rotate(-6deg); }
  .foot { margin-top: var(--space-12); padding: var(--space-7) 0 var(--space-10); border-top: var(--bw) solid var(--line); font-size: var(--fs-sm); color: var(--muted); }
  .foot nav { display: flex; flex-wrap: wrap; gap: var(--space-5); margin: var(--space-3) 0; }
  .foot nav a { color: var(--ink); font-weight: 600; }
  .note { margin: 0; max-width: 60ch; }
  .copy { margin: 0; }
</style>
