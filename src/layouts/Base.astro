---
import '../styles/global.css';
import NightSky from '../components/NightSky.astro';
import Icon from '../components/Icon.astro';
import CookieConsent from '../components/CookieConsent.astro';
import PageFlow from '../components/PageFlow.astro';
import { SITE, type Lang } from '../config';
import { t, catsPath, chartsPath, quizPath } from '../i18n/ui';
import { x, gamesPath, mePath, numberPath, youPath, giftsPath, jumperPath } from '../i18n/extras';
import { postsFor, postUrl } from '../lib';
import FestDeco from '../components/FestDeco.astro';
import { holidayOn, festOfHoliday } from '../data/holidays';
import { berlinDay } from '../week';
import XmasLights from '../components/xmas/XmasLights.astro';
import XmasHat from '../components/xmas/XmasHat.astro';
import XmasDrift from '../components/xmas/XmasDrift.astro';
import { inSeason, doorOf } from '../data/advent';
import { inSpooky, PUMPKIN_TOTAL } from '../data/halloween';
import { ht } from '../i18n/halloween';
import PumpkinLights from '../components/halloween/PumpkinLights.astro';
import PumpkinStem from '../components/halloween/PumpkinStem.astro';
import { at, adventPath } from '../i18n/advent';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  altUrl?: string;
  image?: string;
  /** Aktiver Menüpunkt, falls er sich nicht aus der Adresse ergibt (z. B. „facts“ auf einer Fakt-Seite) */
  section?: 'facts' | 'games' | 'cats' | 'charts' | 'me';
  /** Farbwelt eines Feiertags- oder Grusel-Fakts (src/data/holidays.ts), färbt die ganze Seite um */
  fest?: string;
}
const { lang, title, description, altUrl, section, fest, image = `/og-default-${Astro.props.lang}.png` } = Astro.props;
// Am Feiertag selbst (Wunsch von Eric, 2026-10-15) trägt die ganze Seite die Farben und die Deko des Festes.
// Der Browser nimmt beides am nächsten Tag wieder weg, auch wenn die Seite noch nicht neu gebaut wurde (Skript unten).
const today = berlinDay();
const holidayToday = holidayOn(today);
const siteFest = holidayToday ? festOfHoliday(holidayToday) : undefined;
// Weihnachtszeit vom 1. Advent bis 26.12. (Wunsch von Eric, 2026-10-21, src/data/advent.ts): data-season auf <html>.
// Das Skript im <head> rechnet es vor dem ersten Zeichnen im Browser nach, src/scripts/xmas.ts stellt Zahlen und Kerzen ein.
const season = inSeason(today);
// Gruselwoche vom 24. bis 31.10. (Wunsch von Eric, 2026-10-21, src/data/halloween.ts): data-season='halloween'.
const spooky = inSpooky(today);
const hw = ht(lang);
const door = season ? doorOf(today) : 0;
const xa = at(lang);
const ui = t(lang);
// Browser-Tab zeigt immer nur den Namen; og:title und Beschreibung bleiben aussagekräftig
const desc = description ?? ui.tagline;
const canonical = new URL(Astro.url.pathname, Astro.site);
const other: Lang = lang === 'de' ? 'en' : 'de';
const otherUrl = altUrl ?? `/${other}/`;
// Für „Überrasch mich“: alle Beitrags-URLs dieser Sprache
const allUrls = (await postsFor(lang)).map(postUrl);
// Hauptmenü: oben auf breiten Bildschirmen, als Leiste unten am Handy (gleiche Ziele, kurze Namen).
// Jeder Punkt führt auf eine eigene Seite (kein Springen innerhalb der Startseite), der aktive Bereich ist markiert.
const path = Astro.url.pathname;
// Seit 2026-10-21 (Wunsch von Eric): „Spiele“ statt „Quiz“ (Tageszahl, Quiz, Science Jumper) und „Ich“ statt
// „Science Jumper“ (Serie, Sammlung, Du in Zahlen, Geschenkfinder). `also` = weitere Seiten, die zum Punkt gehören.
const xt = x(lang);
const nav = [
  { id: 'facts', href: `/${lang}/`, label: ui.home.navFacts, tab: ui.home.tabs.facts, icon: 'zap', also: [] as string[] },
  { id: 'games', href: gamesPath(lang), label: xt.nav.games, tab: xt.nav.gamesTab, icon: 'gamepad-2', also: [quizPath(lang), numberPath(lang), `/${lang}/science-jumper/`] },
  { id: 'cats', href: catsPath(lang), label: ui.home.catsAll, tab: ui.home.tabs.cats, icon: 'layout-grid', also: [] },
  { id: 'charts', href: chartsPath(lang), label: ui.fame.name, tab: ui.home.tabs.charts, icon: 'trophy', also: [] },
  { id: 'me', href: mePath(lang), label: xt.nav.me, tab: xt.nav.meTab, icon: 'flame', also: [youPath(lang), giftsPath(lang)] },
].map((n) => ({ ...n, current: section ? section === n.id : n.id === 'facts' ? path === n.href : [n.href, ...n.also].some((h) => path.startsWith(h)) }));
---
<!doctype html>
<html lang={lang} data-season={season ? 'xmas' : spooky ? 'halloween' : undefined} data-door={door || undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Hell/Dunkel vor dem ersten Zeichnen setzen, sonst blitzt kurz der falsche Modus auf
      try { const t = localStorage.getItem('wtfact-theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch {}
      // Weihnachtszeit: 1. Advent (4. Sonntag vor dem 25.12.) bis 26.12., gleiche Rechnung wie src/data/advent.ts.
      // ?vorschau=JJJJ-MM-TT zeigt einen anderen Tag (bis der Tab zu ist), ?vorschau= ohne Datum beendet die Vorschau.
      try {
        const r = document.documentElement, q = new URLSearchParams(location.search).get('vorschau');
        if (q !== null) q ? sessionStorage.setItem('wtfact:today', q) : sessionStorage.removeItem('wtfact:today');
        let d = sessionStorage.getItem('wtfact:today') || '';
        if (!/^\d{4}-\d\d-\d\d$/.test(d)) d = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Berlin', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());
        const y = +d.slice(0, 4), e = Date.UTC(y, 11, 24), f = new Date(e - (new Date(e).getUTCDay() + 21) * 864e5).toISOString().slice(0, 10);
        const on = d >= f && d <= y + '-12-26', n = on && d.slice(5, 7) === '12' ? +d.slice(8) : 0;
        // Gruselwoche 24. bis 31.10., gleiche Rechnung wie src/data/halloween.ts
        const md = d.slice(5), spooky = md >= '10-24' && md <= '10-31';
        if (on) r.dataset.season = 'xmas'; else if (spooky) r.dataset.season = 'halloween'; else delete r.dataset.season;
        if (n && n <= 24) r.dataset.door = String(n); else delete r.dataset.door;
      } catch {}
    </script>
    <title>{SITE.name}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={other} href={new URL(otherUrl, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={lang === 'de' ? canonical : new URL(otherUrl, Astro.site)} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffd23f" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href={`/${lang}/rss.xml`} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content={title ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    {image && <meta property="og:image:width" content="1200" />}
    {image && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="robots" content="max-image-preview:large" />
    {SITE.umami.websiteId && <script is:inline defer src={SITE.umami.script} data-website-id={SITE.umami.websiteId} data-domains="wtfact.xyz"></script>}
  </head>
  <body data-fest={fest ?? siteFest?.theme} data-fest-day={siteFest && !fest ? today : undefined}>
    <NightSky />
    {siteFest && <FestDeco deco={siteFest.deco} size="page" day={today} />}
    <a class="skip" href="#main">{ui.skip}</a>
    <header class="top">
      <XmasLights />
      <PumpkinLights />
      <div class="wrap bar">
        <a href={`/${lang}/`} class="logo" aria-label={SITE.name}>
          WTF<span>act</span><b class="sticker">?!<XmasHat /><PumpkinStem /></b>
        </a>
        <p class="slogan">{ui.slogan}</p>
        <nav class="mainnav" aria-label={ui.home.nav}>
          {nav.map((n) => <a href={n.href} aria-current={n.current ? 'page' : undefined}>{n.label}{n.id === 'me' && <span class="streak" data-streak-badge hidden></span>}</a>)}
        </nav>
        <div class="actions">
          <a class="btn h-btn halloween" href={`/${lang}/#kuerbisse`}>
            <span aria-hidden="true">🍬</span><span class="label" aria-hidden="true">{hw.candy}</span> <b aria-hidden="true"><span data-h-count>0</span>/{PUMPKIN_TOTAL}</b>
            <span class="sr-only" data-h-count={hw.counter}>{hw.counter.replace('{n}', '0').replace('{total}', String(PUMPKIN_TOTAL))}</span>
          </a>
          <a class="btn door-btn" href={adventPath(lang)} data-x-door-link aria-label={xa.name}>
            <span aria-hidden="true">🎁</span><span class="label">{xa.doorShort}</span> <b data-x-door-no>{door || 1}</b>
          </a>
          <button class="btn btn--pink surprise" type="button" data-surprise={JSON.stringify(allUrls)} aria-label={ui.surprise}>
            <Icon name="dices" /><span class="label" aria-hidden="true">{ui.surprise}</span>
          </button>
          <button class="chip theme" type="button" data-theme-toggle aria-pressed="false" aria-label={ui.darkMode} title={ui.darkMode}>
            <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" /></svg>
            <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
          </button>
          <a class="chip lang" href={otherUrl} hreflang={other} lang={other}>
            <span aria-hidden="true">{other.toUpperCase()}</span><span class="sr-only">{other === 'de' ? 'Deutsch' : 'English'}</span>
          </a>
        </div>
      </div>
    </header>
    <main id="main"><slot /></main>
    <PageFlow />
    <footer class="foot sec fest-sky" data-fest="fest" data-edge>
      <XmasDrift />
      <span class="no-xmas no-halloween"><FestDeco deco={['sparkle', 'star', 'question', 'bolt']} size="lg" /></span>
      <span class="halloween"><FestDeco deco={['pumpkin', 'bat', 'candy', 'ghost']} size="lg" /></span>
      <span class="xmas"><FestDeco deco={['snowflake', 'star', 'fir', 'bell']} size="lg" /></span>
      <div class="wrap">
        <a href={`/${lang}/`} class="logo big" aria-label={SITE.name}>WTF<span>act</span><b class="sticker">?!<XmasHat big /><PumpkinStem big /></b></a>
        <p class="claim">{ui.slogan}</p>
        <p class="note">{ui.tagline}</p>
        <p class="note">{ui.affiliateFooter} {ui.madeWith}</p>
        <nav>
          <a href={gamesPath(lang)}>{xt.nav.games}</a>
          <a href={numberPath(lang)}>{xt.footer.number}</a>
          <a href={`${quizPath(lang)}#wof`}>{ui.home.navQuiz}</a>
          <a href={chartsPath(lang)}>{ui.fame.name}</a>
          <a href={catsPath(lang)}>{ui.home.catsAll}</a>
          <a href={jumperPath(lang)}>{ui.game.name}</a>
          <a href={adventPath(lang)}>🎄 {xa.name}</a>
          <a href={giftsPath(lang)}>{xt.footer.gifts}</a>
          <a href={youPath(lang)}>{xt.footer.you}</a>
          <a href={`/${lang}/about/`}>{ui.about}</a>
          <a href={`/${lang}/korrekturen/`}>{ui.corrections}</a>
          <a href={`/${lang}/impressum/`}>{ui.imprint}</a>
          <a href={`/${lang}/datenschutz/`}>{ui.privacy}</a>
          <button class="linkish" type="button" data-consent-open hidden>{ui.consent.settings}</button>
        </nav>
        <p class="copy">© {new Date().getFullYear()} {SITE.name}</p>
      </div>
    </footer>
    <nav class="tabbar" aria-label={ui.home.nav}>
      {nav.map((n) => (
        <a href={n.href} aria-current={n.current ? 'page' : undefined}><Icon name={n.icon} /><span>{n.tab}{n.id === 'me' && <b class="streak" data-streak-badge hidden></b>}</span></a>
      ))}
    </nav>
    <!-- Gruselwoche (src/scripts/halloween.ts): Meldung für gefundene Kürbisse, Spuknacht am 31.10. mit Taschenlampe und geheimem Fakt -->
    <div class="h-toast" data-h-toast role="status" hidden>
      <span class="h-toast-ic" aria-hidden="true">🍬</span>
      <div><b data-h-toast-title></b><span data-h-toast-text></span> <a data-h-toast-link hidden></a></div>
      <button type="button" class="h-toast-x" data-h-toast-close aria-label={hw.pumpkin.close}>×</button>
    </div>
    <div class="h-night" data-h-night hidden>
      <div class="h-night-bar">
        <span aria-hidden="true">🔦</span>
        <div><b>{hw.night.title}</b> <span>{path === `/${lang}/` ? hw.night.text : hw.night.textAway}</span></div>
        {path !== `/${lang}/` && <a class="btn" href={`/${lang}/#kuerbisse`}>{hw.night.home}</a>}
        <button type="button" class="btn" data-h-light>{hw.night.light}</button>
      </div>
    </div>
    <dialog class="h-secret" data-h-secret>
      <form method="dialog">
        <p class="h-secret-k">🎃 {hw.night.foundTitle}</p>
        <p>{hw.night.secret}</p>
        <p class="h-secret-src"><a href={hw.night.sourceUrl} rel="noopener" target="_blank">{hw.night.source}</a></p>
        <button class="btn" type="submit">{hw.pumpkin.close}</button>
      </form>
    </dialog>
    <CookieConsent lang={lang} />
    <script>
      import { isNew, berlinDay } from '../week';
      import { streakInfo } from '../scripts/streak';
      import { applySeason } from '../scripts/xmas';
      import { applySpooky, spookNight } from '../scripts/halloween';
      // Weihnachtszeit: Advent, Kerzen, Türchen des Tages und Schnee, Gruselwoche (src/scripts/xmas.ts)
      applySeason();
      // Gruselwoche: Kürbis-Zähler, Nächte bis Halloween, am 31.10. die Spuknacht (src/scripts/halloween.ts)
      applySpooky();
      spookNight();
      addEventListener('wtfact-pumpkins', () => applySpooky());
      // Serien-Zahl am Menüpunkt „Ich“ (neben dem Flammen-Symbol), sobald eine Serie läuft
      const showStreak = () => {
        const n = streakInfo().current;
        document.querySelectorAll<HTMLElement>('[data-streak-badge]').forEach((el) => { el.hidden = n < 1; el.textContent = String(n); });
      };
      showStreak();
      addEventListener('wtfact-streak', showStreak);
      // Feiertags-Farben und -Deko nur am Feiertag selbst
      const festDay = document.body.dataset.festDay;
      if (festDay && festDay !== berlinDay()) delete document.body.dataset.fest;
      document.querySelectorAll<HTMLElement>('[data-fest-deco]').forEach((el) => el.dataset.festDeco !== berlinDay() && el.remove());
      // „Neu“ nach 7 Tagen ausblenden, auch wenn die Seite seitdem nicht neu gebaut wurde
      document.querySelectorAll<HTMLElement>('[data-new-date]').forEach((el) => (el.hidden = !isNew(el.dataset.newDate ?? '')));
      // Hell/Dunkel-Umschalter: ohne eigene Wahl gilt die Systemeinstellung
      const root = document.documentElement;
      const system = matchMedia('(prefers-color-scheme: dark)');
      const isDark = () => (root.dataset.theme ? root.dataset.theme === 'dark' : system.matches);
      const syncTheme = () => document.querySelectorAll('[data-theme-toggle]').forEach((b) => b.setAttribute('aria-pressed', String(isDark())));
      document.querySelectorAll('[data-theme-toggle]').forEach((b) =>
        b.addEventListener('click', () => {
          const next = isDark() ? 'light' : 'dark';
          root.dataset.theme = next;
          try { localStorage.setItem('wtfact-theme', next); } catch { /* privates Fenster: gilt nur bis zum Neuladen */ }
          syncTheme();
          dispatchEvent(new Event('wtfact-theme'));
        }),
      );
      system.addEventListener('change', syncTheme);
      syncTheme();
      document.querySelectorAll<HTMLElement>('[data-surprise]').forEach((el) =>
        el.addEventListener('click', () => {
          const urls: string[] = JSON.parse(el.dataset.surprise ?? '[]').filter((u: string) => u !== location.pathname);
          if (urls.length) location.href = urls[Math.floor(Math.random() * urls.length)];
        }),
      );
    </script>
  </body>
</html>

<style>
  .skip { position: absolute; left: var(--space-4); top: calc(-1 * var(--space-12)); z-index: 10; padding: var(--space-2) var(--space-3); background: var(--yellow); color: var(--on-accent); }
  .skip:focus { top: var(--space-4); }
  .top {
    position: sticky; top: 0; z-index: 5;
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: var(--bw) solid var(--line);
  }
  .bar { display: flex; justify-content: space-between; align-items: center; gap: var(--space-4); padding: var(--space-3) 0; }
  .logo {
    font-family: var(--font-logo); font-size: var(--fs-3xl); font-weight: 800; line-height: 1;
    letter-spacing: -0.05em; text-decoration: none; white-space: nowrap;
  }
  .logo span { color: var(--pink-text); }
  .logo b { margin-left: var(--space-1); }
  .slogan {
    margin: 0 auto 0 0; font-family: var(--font-display); font-size: var(--fs-sm); font-weight: 700;
    line-height: 1.2; color: var(--muted);
  }
  .actions { display: flex; align-items: center; gap: var(--space-3); }
  /* Hauptmenü (Design „E“): nur auf breiten Bildschirmen, schmal reichen Logo, Zufall und Fußzeile */
  .mainnav { display: flex; gap: var(--space-5); margin-right: var(--space-4); }
  .mainnav a { font-family: var(--font-display); font-weight: 700; font-size: var(--fs-md); text-decoration: none; padding-bottom: var(--space-1); border-bottom: var(--bw-strong) solid transparent; }
  /* Hover nur angedeutet, damit der aktive Bereich (pink) eindeutig bleibt */
  .mainnav a:hover { border-color: color-mix(in srgb, var(--pink) 40%, transparent); }
  .mainnav a[aria-current='page'] { border-color: var(--pink); color: var(--pink-text); }
  /* Serie am Menüpunkt „Ich“ */
  .streak { display: inline-grid; place-items: center; min-width: 1.5em; margin-left: var(--space-1); padding: 0 var(--space-1); border-radius: var(--radius-pill); background: var(--pink); color: var(--on-accent); font-family: var(--font-display); font-size: var(--fs-xs); font-weight: 800; line-height: 1.5; }
  .streak[hidden] { display: none; }
  .tabbar .streak { margin: 0 0 0 var(--space-1); }
  @media (max-width: 1060px) { .mainnav { display: none; } }
  /* Leiste unten am Handy und Tablet: alle Bereiche immer mit einem Daumen erreichbar */
  .tabbar { display: none; }
  @media (max-width: 1060px) {
    .tabbar {
      position: fixed; inset: auto 0 0; z-index: 6; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr));
      padding: var(--space-1) var(--space-1) calc(var(--space-1) + env(safe-area-inset-bottom));
      background: var(--night); border-top: var(--bw-strong) solid var(--on-accent);
    }
    .tabbar a {
      display: flex; flex-direction: column; align-items: center; gap: var(--space-1); min-width: 0; padding: var(--space-2) var(--space-1);
      border-radius: var(--radius-sm); color: var(--on-night); text-decoration: none;
      font-family: var(--font-display); font-size: var(--fs-xs); font-weight: 700; line-height: 1.1;
    }
    .tabbar a span { max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .tabbar a :global(.icon) { width: var(--fs-xl); height: var(--fs-xl); }
    /* Gleiche Rückmeldung für jeden Punkt: Antippen drückt ein, aktiver Bereich gelb mit Strich oben */
    .tabbar a { position: relative; transition: background var(--dur) var(--ease), transform var(--dur) var(--ease); }
    .tabbar a:hover { background: color-mix(in srgb, var(--on-night) 12%, transparent); }
    .tabbar a:active { transform: scale(0.94); }
    .tabbar a[aria-current='page'] { background: var(--yellow); color: var(--on-accent); }
    .tabbar a[aria-current='page']::before {
      content: ''; position: absolute; inset: calc(-1 * var(--space-1)) var(--space-3) auto; height: var(--bw-strong);
      border-radius: var(--radius-pill); background: var(--pink);
    }
    /* Platz, damit die Leiste den Fuß nicht verdeckt */
    footer.foot { padding-bottom: calc(var(--space-12) + var(--space-12)); }
  }
  @media (max-width: 1360px) and (min-width: 1061px) { .slogan { display: none; } .mainnav { margin-left: auto; } }
  .surprise { padding: var(--space-2) var(--space-4); font-size: var(--fs-sm); }
  /* Weihnachtszeit: Mütze auf dem „?!“, vom 1. bis 24.12. führt der Knopf statt „Überrasch mich“ zum Türchen des Tages */
  .sticker { position: relative; }
  .door-btn { display: none; padding: var(--space-2) var(--space-4); font-size: var(--fs-sm); background: var(--fest-xmas-a); color: var(--on-accent); text-decoration: none; gap: var(--space-1); }
  :global([data-season='xmas'][data-door]) .door-btn { display: inline-flex; }
  :global([data-season='xmas'][data-door]) .surprise { display: none; }
  .foot > .no-xmas, .foot > .xmas, .foot > .halloween { position: absolute; inset: 0; pointer-events: none; }
  /* Gruselwoche: Kürbisstiel auf dem „?!“, der Knopf zählt gefundene Kürbisse und steht statt „Überrasch mich“ */
  .h-btn { display: inline-flex; padding: var(--space-2) var(--space-4); font-size: var(--fs-sm); background: var(--hw-pumpkin); color: var(--on-accent); text-decoration: none; gap: var(--space-1); }
  .h-btn b { font-family: var(--font-headline); font-weight: 400; }
  :global([data-season='halloween']) .surprise { display: none; }
  .h-toast {
    position: fixed; left: 50%; bottom: var(--space-6); z-index: 30; translate: -50% 0; width: min(36rem, calc(100% - var(--space-8)));
