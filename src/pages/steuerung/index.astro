---
// Oberfläche des Dashboards (steuerung.wtfact.xyz, Wunsch von Eric, 2026-10-08).
// Wird mitgebaut, landet aber nicht auf der Seite: scripts/bundle-steuerung.mjs verschiebt sie als app.html
// zu den PHP-Dateien aus steuerung/ nach dist-steuerung/. Daten und Anmeldung kommen von steuerung/api.php.
// Logik im Browser: src/scripts/steuerung.ts.
import '../../styles/global.css';
import { CATEGORIES } from '../../config';
import { t } from '../../i18n/ui';

const cats = t('de').categories;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>WTFact Steuerung</title>
    <script is:inline>
      try { const t = localStorage.getItem('wtfact-theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch {}
    </script>
  </head>
  <body data-cats={JSON.stringify(cats)}>
    <section class="login-view" data-view="login" hidden>
      <form class="login card" data-login>
        <p class="brand"><span>WTFact</span> <span class="sticker">Steuerung</span></p>
        <label>Benutzer <input name="user" autocomplete="username" required /></label>
        <label>Passwort <input name="password" type="password" autocomplete="current-password" required /></label>
        <button class="btn" type="submit">Anmelden</button>
        <p class="error" data-login-error role="alert" hidden></p>
      </form>
    </section>

    <div data-view="app" hidden>
      <header class="stage top">
        <div class="dash-wrap top-bar">
          <p class="brand"><span>WTFact</span> <span class="sticker">Steuerung</span></p>
          <nav class="tabs" role="group" aria-label="Bereiche">
            <button class="tab" type="button" data-tab-btn="plan" aria-pressed="true">Veröffentlichungen</button>
            <button class="tab" type="button" data-tab-btn="all" aria-pressed="false">Alle Fakten</button>
          </nav>
          <div class="top-actions">
            <span class="sync" data-sync aria-live="polite"></span>
            <button class="btn btn--ghost btn-sm" type="button" data-refresh>Aktualisieren</button>
            <button class="btn btn--ghost btn-sm" type="button" data-logout>Abmelden</button>
          </div>
        </div>
      </header>

      <div class="dash-wrap notices">
        <p class="toast card" data-toast role="status" hidden></p>
        <ul class="prs" data-prs></ul>
      </div>

      <main class="dash-wrap">
        <section class="plan" data-tab="plan">
          <aside class="pool card" data-drop="pool" aria-labelledby="pool-title">
            <div class="pool-head">
              <h2 id="pool-title">Pool <span class="count" data-pool-count></span></h2>
              <p class="hint">Noch nicht eingeplant. Ziehen in einen Slot, oder antippen und dann einen Slot wählen. Zurück in den Pool: hierher ziehen.</p>
              <label class="sr-only" for="pool-search">Pool durchsuchen</label>
              <input id="pool-search" class="search" type="search" placeholder="Suchen…" data-pool-search />
            </div>
            <ul class="fact-list" data-pool></ul>
            <p class="empty" data-pool-empty hidden>Der Pool ist leer. Neue Fakten kommen mit dem Wochenlauf.</p>
          </aside>

          <div class="week">
            <div class="week-nav">
              <button class="btn btn--ghost btn-sm" type="button" data-week="-1" aria-label="Vorige Woche">‹</button>
              <h2 data-week-label></h2>
              <button class="btn btn--ghost btn-sm" type="button" data-week="1" aria-label="Nächste Woche">›</button>
              <button class="btn btn--ghost btn-sm" type="button" data-week="0">Diese Woche</button>
              <p class="selected" data-selected hidden></p>
            </div>
            <ol class="days" data-days></ol>
          </div>
        </section>

        <section class="all" data-tab="all" hidden>
          <div class="filters">
            <div class="chips" role="group" aria-label="Zustand">
              <button class="chip" type="button" data-status-filter="" aria-pressed="true">Alle</button>
              <button class="chip" type="button" data-status-filter="pool" aria-pressed="false">Pool</button>
              <button class="chip" type="button" data-status-filter="planned" aria-pressed="false">Geplant</button>
              <button class="chip" type="button" data-status-filter="live" aria-pressed="false">Live</button>
              <button class="chip" type="button" data-status-filter="offline" aria-pressed="false">Offline</button>
            </div>
            <label class="sr-only" for="all-search">Fakten durchsuchen</label>
            <input id="all-search" class="search" type="search" placeholder="Titel oder Schlüssel…" data-all-search />
            <label class="sr-only" for="all-cat">Kategorie</label>
            <select id="all-cat" class="select" data-all-cat>
              <option value="">Alle Kategorien</option>
              {CATEGORIES.map((c) => <option value={c}>{cats[c]}</option>)}
            </select>
            <label class="sr-only" for="all-sort">Sortierung</label>
            <select id="all-sort" class="select" data-all-sort>
              <option value="date">Neueste zuerst</option>
              <option value="score">Beliebteste zuerst</option>
              <option value="votes">Meiste Bewertungen</option>
            </select>
          </div>
          <p class="note" data-ratings-note hidden>Bewertungen sind auf diesem Server nicht lesbar, deshalb stehen überall 0.</p>
          <div class="table-wrap card">
            <table class="table">
              <thead>
                <tr><th scope="col">Fakt</th><th scope="col">Zustand</th><th scope="col">Termin</th><th scope="col"><span aria-hidden="true">👍</span><span class="sr-only">Daumen hoch</span></th><th scope="col"><span aria-hidden="true">👎</span><span class="sr-only">Daumen runter</span></th><th scope="col">Aktionen</th></tr>
              </thead>
              <tbody data-rows></tbody>
            </table>
          </div>
          <p class="note" data-all-count></p>
        </section>
      </main>
    </div>

    <dialog class="dialog card" data-special>
      <form method="dialog" data-special-form>
        <h2>Sonderveröffentlichung</h2>
        <p data-special-title></p>
        <label>Uhrzeit am <span data-special-day></span> <input type="time" name="time" required data-special-time /></label>
        <p class="error" data-special-error role="alert" hidden></p>
        <div class="dialog-actions">
          <button class="btn" type="submit" value="plan">Einplanen</button>
          <button class="btn btn--lime" type="button" data-special-now>Sofort veröffentlichen</button>
          <button class="btn btn--ghost" type="button" data-special-cancel>Abbrechen</button>
        </div>
      </form>
    </dialog>

    <script>
      import '../../scripts/steuerung';
    </script>
  </body>
</html>

<style>
  .dash-wrap { width: calc(100% - 2 * var(--gutter)); margin-inline: auto; }
  .brand { margin: 0; font-family: var(--font-display); font-size: var(--fs-xl); font-weight: 800; }

  .login-view { min-height: 100vh; display: grid; place-items: center; padding: var(--space-6); }
  .login { display: grid; gap: var(--space-4); width: min(100%, 380px); padding: var(--space-8); }
  .login label, .dialog label { display: grid; gap: var(--space-1); font-weight: 600; font-size: var(--fs-sm); }
  input, select {
    font: inherit; color: var(--ink); background: var(--surface);
    border: var(--bw-sm) solid var(--line); border-radius: var(--radius-sm); padding: var(--space-2) var(--space-3);
  }
  .error { margin: 0; color: var(--pink-text); font-weight: 600; }

  .top { position: sticky; top: 0; z-index: 5; }
  .top-bar { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4); padding: var(--space-3) 0; }
  .tabs { display: flex; gap: var(--space-2); }
  .tab {
    font: inherit; font-family: var(--font-display); font-weight: 700; cursor: pointer;
    color: var(--on-night); background: transparent; border: var(--bw-sm) solid var(--on-night);
    border-radius: var(--radius-pill); padding: var(--space-2) var(--space-4);
  }
  .tab[aria-pressed='true'] { background: var(--yellow); color: var(--on-accent); border-color: var(--yellow); }
  .top-actions { margin-left: auto; display: flex; align-items: center; gap: var(--space-3); }
  .sync { font-size: var(--fs-sm); color: var(--on-night-muted); }
  :global(.btn-sm) { padding: var(--space-2) var(--space-3); font-size: var(--fs-sm); }

  .notices { display: grid; gap: var(--space-3); margin-top: var(--space-4); }
  .toast { margin: 0; padding: var(--space-3) var(--space-4); font-weight: 600; }
  .toast[data-kind='error'] { background: var(--pink); color: var(--on-accent); }
  .prs { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-2); }
  .prs :global(li) { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); padding: var(--space-3) var(--space-4); }

  main { padding: var(--space-6) 0 var(--space-12); }
  .plan { display: grid; grid-template-columns: minmax(240px, 280px) minmax(0, 1fr); gap: var(--space-6); align-items: start; }
  .pool { position: sticky; top: var(--space-12); max-height: calc(100vh - var(--space-12) - var(--space-6)); display: flex; flex-direction: column; padding: var(--space-4); }
  .pool-head h2 { margin: 0; font-size: var(--fs-xl); }
  .count { font-size: var(--fs-md); color: var(--muted); }
  .hint, .note, .empty { font-size: var(--fs-sm); color: var(--muted); margin: var(--space-2) 0; }
  .search { width: 100%; margin-bottom: var(--space-3); }
  .pool .fact-list { overflow-y: auto; flex: 1; padding: var(--space-1); }
  [data-drop][data-over='true'] { outline: var(--bw-focus) dashed var(--focus); outline-offset: var(--space-1); }

  .week-nav { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); margin-bottom: var(--space-4); }
  .week-nav h2 { margin: 0; font-size: var(--fs-xl); min-width: 16ch; text-align: center; }
  .selected { margin: 0 0 0 auto; padding: var(--space-1) var(--space-3); border-radius: var(--radius-pill); font-size: var(--fs-sm); font-weight: 700; }
  /* Immer eine Woche in einer Reihe; zu schmal: seitlich scrollen */
  .days { list-style: none; margin: 0; padding: 0 0 var(--space-3); display: grid; grid-template-columns: repeat(7, minmax(150px, 1fr)); gap: var(--space-2); overflow-x: auto; }
  .days :global(.day) { display: flex; flex-direction: column; gap: var(--space-2); padding: var(--space-2); box-shadow: var(--shadow-sm); }
  .days :global(.day[aria-current='date']) { box-shadow: var(--shadow-on-night); }
  .days :global(.day-head) { margin: 0; font-family: var(--font-display); font-weight: 800; }
  .days :global(.slot) {
    display: flex; flex-direction: column; gap: var(--space-1); min-height: var(--space-12);
    padding: var(--space-2); border: var(--bw-sm) dashed var(--muted); border-radius: var(--radius-sm);
  }
  .days :global(.slot[data-past='true']) { border-style: solid; border-color: var(--locked); }
  .days :global(.slot-time) { font-size: var(--fs-xs); font-weight: 800; color: var(--muted); letter-spacing: 0.04em; }
  .days :global(.slot-place) {
    font: inherit; font-size: var(--fs-sm); font-weight: 700; cursor: pointer; color: var(--ink);
    background: var(--surface); border: var(--bw-sm) solid var(--line); border-radius: var(--radius-sm); padding: var(--space-1) var(--space-2);
  }
  .days :global(.extra) { border-color: var(--violet); }

  :global(.fact-list) { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-2); }
  :global(.fact) {
    position: relative; display: flex; align-items: center; gap: var(--space-2);
    padding: var(--space-2); border: var(--bw-sm) solid var(--line); border-radius: var(--radius-sm);
    background: var(--surface); box-shadow: var(--shadow-xs); font-size: var(--fs-sm); line-height: 1.3;
  }
  :global(.fact[draggable='true']) { cursor: grab; }
  :global(.fact[aria-selected='true']) { box-shadow: var(--shadow-on-night); transform: translate(-1px, -1px); }
  :global(.fact[data-status='live']), :global(.fact[data-status='due']) { opacity: 0.75; }
  :global(.fact-emoji) {
    flex: 0 0 auto; display: grid; place-items: center; width: var(--space-9); height: var(--space-9);
    border: var(--bw-sm) solid var(--line); border-radius: var(--radius-sm); font-size: var(--fs-lg);
  }
  :global(.fact-pick) {
    flex: 1; min-width: 0; display: grid; gap: var(--space-1); text-align: left;
    font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer;
  }
  :global(.fact-title) { font-weight: 700; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  :global(.fact-meta) { color: var(--muted); font-size: var(--fs-xs); }
  .days :global(.fact) { padding: var(--space-1) var(--space-4) var(--space-1) var(--space-2); }
  /* In den schmalen Tagesspalten zählt der Titel mehr als das Emoji */
  .days :global(.fact-emoji) { display: none; }
  .days :global(.fact-title) { -webkit-line-clamp: 3; }
  .days :global(.fact-list), .days :global(.fact) { min-width: 0; }
  :global(.fact-x) {
    position: absolute; top: calc(-1 * var(--space-2)); right: calc(-1 * var(--space-2)); font: inherit; font-weight: 800; cursor: pointer; color: var(--ink);
    background: var(--surface); border: var(--bw-sm) solid var(--line); border-radius: var(--radius-pill);
    width: var(--space-6); height: var(--space-6); padding: 0; line-height: 1; font-size: var(--fs-xs);
  }

  :global(.st) { display: inline-block; padding: 0 var(--space-2); border: var(--bw-xs) solid var(--line); border-radius: var(--radius-pill); font-size: var(--fs-xs); font-weight: 700; white-space: nowrap; }
  :global(.st-pool) { background: var(--surface); color: var(--ink); }
  :global(.st-planned) { background: var(--cyan); color: var(--on-accent); }
  :global(.st-due) { background: var(--yellow); color: var(--on-accent); }
  :global(.st-live) { background: var(--lime); color: var(--on-accent); }
  :global(.st-offline) { background: var(--pink); color: var(--on-accent); }
  .selected { background: var(--yellow); color: var(--on-accent); }

  .filters { display: flex; flex-wrap: wrap; gap: var(--space-3); align-items: center; margin-bottom: var(--space-4); }
  .chips { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .filters .search { width: auto; flex: 1 1 220px; margin: 0; }
  .table-wrap { overflow-x: auto; }
  .table { width: 100%; border-collapse: collapse; font-size: var(--fs-sm); }
  .table th { text-align: left; font-family: var(--font-display); padding: var(--space-3); border-bottom: var(--bw-sm) solid var(--line); }
  .table :global(td) { padding: var(--space-2) var(--space-3); border-bottom: var(--bw-xs) solid var(--locked); vertical-align: middle; }
  .table :global(.cell-fact) { display: flex; align-items: center; gap: var(--space-2); min-width: 280px; }
  .table :global(.cell-actions) { display: flex; flex-wrap: wrap; gap: var(--space-1); }
  .table :global(.num) { font-variant-numeric: tabular-nums; text-align: right; }

  .dialog { padding: var(--space-6); width: min(92vw, 440px); color: var(--ink); }
  .dialog::backdrop { background: color-mix(in srgb, var(--night) 60%, transparent); }
  .dialog h2 { margin-top: 0; }
  .dialog form { display: grid; gap: var(--space-4); }
  .dialog-actions { display: flex; flex-wrap: wrap; gap: var(--space-2); }

  @media (max-width: 860px) {
    .top { position: static; }
    .plan { grid-template-columns: minmax(0, 1fr); }
    .pool { position: static; max-height: 45vh; }
    .top-actions { margin-left: 0; }
  }
  /* Handy: Tage untereinander statt seitlich scrollen */
  @media (max-width: 600px) {
    .days { grid-template-columns: minmax(0, 1fr); overflow-x: visible; }
  }
</style>
