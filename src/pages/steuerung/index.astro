---
// Oberfläche des Dashboards (steuerung.wtfact.xyz, Wunsch von Eric, 2026-10-08).
// Wird mitgebaut, landet aber nicht auf der Seite: scripts/bundle-steuerung.mjs verschiebt sie als app.html
// zu den PHP-Dateien aus steuerung/ nach dist-steuerung/. Daten und Anmeldung kommen von steuerung/api.php.
// Logik im Browser: src/scripts/steuerung.ts. Aussehen wie die Hauptseite (Kopfzeile, Bühne, Karten, Hintergrund).
// Bereiche: Übersicht (Startseite mit Statistik), Veröffentlichungen (Wochenplan), Alle Fakten.
import '../../styles/global.css';
import NightSky from '../../components/NightSky.astro';
import Icon from '../../components/Icon.astro';
import { CATEGORIES } from '../../config';
import { t } from '../../i18n/ui';

const cats = t('de').categories;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#ffd23f" />
    <link rel="icon" href="favicon.svg" type="image/svg+xml" />
    <title>WTFact Steuerung</title>
    <script is:inline>
      try { const t = localStorage.getItem('wtfact-theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch {}
    </script>
  </head>
  <body data-cats={JSON.stringify(cats)}>
    <NightSky />
    <section class="login-view" data-view="login" hidden>
      <form class="login card" data-login>
        <p class="logo">WTF<span>act</span><b class="sticker">?!</b></p>
        <p class="kicker"><span class="chip">Steuerung</span></p>
        <label>Benutzer <input name="user" autocomplete="username" required /></label>
        <label>Passwort <input name="password" type="password" autocomplete="current-password" required /></label>
        <button class="btn" type="submit">Anmelden</button>
        <p class="error" data-login-error role="alert" hidden></p>
      </form>
    </section>

    <div data-view="app" hidden>
      <header class="top">
        <div class="dash-wrap bar">
          <a class="logo" href="#uebersicht" data-goto="home" aria-label="WTFact Steuerung, Übersicht">WTF<span>act</span><b class="sticker">?!</b></a>
          <span class="chip area">Steuerung</span>
          <nav class="tabs" role="group" aria-label="Bereiche">
            <button class="chip tab" type="button" data-tab-btn="home" aria-pressed="true">Übersicht</button>
            <button class="chip tab" type="button" data-tab-btn="plan" aria-pressed="false">Veröffentlichungen</button>
            <button class="chip tab" type="button" data-tab-btn="all" aria-pressed="false">Alle Fakten</button>
          </nav>
          <div class="actions">
            <span class="sync" data-sync aria-live="polite"></span>
            <button class="chip theme" type="button" data-theme-toggle aria-pressed="false" aria-label="Dunkler Modus" title="Dunkler Modus">
              <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" /></svg>
              <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
            </button>
            <button class="btn btn--ghost btn-sm" type="button" data-refresh>Aktualisieren</button>
            <button class="btn btn--ghost btn-sm" type="button" data-logout>Abmelden</button>
          </div>
        </div>
      </header>

      <div class="dash-wrap notices">
        <p class="toast card" data-toast role="status" hidden></p>
        <ul class="prs" data-prs></ul>
      </div>

      <main>
        <section data-tab="home">
          <div class="stage hero">
            <div class="orbit" data-orbit aria-hidden="true" hidden></div>
            <div class="dash-wrap">
              <p class="kicker"><span class="sticker"><Icon name="zap" /> Übersicht</span></p>
              <h1 data-hello>Hallo Eric</h1>
              <p class="intro" data-summary></p>
              <div class="hero-row">
                <dl class="clocks">
                  <div class="clock"><dt>Nächster Fakt</dt><dd data-next-clock>--:--:--</dd><p class="clock-note" data-next-title></p></div>
                  <div class="clock"><dt>Pool reicht bis</dt><dd data-pool-until>–</dd><p class="clock-note" data-pool-note></p></div>
                </dl>
                <button class="btn" type="button" data-goto="plan"><Icon name="chevron-right" /> Zur Wochenplanung</button>
              </div>
            </div>
          </div>

          <div class="dash-wrap home">
            <ul class="tiles" data-tiles></ul>

            <div class="grid-2">
              <article class="card panel">
                <h2>Bewertungen pro Tag</h2>
                <p class="sub">Daumen hoch und runter der letzten 14 Tage, auf Fakt-Seiten und Wisch-Karte zusammen.</p>
                <div class="bars" data-day-chart role="img"></div>
                <div class="blocks3d" data-day-3d role="img" hidden></div>
                <p class="note" data-day-empty hidden>Noch keine Bewertungen in den letzten 14 Tagen.</p>
              </article>
              <article class="card panel">
                <h2>Die nächsten 7 Tage</h2>
                <p class="sub">Belegte Slots je Tag. Antippen öffnet die Wochenplanung.</p>
                <ol class="coming" data-coming></ol>
              </article>
            </div>

            <div class="grid-2">
              <article class="card panel">
                <h2>Kategorien</h2>
                <p class="sub">Veröffentlichte Fakten je Kategorie, dahinter der Anteil „Daumen hoch“.</p>
                <ul class="hbars" data-cat-chart></ul>
              </article>
              <article class="card panel">
                <h2>Welche Uhrzeit zieht?</h2>
                <p class="sub">Bewertungen je Fakt und Anteil „Daumen hoch“ nach Veröffentlichungszeit.</p>
                <ul class="hbars" data-slot-chart></ul>
                <p class="note" data-slot-empty hidden>Sobald Fakten über die festen Zeiten erscheinen, siehst du hier, welche am besten ankommt.</p>
              </article>
            </div>

            <div class="grid-3">
              <article class="card panel">
                <h2><Icon name="trophy" /> Top 5</h2>
                <ol class="rank" data-top></ol>
                <p class="note" data-top-empty hidden>Noch keine Bewertungen.</p>
              </article>
              <article class="card panel">
                <h2><Icon name="thumbs-down" /> Kommt weniger an</h2>
                <ol class="rank" data-flop></ol>
                <p class="note" data-flop-empty hidden>Noch kein Fakt mit mindestens 3 Bewertungen.</p>
              </article>
              <article class="card panel">
                <h2><Icon name="star" /> Zuletzt erschienen</h2>
                <ol class="rank" data-latest></ol>
              </article>
            </div>

            <article class="card panel">
              <h2><Icon name="vote" /> Montags-Abstimmung</h2>
              <p class="sub">Stimmen je Abstimmung um den Fakt der Woche, neueste rechts.</p>
              <div class="bars bars--polls" data-poll-chart role="img"></div>
              <p class="note" data-poll-empty hidden>Noch keine Stimmen.</p>
            </article>
            <p class="note" data-stats-note hidden>Die Datenbank mit Bewertungen und Stimmen ist auf diesem Server nicht lesbar. Zahlen dazu fehlen deshalb.</p>
          </div>
        </section>

        <section class="plan dash-wrap" data-tab="plan" hidden>
          <aside class="pool card" data-drop="pool" aria-labelledby="pool-title">
            <div class="pool-head">
              <h2 id="pool-title">Pool <span class="count" data-pool-count></span></h2>
              <p class="hint">Noch nicht eingeplant. Ziehen in einen Slot, oder antippen und dann einen Slot wählen. Zurück in den Pool: hierher ziehen.</p>
              <label class="sr-only" for="pool-search">Pool durchsuchen</label>
              <input id="pool-search" class="search" type="search" placeholder="Suchen…" data-pool-search />
            </div>
            <ul class="fact-list" data-pool></ul>
            <p class="empty" data-pool-empty hidden>Der Pool ist leer. Neue Fakten kommen mit dem Wochenlauf.</p>
          </aside>

          <div class="week">
            <div class="week-nav">
              <button class="btn btn--ghost btn-sm" type="button" data-week="-1" aria-label="Vorige Woche">‹</button>
              <h2 data-week-label></h2>
              <button class="btn btn--ghost btn-sm" type="button" data-week="1" aria-label="Nächste Woche">›</button>
              <button class="btn btn--ghost btn-sm" type="button" data-week="0">Diese Woche</button>
              <p class="selected" data-selected hidden></p>
            </div>
            <ol class="days" data-days></ol>
          </div>
        </section>

        <section class="all dash-wrap" data-tab="all" hidden>
          <div class="filters">
            <div class="chips" role="group" aria-label="Zustand">
              <button class="chip" type="button" data-status-filter="" aria-pressed="true">Alle</button>
              <button class="chip" type="button" data-status-filter="pool" aria-pressed="false">Pool</button>
              <button class="chip" type="button" data-status-filter="planned" aria-pressed="false">Geplant</button>
              <button class="chip" type="button" data-status-filter="live" aria-pressed="false">Live</button>
              <button class="chip" type="button" data-status-filter="offline" aria-pressed="false">Offline</button>
            </div>
            <label class="sr-only" for="all-search">Fakten durchsuchen</label>
            <input id="all-search" class="search" type="search" placeholder="Titel oder Schlüssel…" data-all-search />
            <label class="sr-only" for="all-cat">Kategorie</label>
            <select id="all-cat" class="select" data-all-cat>
              <option value="">Alle Kategorien</option>
              {CATEGORIES.map((c) => <option value={c}>{cats[c]}</option>)}
            </select>
            <label class="sr-only" for="all-sort">Sortierung</label>
            <select id="all-sort" class="select" data-all-sort>
              <option value="date">Neueste zuerst</option>
              <option value="score">Beliebteste zuerst</option>
              <option value="votes">Meiste Bewertungen</option>
            </select>
          </div>
          <p class="note" data-ratings-note hidden>Bewertungen sind auf diesem Server nicht lesbar, deshalb stehen überall 0.</p>
          <div class="table-wrap card">
            <table class="table">
              <thead>
                <tr><th scope="col">Fakt</th><th scope="col">Zustand</th><th scope="col">Termin</th><th scope="col"><span aria-hidden="true">👍</span><span class="sr-only">Daumen hoch</span></th><th scope="col"><span aria-hidden="true">👎</span><span class="sr-only">Daumen runter</span></th><th scope="col">Aktionen</th></tr>
              </thead>
              <tbody data-rows></tbody>
            </table>
          </div>
          <p class="note" data-all-count></p>
        </section>
      </main>
    </div>

    <dialog class="dialog card" data-special>
      <form method="dialog" data-special-form>
        <h2>Sonderveröffentlichung</h2>
        <p data-special-title></p>
        <label>Uhrzeit am <span data-special-day></span> <input type="time" name="time" required data-special-time /></label>
        <p class="error" data-special-error role="alert" hidden></p>
        <div class="dialog-actions">
          <button class="btn" type="submit" value="plan">Einplanen</button>
          <button class="btn btn--lime" type="button" data-special-now>Sofort veröffentlichen</button>
          <button class="btn btn--ghost" type="button" data-special-cancel>Abbrechen</button>
        </div>
      </form>
    </dialog>

    <script>
      import '../../scripts/steuerung';
    </script>
  </body>
</html>

<style>
  /* Wie die Hauptseite (src/layouts/Base.astro, WTF-Charts): helle Kopfzeile, dunkle Bühne, Karten mit hartem Schatten.
     Breite: Übersicht und Liste wie .wrap, der Wochenplan darf die volle Breite nutzen. */
  .dash-wrap { width: min(var(--content-width), 100% - 2 * var(--gutter)); margin-inline: auto; }
  .plan.dash-wrap { width: calc(100% - 2 * var(--gutter)); }
  .logo {
    margin: 0; font-family: var(--font-display); font-size: var(--fs-3xl); font-weight: 800; line-height: 1;
    letter-spacing: -0.05em; text-decoration: none; white-space: nowrap;
  }
  .logo span { color: var(--pink-text); }
  .logo b { margin-left: var(--space-1); }

  .login-view { position: relative; min-height: 100vh; display: grid; place-items: center; padding: var(--space-6); }
  .login { display: grid; gap: var(--space-4); width: min(100%, 380px); padding: var(--space-8); box-shadow: var(--shadow-xl); }
  .login .kicker { margin: calc(-1 * var(--space-2)) 0 var(--space-2); }
  .login label, .dialog label { display: grid; gap: var(--space-1); font-weight: 600; font-size: var(--fs-sm); }
  input, select {
    font: inherit; color: var(--ink); background: var(--surface);
    border: var(--bw-sm) solid var(--line); border-radius: var(--radius-sm); padding: var(--space-2) var(--space-3);
  }
  .error { margin: 0; color: var(--pink-text); font-weight: 600; }

  .top {
    position: sticky; top: 0; z-index: 5;
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: var(--bw) solid var(--line);
  }
  .bar { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-4); padding: var(--space-3) 0; }
  .area { font-size: var(--fs-sm); }
  .tabs { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-left: var(--space-4); }
  .tab { font-size: var(--fs-sm); padding: var(--space-1) var(--space-4); }
  .tab[aria-pressed='true'] { background: var(--yellow); color: var(--on-accent); }
  .tab[aria-pressed='true']::before { content: none; }
  .actions { margin-left: auto; display: flex; align-items: center; gap: var(--space-3); }
  .sync { font-size: var(--fs-xs); color: var(--muted); }
  .theme { padding: var(--space-1) var(--space-2); cursor: pointer; }
  .theme svg { width: var(--fs-lg); height: var(--fs-lg); fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .theme .sun { display: none; }
  .theme[aria-pressed='true'] .sun { display: block; }
  .theme[aria-pressed='true'] .moon { display: none; }
  .theme[aria-pressed='true'] { box-shadow: none; transform: none; }
  .theme[aria-pressed='true']::before { content: none; }
  :global(.btn-sm) { padding: var(--space-2) var(--space-3); font-size: var(--fs-sm); box-shadow: var(--shadow-xs); }

  .notices { display: grid; gap: var(--space-3); }
  .notices:has(> :not([hidden])) { margin-top: var(--space-4); }
  .toast { margin: 0; padding: var(--space-3) var(--space-4); font-weight: 600; }
  .toast[data-kind='error'] { background: var(--pink); color: var(--on-accent); }
  .prs { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-2); }
  .prs :global(li) { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); padding: var(--space-3) var(--space-4); }

  main { position: relative; padding-bottom: var(--space-12); }

  /* ---------- Übersicht ---------- */
  .hero { padding: var(--space-10) 0 var(--space-11); }
  .kicker { margin: 0 0 var(--space-4); }
  h1 { margin: 0; font-size: var(--fs-display-md); line-height: 1.05; letter-spacing: -0.03em; }
  .intro { color: var(--on-night-muted); font-size: var(--fs-lg); max-width: 62ch; margin: var(--space-4) 0 var(--space-7); }
  .hero-row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-5); }
  .clocks { display: flex; flex-wrap: wrap; gap: var(--space-4); margin: 0; }
  .clock {
    padding: var(--space-3) var(--space-5); border: var(--bw) solid var(--on-night); border-radius: var(--radius-md);
    box-shadow: var(--shadow-on-night); min-width: 220px;
  }
  .clock dt { font-size: var(--fs-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--on-night-muted); }
  .clock dd { margin: 0; font-family: var(--font-display); font-size: var(--fs-2xl); font-weight: 700; font-variant-numeric: tabular-nums; }
  .clock-note { margin: 0; font-size: var(--fs-sm); color: var(--on-night-muted); max-width: 32ch; }

  /* Fakten-Orbit (src/scripts/steuerung-3d.ts): rechts in der Bühne, auf dem Handy zwischen Text und Uhren */
  .hero { position: relative; overflow: hidden; }
  .hero .dash-wrap { position: relative; }
  .orbit { position: absolute; inset: 0 0 0 auto; width: 46%; }
  .orbit::after {
    content: attr(data-legend); position: absolute; top: var(--space-4); right: var(--space-6); max-width: 40ch;
    text-align: right; font-size: var(--fs-xs); color: var(--on-night-muted); pointer-events: none;
  }
  .orbit :global(.gl), .blocks3d :global(.gl) { display: block; }
  :global(.gl-tip) {
    position: absolute; z-index: 2; margin: 0; pointer-events: none; transform: translate(var(--space-3), var(--space-3));
    max-width: 30ch; padding: var(--space-1) var(--space-3); background: var(--surface); color: var(--ink);
    border: var(--bw-sm) solid var(--line); border-radius: var(--radius-pill); box-shadow: var(--shadow-xs);
    font-family: var(--font-display); font-size: var(--fs-sm); font-weight: 700; line-height: 1.3;
  }
  /* Säulen in 3D ersetzen das 2D-Diagramm, sobald sie stehen */
  .blocks3d { position: relative; height: 240px; }
  .is-3d .bars, .is-3d :global(.axis) { display: none; }
  .is-3d .sub::after { content: ' Gelb = 👍, pink = 👎.'; }

  .home { position: relative; z-index: 1; display: grid; gap: var(--space-6); margin-top: calc(-1 * var(--space-8)); }
  .tiles { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: var(--space-4); }
  .tiles :global(.tile) { padding: var(--space-4) var(--space-5); display: grid; gap: var(--space-1); align-content: start; }
  .tiles :global(.tile-label) { font-size: var(--fs-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
  .tiles :global(.tile-value) { font-family: var(--font-display); font-size: var(--fs-display-sm); font-weight: 800; line-height: 1.05; font-variant-numeric: tabular-nums; }
  .tiles :global(.tile-note) { font-size: var(--fs-sm); color: var(--muted); line-height: 1.35; }
  .tiles :global(.tile.accent .tile-label), .tiles :global(.tile.accent .tile-note) { color: var(--on-accent); }

  .grid-2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-6); }
  .grid-3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-6); }
  .panel { padding: var(--space-5) var(--space-6); min-width: 0; }
  .panel h2 { margin: 0; font-size: var(--fs-xl); display: flex; align-items: center; gap: var(--space-2); }
  .sub { margin: var(--space-1) 0 var(--space-5); font-size: var(--fs-sm); color: var(--muted); line-height: 1.4; }
  .note { font-size: var(--fs-sm); color: var(--muted); margin: var(--space-2) 0 0; }

  /* Säulen: eine Reihe, Wert über der Säule nur beim Zeigen (title) und am höchsten Wert */
  .bars { display: flex; align-items: flex-end; gap: var(--space-1); height: 180px; padding-top: var(--space-5); border-bottom: var(--bw-sm) solid var(--line); }
  .bars :global(.col) { flex: 1; min-width: 0; height: 100%; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; gap: var(--space-1); }
  .bars :global(.col-val) { font-size: var(--fs-xs); font-weight: 700; font-variant-numeric: tabular-nums; }
  .bars :global(.col-bar) { width: 100%; max-width: 36px; border: var(--bw-sm) solid var(--line); border-bottom: 0; border-radius: var(--radius-sm) var(--radius-sm) 0 0; background: var(--yellow); min-height: 2px; }
  .bars :global(.col-bar.empty) { border-style: dashed; background: none; }
  .bars :global(.col:hover .col-bar) { background: var(--pink); }
  :global(.axis) { display: flex; gap: var(--space-1); margin-top: var(--space-1); }
  :global(.axis-label) { flex: 1; min-width: 0; text-align: center; font-size: var(--fs-xs); color: var(--muted); white-space: nowrap; overflow: hidden; }

  /* Balken waagerecht: Name, Balken, Zahl */
  .hbars { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-2); }
  .hbars :global(li) { display: grid; grid-template-columns: minmax(90px, 9rem) minmax(0, 1fr) auto; align-items: center; gap: var(--space-3); font-size: var(--fs-sm); }
  .hbars :global(.hb-name) { font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .hbars :global(.hb-track) { display: block; height: var(--space-5); }
  .hbars :global(.hb-fill) { display: block; height: 100%; min-width: var(--space-1); border: var(--bw-sm) solid var(--line); border-radius: var(--radius-sm); --dots-size: var(--dots-size-sm); }
  .hbars :global(.hb-val) { font-variant-numeric: tabular-nums; color: var(--muted); white-space: nowrap; }
  .hbars :global(.hb-val b) { color: var(--ink); }

  .coming { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-2); }
  .coming :global(button) {
    width: 100%; display: grid; grid-template-columns: 7rem 1fr auto; align-items: center; gap: var(--space-3);
    font: inherit; font-size: var(--fs-sm); color: var(--ink); text-align: left; cursor: pointer;
    background: none; border: 0; border-radius: var(--radius-sm); padding: var(--space-1) var(--space-2);
  }
  .coming :global(button:hover) { background: var(--locked); }
  .coming :global(.c-day) { font-weight: 700; }
  .coming :global(.c-slots) { display: flex; gap: var(--space-2); }
  .coming :global(.c-dot) { width: var(--space-6); height: var(--space-6); border: var(--bw-sm) solid var(--line); border-radius: var(--radius-pill); display: grid; place-items: center; font-size: var(--fs-xs); }
  .coming :global(.c-dot.on) { background: var(--lime); color: var(--on-accent); }
  .coming :global(.c-dot.past) { border-style: dashed; opacity: 0.6; }
  .coming :global(.c-extra) { color: var(--muted); white-space: nowrap; }

  .rank { margin: var(--space-4) 0 0; padding: 0; list-style: none; display: grid; gap: var(--space-2); counter-reset: rank; }
  .rank :global(li) { display: grid; grid-template-columns: auto var(--space-9) minmax(0, 1fr); align-items: center; gap: var(--space-2); counter-increment: rank; font-size: var(--fs-sm); line-height: 1.3; }
