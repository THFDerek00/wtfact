---
import Base from '../../layouts/Base.astro';
import { LANGS, type Lang } from '../../config';
import { t } from '../../i18n/ui';
import { open, readGold } from '../../../scripts/facts-db.mjs';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const ui = t(lang);
const g = ui.game;
const other: Lang = lang === 'de' ? 'en' : 'de';

// Gold-Fakten aus der Datenbank (Tabelle gold_facts), nach Punkten sortiert. Der Inhalt steht
// kodiert im HTML und wird erst nach dem Freischalten im Browser eingesetzt, damit er nicht
// einfach im Quelltext steht.
const db = open();
const facts = readGold(db);
db.close();
const payload = facts.map((f) => ({
  id: f.id,
  points: f.points,
  category: f.category,
  categoryName: ui.categories[f.category as keyof typeof ui.categories] ?? f.category,
  emoji: f.emoji,
  title: f[lang].title,
  text: f[lang].text,
  sources: f.sources,
}));
const encoded = Buffer.from(JSON.stringify(payload), 'utf8').toString('base64');
const texts = { ...g, sourcesLabel: ui.sources };
// Funktionen aus ui.ts lassen sich nicht als JSON übergeben, daher nur die festen Texte.
const staticTexts = Object.fromEntries(Object.entries(texts).filter(([, v]) => typeof v === 'string'));
const STARS = 9;
---
<Base lang={lang} title={g.title} description={g.intro} altUrl={`/${other}/science-jumper/`}>
  <section class="stage play">
    <div class="wrap">
      <p class="kicker"><span class="sticker">🧪 {g.name}</span></p>
      <h1>{g.title}</h1>
      <p class="intro">{g.intro}</p>

      <div class="frame">
        <canvas
          width="800"
          height="260"
          tabindex="0"
          role="img"
          aria-label={g.canvasLabel}
          aria-describedby="jumper-controls"
          data-jumper
        ></canvas>
      </div>

      <div class="below">
        <dl class="stats">
          <div><dt>{g.run}</dt><dd data-stat="run">0</dd></div>
          <div><dt>{g.best}</dt><dd data-stat="best">0</dd></div>
          <div><dt>{g.total}</dt><dd data-stat="total">0</dd></div>
        </dl>
        <button class="btn" type="button" data-start><span aria-hidden="true">▶</span> {g.start}</button>
      </div>
      <p class="controls" id="jumper-controls">{g.controls}</p>
      <p class="sr-only" aria-live="polite" data-live></p>
      <p class="toast" data-toast hidden>
        <span aria-hidden="true">🏆</span> <span data-toast-text></span>
        <a href="#gold">{g.goldTitle} <span aria-hidden="true">↓</span></a>
      </p>
    </div>
  </section>

  <section class="wrap gold-sec" id="gold" data-gold={encoded} data-texts={JSON.stringify(staticTexts)} data-lang={lang}>
    <div class="gold-head">
      <div>
        <h2>{g.goldTitle}</h2>
        <p class="lead">{g.goldIntro}</p>
      </div>
      <div class="meter-box">
        <p class="meter-label" data-progress-label>{g.progress(0, facts.length)}</p>
        <div class="meter" role="progressbar" aria-label={g.goldTitle} aria-valuemin="0" aria-valuemax={facts.length} aria-valuenow="0" data-meter>
          <span class="meter-fill" data-meter-fill></span>
        </div>
        <p class="next" data-next>{g.nextAt(facts[0]?.points ?? 0, facts[0]?.points ?? 0)}</p>
      </div>
    </div>

    <ol class="slots">
      {facts.map((f) => (
        <li class="slot" data-slot={f.id}>
          <div class="locked">
            <span class="lock" aria-hidden="true">🔒</span>
            <span class="pts">{f.points}</span>
            <span class="sr-only">{g.locked},</span>
            <span class="at">{g.lockedAt(f.points)}</span>
            <span class:list={['chip', `cat-${f.category}`]}>{ui.categories[f.category as keyof typeof ui.categories] ?? f.category}</span>
          </div>
        </li>
      ))}
    </ol>

    <div class="foot-note">
      <p>{g.storageNote}</p>
      <button class="btn btn--ghost" type="button" data-reset>{g.reset}</button>
    </div>

    <template data-card>
      <article class="goldcard gold">
        <span class="stars" aria-hidden="true">
          {Array.from({ length: STARS }, () => <span class="star"><span class="star-core"></span></span>)}
        </span>
        <div class="gc-head">
          <span class="chip badge"><span aria-hidden="true">🏆</span> <span data-f="badge"></span></span>
          <span class="chip" data-f="cat"></span>
          <span class="chip newb" data-f="new" hidden>{g.newBadge}</span>
        </div>
        <span class="gc-emoji" aria-hidden="true" data-f="emoji"></span>
        <h3 data-f="title"></h3>
        <p data-f="text"></p>
        <details>
          <summary>{ui.sources}</summary>
          <ul data-f="sources"></ul>
        </details>
      </article>
    </template>
  </section>
</Base>

<script>
  import { createJumper } from '../../scripts/jumper';

  type Fact = { id: string; points: number; category: string; categoryName: string; emoji: string; title: string; text: string; sources: { label: string; url: string }[] };
  // Freigeschaltet wird nach dem Highscore EINES Laufs, nicht nach gesammelten Punkten.
  type Store = { best: number; seen: number };
  const KEY = 'wtfact-jumper-v1';

  const sec = document.querySelector<HTMLElement>('[data-gold]')!;
  const T = JSON.parse(sec.dataset.texts ?? '{}') as Record<string, string>;
  const de = sec.dataset.lang === 'de';
  const bytes = Uint8Array.from(atob(sec.dataset.gold ?? ''), (c) => c.charCodeAt(0));
  const facts = JSON.parse(new TextDecoder().decode(bytes)) as Fact[];

  // Texte mit Zahlen (die Funktionen aus ui.ts) hier im Browser nachgebaut.
  const fmt = {
    progress: (have: number, all: number) => (de ? `${have} von ${all} freigeschaltet` : `${have} of ${all} unlocked`),
    nextAt: (pts: number, missing: number) => (de ? `Nächster Gold-Fakt ab Highscore ${pts}. Dir fehlen noch ${missing}.` : `Next golden fact at a high score of ${pts}. ${missing} to go.`),
    runResult: (n: number, best: number) =>
      de ? `Lauf vorbei: ${n} ${n === 1 ? 'Reagenzglas' : 'Reagenzgläser'}. Dein Highscore: ${best}.` : `Run over: ${n} test ${n === 1 ? 'tube' : 'tubes'}. Your high score: ${best}.`,
    unlocked: (n: number) => (de ? (n === 1 ? 'Neuer Gold-Fakt freigeschaltet!' : `${n} neue Gold-Fakten freigeschaltet!`) : n === 1 ? 'New golden fact unlocked!' : `${n} new golden facts unlocked!`),
    badge: (pts: number) => `${T.goldBadge} · ${pts}`,
  };

  function load(): Store {
    try {
      const s = JSON.parse(localStorage.getItem(KEY) ?? '{}');
      return { best: Math.max(0, Number(s.best) || 0), seen: Math.min(Math.max(0, Number(s.seen) || 0), Math.max(0, Number(s.best) || 0)) };
    } catch {
      return { best: 0, seen: 0 };
    }
  }
  function save() {
    try { localStorage.setItem(KEY, JSON.stringify(store)); } catch { /* privates Fenster: nur für diese Sitzung */ }
  }
  const store = load();
  // Highscore beim letzten Besuch: alles darüber bekommt das Neu-Etikett.
  const seenAtLoad = store.seen;

  const stat = (k: string) => document.querySelector<HTMLElement>(`[data-stat="${k}"]`)!;
  const live = document.querySelector<HTMLElement>('[data-live]')!;
  const toast = document.querySelector<HTMLElement>('[data-toast]')!;
  const toastText = document.querySelector<HTMLElement>('[data-toast-text]')!;
  const tpl = document.querySelector<HTMLTemplateElement>('[data-card]')!;

  function card(f: Fact, isNew: boolean) {
    const node = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
    const q = (k: string) => node.querySelector<HTMLElement>(`[data-f="${k}"]`)!;
    q('badge').textContent = fmt.badge(f.points);
    q('cat').textContent = f.categoryName;
    q('cat').classList.add(`cat-${f.category}`);
    q('new').hidden = !isNew;
    q('emoji').textContent = f.emoji;
    q('title').textContent = f.title;
    q('text').textContent = f.text;
    // Sterne in der Kategoriefarbe: die .cat-*-Klasse setzt die Fläche, so passen neue Kategorien automatisch.
    node.querySelectorAll('.star-core').forEach((s) => s.classList.add(`cat-${f.category}`));
    const list = q('sources');
    for (const s of f.sources) {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = s.url;
      a.rel = 'noopener nofollow';
      a.target = '_blank';
      a.textContent = s.label;
      li.append(a);
      list.append(li);
    }
    return node;
  }

  function render() {
    stat('best').textContent = String(store.best);
    let have = 0;
    for (const f of facts) {
      const slot = document.querySelector<HTMLElement>(`[data-slot="${f.id}"]`);
      if (!slot) continue;
      const open = store.best >= f.points;
      if (open) have++;
      if (open && !slot.dataset.open) {
        slot.dataset.open = 'true';
        slot.replaceChildren(card(f, f.points > seenAtLoad));
      }
    }
    const next = facts.find((f) => f.points > store.best);
    stat('total').textContent = `${have}/${facts.length}`;
    document.querySelector('[data-progress-label]')!.textContent = fmt.progress(have, facts.length);
    document.querySelector('[data-next]')!.textContent = next ? fmt.nextAt(next.points, next.points - store.best) : T.allDone;
    const meter = document.querySelector<HTMLElement>('[data-meter]')!;
    meter.setAttribute('aria-valuenow', String(have));
    const max = facts.at(-1)?.points ?? 1;
    document.querySelector<HTMLElement>('[data-meter-fill]')!.style.setProperty('--fill', String(Math.min(1, store.best / max)));
  }

  const startBtn = document.querySelector<HTMLButtonElement>('[data-start]')!;
  // Highscore vor diesem Lauf: daran misst sich, was neu freigeschaltet wurde.
  let bestBefore = store.best;
  const game = createJumper({
    canvas: document.querySelector<HTMLCanvasElement>('[data-jumper]')!,
    text: { tapToStart: T.tapToStart, paused: T.paused, gameOver: T.gameOver, again: T.again, best: T.best },
    best: () => store.best,
    onCollect(run) {
      if (run === 1) { bestBefore = store.best; toast.hidden = true; }
      stat('run').textContent = String(run);
      // Gold-Fakten öffnen sich schon während des Laufs, sobald der Highscore steigt.
      if (run > store.best) {
        store.best = run;
        save();
        render();
      }
    },
    onGameOver(run) {
      stat('run').textContent = String(run);
      const fresh = facts.filter((f) => f.points > bestBefore && f.points <= store.best).length;
      const record = run > bestBefore;
      live.textContent = fmt.runResult(run, store.best) + (record ? ` ${T.newBest}` : '') + (fresh ? ` ${fmt.unlocked(fresh)}` : '');
      if (fresh) {
        toastText.textContent = fmt.unlocked(fresh);
        toast.hidden = false;
      }
      startBtn.lastChild!.textContent = ` ${T.again}`;
      bestBefore = store.best;
    },
  });

  startBtn.addEventListener('click', () => {
    toast.hidden = true;
    stat('run').textContent = '0';
    bestBefore = store.best;
    game.start();
  });

  document.querySelector('[data-reset]')!.addEventListener('click', () => {
    if (!confirm(T.resetConfirm)) return;
    Object.assign(store, { best: 0, seen: 0 });
    save();
    location.reload();
  });

  // Neu-Etiketten gelten bis zum nächsten Besuch: sobald die Sammlung zu sehen war, merken wir uns den Stand.
  new IntersectionObserver((entries) => {
    if (entries.some((e) => e.isIntersecting)) { store.seen = store.best; save(); }
  }).observe(sec);

  render();
</script>

<style>
  .play { padding: var(--space-10) 0 var(--space-11); }
  .kicker { margin: 0 0 var(--space-4); font-family: var(--font-display); font-weight: 700; font-size: var(--fs-md); }
  h1 { font-size: var(--fs-display-lg); margin: 0; max-width: 22ch; }
  .intro { color: var(--on-night-muted); font-size: var(--fs-lg); max-width: 62ch; margin: var(--space-4) 0 var(--space-8); }

  .frame {
    border: var(--bw) solid var(--on-night); border-radius: var(--radius-lg);
    box-shadow: var(--shadow-on-night); overflow: hidden; background: var(--night);
  }
  canvas { display: block; width: 100%; height: auto; aspect-ratio: 800 / 260; touch-action: manipulation; cursor: pointer; }
  canvas:focus-visible { outline-offset: calc(-1 * var(--bw-focus)); }

  .below { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-5); margin-top: var(--space-6); }
  .stats { display: flex; flex-wrap: wrap; gap: var(--space-7); margin: 0; }
  .stats dt { font-size: var(--fs-xs); color: var(--on-night-muted); text-transform: uppercase; letter-spacing: 0.06em; }
  .stats dd { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: var(--fs-3xl); line-height: 1.1; }
  .controls { color: var(--on-night-muted); font-size: var(--fs-sm); margin: var(--space-4) 0 0; }
  .toast {
    display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2);
    margin: var(--space-5) 0 0; padding: var(--space-3) var(--space-5);
    border: var(--bw) solid var(--on-night); border-radius: var(--radius-pill);
    font-family: var(--font-display); font-weight: 700;
  }
  .toast:not([hidden]) { background: var(--gold-surface); color: var(--on-accent); }
  .toast a { margin-left: auto; }

  /* Sammlung */
  .gold-sec { margin-top: var(--space-11); scroll-margin-top: var(--space-12); }
  .gold-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: var(--space-6); margin-bottom: var(--space-8); }
  .gold-head h2 { font-size: var(--fs-display-sm); margin: 0; }
  .lead { color: var(--muted); margin: var(--space-2) 0 0; max-width: 52ch; }
  .meter-box { flex: 0 1 360px; }
  .meter-label, .next { margin: 0; font-size: var(--fs-sm); font-weight: 600; }
  .next { color: var(--muted); }
  .meter {
    --fill: 0;
    height: var(--space-4); margin: var(--space-2) 0;
    border: var(--bw-sm) solid var(--line); border-radius: var(--radius-pill);
    background: var(--surface); overflow: hidden;
  }
  .meter-fill { display: block; height: 100%; width: calc(var(--fill) * 100%); background: var(--gold-surface); transition: width var(--dur) var(--ease); }

  .slots { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: var(--space-6); }
  .locked {
    height: 100%; min-height: 180px;
    display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-2);
    padding: var(--space-5);
    border: var(--bw) dashed var(--line); border-radius: var(--radius-md);
    background: var(--locked); color: var(--ink);
    font-family: var(--font-display);
  }
  .lock { font-size: var(--fs-2xl); }
  .pts { font-size: var(--fs-display-sm); font-weight: 700; line-height: 1; }
  .at { font-size: var(--fs-sm); font-weight: 600; margin-top: auto; }

  .goldcard {
    position: relative; overflow: hidden; height: 100%;
    display: flex; flex-direction: column; gap: var(--space-2);
    padding: var(--space-5);
    border: var(--bw) solid var(--line); border-radius: var(--radius-md); box-shadow: var(--shadow-md);
  }
  .goldcard > :not(.stars) { position: relative; }
  .gc-head { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .badge { background: var(--night); color: var(--on-night); border-color: var(--on-accent); }
  .newb { background: var(--pink); color: var(--on-accent); border-color: var(--on-accent); }
  .gc-emoji { font-size: var(--fs-emoji-sm); filter: var(--emoji-shadow); margin-top: var(--space-1); }
  .goldcard h3 { margin: 0; font-size: var(--fs-xl); }
  .goldcard p { margin: 0; font-size: var(--fs-md); }
  .goldcard details { margin-top: auto; padding-top: var(--space-2); font-size: var(--fs-sm); }
  .goldcard summary { cursor: pointer; font-family: var(--font-display); font-weight: 700; }
  .goldcard ul { margin: var(--space-2) 0 0; padding-left: var(--space-5); }

  /* Funkelnde Sterne: dunkler Rand außen, Kategoriefarbe innen (über .cat-*) */
  .stars { position: absolute; inset: 0; pointer-events: none; }
  .star {
    position: absolute; width: var(--star-size-md); aspect-ratio: 1;
    background: var(--on-accent);
    clip-path: polygon(50% 0, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
    animation: twinkle var(--dur-twinkle) ease-in-out infinite;
  }
  .star-core { position: absolute; inset: var(--bw-sm); clip-path: inherit; --dots-size: var(--dots-size-sm); }
  .star:nth-child(1) { top: var(--space-3); right: var(--space-3); width: var(--star-size-lg); }
  .star:nth-child(2) { top: var(--space-10); right: var(--space-2); width: var(--star-size-sm); animation-delay: calc(var(--dur-twinkle) * -0.3); }
  .star:nth-child(3) { top: var(--space-2); right: var(--space-11); width: var(--star-size-sm); animation-delay: calc(var(--dur-twinkle) * -0.6); }
  .star:nth-child(4) { bottom: var(--space-3); right: var(--space-3); width: var(--star-size-lg); animation-delay: calc(var(--dur-twinkle) * -0.15); }
  .star:nth-child(5) { bottom: var(--space-4); right: var(--space-12); animation-delay: calc(var(--dur-twinkle) * -0.8); }
  .star:nth-child(6) { bottom: var(--space-10); right: var(--space-2); width: var(--star-size-sm); animation-delay: calc(var(--dur-twinkle) * -0.45); }
  .star:nth-child(7) { top: 50%; right: var(--space-1); animation-delay: calc(var(--dur-twinkle) * -0.7); }
  .star:nth-child(8) { bottom: var(--space-2); left: 45%; width: var(--star-size-sm); animation-delay: calc(var(--dur-twinkle) * -0.9); }
  .star:nth-child(9) { top: var(--space-12); left: 70%; width: var(--star-size-sm); animation-delay: calc(var(--dur-twinkle) * -0.25); }
  @keyframes twinkle {
    0%, 100% { transform: scale(1) rotate(0deg); opacity: 1; }
    50% { transform: scale(0.55) rotate(25deg); opacity: 0.6; }
  }

  .foot-note { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-4); margin-top: var(--space-8); color: var(--muted); font-size: var(--fs-sm); }
  .foot-note p { margin: 0; }

  @media (max-width: 520px) {
    .stats { gap: var(--space-5); }
    .stats dd { font-size: var(--fs-2xl); }
    .locked { min-height: 0; }
  }
</style>
