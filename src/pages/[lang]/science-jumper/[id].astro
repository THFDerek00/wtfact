---
// Eigene Seite für jeden Gold-Fakt aus dem Science Jumper (Wunsch von Eric, 2026-10-02). Neu gestaltet als
// „Schatzkammer“ (Eric, 2026-10-09: „durch und durch besonders und anders“): Die ganze Seite ist eine dunkle
// Bühne mit Goldstrahlen, der Fakt steht auf einer Pergament-Tafel mit Goldrahmen, die Quellen sind
// „Beweisstücke“, unten liegt die Sammlung als Münzreihe. Dazu eine ausgesuchte, hochwertige Werbung pro
// Gold-Fakt (Tabelle gold_products). Wie auf der Spielseite steht der Inhalt kodiert im HTML und wird erst
// eingesetzt, wenn der Highscore im Browser hoch genug ist; die Werbung erscheint erst dann, damit sie
// den Fakt nicht verrät.
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import ShareBar from '../../../components/ShareBar.astro';
import { LANGS, type Lang } from '../../../config';
import { t } from '../../../i18n/ui';
import { amazonUrl } from '../../../lib';
import { open, readGold } from '../../../../scripts/facts-db.mjs';
import { goldUrl } from '../../../scripts/gold';

export function getStaticPaths() {
  const db = open();
  const facts = readGold(db);
  db.close();
  const all = facts.map((f) => ({ id: f.id, points: f.points }));
  return LANGS.flatMap((lang) =>
    facts.map((f, i) => ({ params: { lang, id: f.id }, props: { fact: f, index: i, all, prev: facts[i - 1], next: facts[i + 1] } })),
  );
}
type Gold = ReturnType<typeof readGold>[number];
const { fact: f, index, all, prev, next } = Astro.props as { fact: Gold; index: number; all: { id: string; points: number }[]; prev?: Gold; next?: Gold };
const lang = Astro.params.lang as Lang;
const ui = t(lang);
const g = ui.game;
const other: Lang = lang === 'de' ? 'en' : 'de';
const cat = f.category as keyof typeof ui.categories;
const product = f[lang].product;
const payload = {
  id: f.id,
  points: f.points,
  category: f.category,
  categoryName: ui.categories[cat] ?? f.category,
  emoji: f.emoji,
  title: f[lang].title,
  text: f[lang].text,
  sources: f.sources,
  product: product && { ...product, url: amazonUrl(lang, product.query) },
};
const encoded = Buffer.from(JSON.stringify(payload), 'utf8').toString('base64');
const STARS = 12;
const BURST = 10;
const game = `/${lang}/science-jumper/`;
---
<Base lang={lang} title={g.pageTitle(f.points)} description={g.pageDesc} altUrl={goldUrl(other, f.id)}>
  <div class="vault" data-gold-page data-gold={encoded} data-lang={lang} data-points={f.points} data-best-text={g.progressTo(9001, f.points)}>
    <span class="rays" aria-hidden="true"></span>
    <span class="stars" aria-hidden="true">
      {Array.from({ length: STARS }, () => <span class="star"><span class:list={['star-core', `cat-${f.category}`]}></span></span>)}
    </span>

    <div class="wrap inner">
      <a class="back" href={`${game}#gold`}><Icon name="chevron-left" /> {g.backToGame}</a>

      <header class="hero">
        <p class="kicker"><span aria-hidden="true">✦</span> {g.vaultKicker} <span aria-hidden="true">✦</span></p>
        <div class="stage-emoji" aria-hidden="true">
          <span class="halo"></span>
          <span class="burst">{Array.from({ length: BURST }, () => <span></span>)}</span>
          <span class="emoji" data-f="emoji"><Icon name="lock" /></span>
          <span class="medal"><Icon name="flask-conical" /><span class="medal-pts">{f.points}</span></span>
        </div>
        <div class="meta">
          <span class="ribbon">{g.goldNo(index + 1, all.length)}<span class="sr-only"> · {f.points}</span></span>
          <span class:list={['chip', `cat-${f.category}`]}>{ui.categories[cat] ?? f.category}</span>
        </div>
        <h1 data-f="title">{g.pageTitle(f.points)}</h1>
      </header>

      <!-- Gesperrt: Tresortür mit Fortschritt -->
      <section class="safe" data-locked>
        <span class="door" aria-hidden="true"><span class="dial"><Icon name="lock" /></span></span>
        <h2>{g.locked}</h2>
        <p>{g.lockedText(f.points)}</p>
        <div class="progress" role="progressbar" aria-label={g.best} aria-valuemin="0" aria-valuemax={f.points} aria-valuenow="0" data-progress>
          <span class="progress-fill"></span>
        </div>
        <p class="best" data-best></p>
        <a class="btn gold-btn" href={game}><Icon name="play" /> {g.playNow}</a>
      </section>

      <!-- Freigeschaltet: Pergament-Tafel -->
      <div class="open" data-open hidden>
        <article class="plaque">
          <span class="corner" aria-hidden="true">✦</span><span class="corner" aria-hidden="true">✦</span>
          <span class="corner" aria-hidden="true">✦</span><span class="corner" aria-hidden="true">✦</span>
          <p class="lead" data-f="lead"></p>
          <p class="divider" aria-hidden="true">✦ ✦ ✦</p>
          <p class="text" data-f="text"></p>
          <section class="evidence" id="sources">
            <h2>{g.evidence}</h2>
            <ol data-f="sources"></ol>
          </section>
        </article>

        {product && (
          <aside class="treasure" aria-labelledby="treasure-title">
            <div class="treasure-head">
              <p class="treasure-kicker" id="treasure-title"><span aria-hidden="true">✦</span> {g.adKicker}</p>
              <span class="ad-tag">{ui.adLabel}</span>
            </div>
            <a class="treasure-card" data-f="ad" rel="sponsored nofollow noopener" target="_blank" data-umami-event="amazon" data-umami-event-fact={`gold-${f.id}`} data-umami-event-place="gold">
              <span class="treasure-art" aria-hidden="true"><span class="halo"></span><span class="treasure-emoji" data-f="ad-emoji"></span></span>
              <span class="treasure-body">
                <span class="treasure-name" data-f="ad-name"></span>
                <span class="treasure-why" data-f="ad-why"></span>
                <span class="btn gold-btn treasure-cta">{ui.productsCta} <Icon name="external-link" /></span>
              </span>
            </a>
            <p class="ad-note">{ui.affiliateShort}</p>
          </aside>
        )}

        <div class="share-row"><ShareBar lang={lang} title={g.pageTitle(f.points)} /></div>
      </div>

      <!-- Sammlung: eine Münze pro Gold-Fakt -->
      <nav class="collection" aria-labelledby="collection-title">
        <h2 id="collection-title">{g.collection}</h2>
        <p class="collection-note" data-collection-note data-text={g.collectionNote(9001, all.length)}>{g.collectionNote(0, all.length)}</p>
        <ol class="coins">
          {all.map((c) => (
            <li>
              <a class="coin" href={goldUrl(lang, c.id)} data-coin={c.points} aria-current={c.id === f.id ? 'page' : undefined}>
                <span class="coin-lock" aria-hidden="true"><Icon name="lock" /></span>
                <span class="coin-pts">{c.points}</span>
                <span class="sr-only" data-coin-label>{g.coinLocked(c.points)}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>

      <nav class="pager">
        {prev ? <a class="btn btn--ghost" href={goldUrl(lang, prev.id)}><Icon name="chevron-left" /> {g.prevGold}</a> : <span></span>}
        <a class="btn btn--ghost" href={`${game}#gold`}>{g.allGold}</a>
        {next ? <a class="btn btn--ghost" href={goldUrl(lang, next.id)}>{g.nextGold} <Icon name="chevron-right" /></a> : <span></span>}
      </nav>
    </div>
  </div>
</Base>

<script>
  import { loadStore, decode, splitLead, type GoldFact } from '../../../scripts/gold';

  type Payload = GoldFact & { product?: { name: string; why: string; emoji: string; url: string } };
  const root = document.querySelector<HTMLElement>('[data-gold-page]');
  if (root) {
    const fact = decode<Payload>(root.dataset.gold ?? '');
    const { best } = loadStore();
    const q = (k: string) => document.querySelector<HTMLElement>(`[data-f="${k}"]`);

    // Fortschritt bis zu diesem Fakt
    const bar = document.querySelector<HTMLElement>('[data-progress]')!;
    bar.setAttribute('aria-valuenow', String(Math.min(best, fact.points)));
    bar.style.setProperty('--p', String(Math.min(1, best / fact.points)));
    document.querySelector('[data-best]')!.textContent = (root.dataset.bestText ?? '').replace('9001', String(best));

    // Sammlung: Münzen der freigeschalteten Gold-Fakten werden golden
    let have = 0;
    for (const coin of document.querySelectorAll<HTMLElement>('[data-coin]')) {
      const pts = Number(coin.dataset.coin);
      if (best >= pts) {
        have++;
        coin.toggleAttribute('data-open', true);
        coin.querySelector('[data-coin-label]')?.remove();
      }
    }
    const note = document.querySelector<HTMLElement>('[data-collection-note]')!;
    note.textContent = (note.dataset.text ?? '').replace('9001', String(have));

    if (best >= fact.points) {
      const [lead, rest] = splitLead(fact.text);
      q('title')!.textContent = fact.title;
      q('emoji')!.textContent = fact.emoji;
      q('lead')!.textContent = lead;
      q('text')!.textContent = rest;
      q('text')!.hidden = !rest;
      const list = q('sources')!;
      for (const s of fact.sources) {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = s.url;
        a.rel = 'noopener nofollow';
        a.target = '_blank';
        a.textContent = s.label;
        li.append(a);
        list.append(li);
      }
      const ad = q('ad') as HTMLAnchorElement | null;
      if (ad && fact.product) {
        ad.href = fact.product.url;
        q('ad-emoji')!.textContent = fact.product.emoji;
        q('ad-name')!.textContent = fact.product.name;
        q('ad-why')!.textContent = fact.product.why;
      }
      document.querySelector<HTMLElement>('[data-locked]')!.hidden = true;
      document.querySelector<HTMLElement>('[data-open]')!.hidden = false;
      root.toggleAttribute('data-unlocked', true);
    }
  }
</script>

<style>
  /* Die ganze Seite ist die Schatzkammer: in beiden Modi dunkel, Gold leuchtet von hinten */
  .vault {
    position: relative; overflow: hidden; isolation: isolate;
    background: var(--gold-glow), var(--night); background-size: 100% 900px, auto; background-repeat: no-repeat;
    color: var(--on-night); --focus: var(--yellow);
    border-top: var(--bw-accent) solid var(--gold);
    padding-bottom: var(--space-12);
  }
  .rays {
    position: absolute; z-index: -1; top: 330px; left: 50%; width: 180vmax; aspect-ratio: 1; translate: -50% -50%;
    background: var(--gold-rays); animation: spin var(--dur-rays) linear infinite; pointer-events: none;
    mask-image: radial-gradient(circle, black 0%, transparent 45%);
  }
  @keyframes spin { to { rotate: 360deg; } }
  .inner { position: relative; padding-top: var(--space-6); }
  .back { display: inline-flex; align-items: center; gap: var(--space-1); font-family: var(--font-display); font-size: var(--fs-sm); font-weight: 700; text-decoration: none; color: var(--gold-light); }
  .back:hover { text-decoration: underline; }

  /* Kopf: mittig, Emoji schwebt vor dem Lichthof, Medaille daneben */
  .hero { display: flex; flex-direction: column; align-items: center; text-align: center; margin: var(--space-4) auto var(--space-10); max-width: 900px; }
  .kicker { margin: 0; font-family: var(--font-display); font-size: var(--fs-sm); font-weight: 800; text-transform: uppercase; letter-spacing: 0.2em; color: var(--gold-light); }
  .stage-emoji { position: relative; display: grid; place-items: center; width: 280px; aspect-ratio: 1; margin: var(--space-2) 0; }
  .halo { position: absolute; inset: 0; border-radius: 50%; background: var(--gold-glow); }
  .emoji {
    position: relative; font-size: var(--fs-emoji-2xl); line-height: 1; filter: var(--emoji-shadow);
    color: var(--gold-light); --icon-size: 0.7em; --icon-stroke: 1.5;
    animation: bob var(--dur-bob) ease-in-out infinite;
  }
  @keyframes bob {
    0%, 100% { transform: translateY(0) rotate(-6deg); }
    50% { transform: translateY(-12px) rotate(4deg); }
  }
  .medal {
    position: absolute; right: 0; bottom: var(--space-4);
    display: grid; place-items: center; align-content: center; width: var(--medal-size-lg); aspect-ratio: 1;
    border: var(--bw) solid var(--on-accent); border-radius: 50%;
    background: var(--gold-foil); color: var(--on-accent); box-shadow: var(--shadow-new);
    font-family: var(--font-display); font-weight: 800; line-height: 1; font-size: var(--fs-xl); transform: rotate(10deg);
    --icon-size: 1em;
  }
  .medal-pts { font-size: var(--fs-3xl); letter-spacing: -0.03em; }
  .meta { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-3); align-items: center; }
  .meta .chip { border-color: var(--on-accent); }
  .ribbon {
    padding: var(--space-1) var(--space-3); border: var(--bw-sm) solid var(--on-accent); border-radius: var(--radius-sm);
    background: var(--gold-foil); color: var(--on-accent); transform: rotate(-2deg);
    font-family: var(--font-display); font-size: var(--fs-sm); font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; line-height: 1.5;
  }
  h1 { font-size: var(--fs-display-xl); margin: var(--space-5) 0 0; line-height: 1.02; letter-spacing: -0.03em; text-wrap: balance; }
  [data-unlocked] h1 { background: var(--gold-foil); -webkit-background-clip: text; background-clip: text; color: transparent; }

  /* Funkenregen beim Öffnen (einmal) */
  .burst { position: absolute; inset: 0; pointer-events: none; }
  .burst span {
    position: absolute; top: 50%; left: 50%; width: var(--star-size-md); aspect-ratio: 1; opacity: 0;
    background: var(--gold-light);
    clip-path: polygon(50% 0, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
  }
  [data-unlocked] .burst span { animation: burst var(--dur-reveal) var(--ease) both; animation-delay: calc(var(--dur-reveal) * 0.3); }
  .burst span:nth-child(1) { --a: 0deg; }
  .burst span:nth-child(2) { --a: 36deg; width: var(--star-size-sm); }
  .burst span:nth-child(3) { --a: 72deg; }
  .burst span:nth-child(4) { --a: 108deg; width: var(--star-size-sm); }
  .burst span:nth-child(5) { --a: 144deg; }
  .burst span:nth-child(6) { --a: 180deg; width: var(--star-size-lg); }
  .burst span:nth-child(7) { --a: 216deg; }
  .burst span:nth-child(8) { --a: 252deg; width: var(--star-size-sm); }
  .burst span:nth-child(9) { --a: 288deg; }
  .burst span:nth-child(10) { --a: 324deg; width: var(--star-size-lg); }
  @keyframes burst {
    0% { opacity: 1; transform: translate(-50%, -50%) rotate(var(--a)) translateY(0) scale(0.4); }
    100% { opacity: 0; transform: translate(-50%, -50%) rotate(var(--a)) translateY(-170px) scale(1); }
  }

  /* Sterne verteilt über den Kopf */
  .stars { position: absolute; inset: 0 0 auto; height: 640px; pointer-events: none; z-index: -1; }
  .star {
    position: absolute; width: var(--star-size-md); aspect-ratio: 1;
    background: var(--gold-light);
    clip-path: polygon(50% 0, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
    animation: twinkle var(--dur-twinkle) ease-in-out infinite;
  }
  .star-core { position: absolute; inset: var(--bw-sm); clip-path: inherit; --dots-size: var(--dots-size-sm); }
  .star:nth-child(1) { top: 10%; left: 8%; width: var(--star-size-lg); }
  .star:nth-child(2) { top: 26%; left: 18%; width: var(--star-size-sm); animation-delay: calc(var(--dur-twinkle) * -0.3); }
  .star:nth-child(3) { top: 52%; left: 6%; animation-delay: calc(var(--dur-twinkle) * -0.6); }
  .star:nth-child(4) { top: 70%; left: 22%; width: var(--star-size-sm); animation-delay: calc(var(--dur-twinkle) * -0.15); }
  .star:nth-child(5) { top: 12%; right: 10%; animation-delay: calc(var(--dur-twinkle) * -0.8); }
  .star:nth-child(6) { top: 32%; right: 20%; width: var(--star-size-lg); animation-delay: calc(var(--dur-twinkle) * -0.45); }
  .star:nth-child(7) { top: 58%; right: 7%; width: var(--star-size-sm); animation-delay: calc(var(--dur-twinkle) * -0.7); }
  .star:nth-child(8) { top: 76%; right: 24%; animation-delay: calc(var(--dur-twinkle) * -0.9); }
  .star:nth-child(9) { top: 6%; left: 40%; width: var(--star-size-sm); animation-delay: calc(var(--dur-twinkle) * -0.25); }
  .star:nth-child(10) { top: 8%; right: 36%; width: var(--star-size-sm); animation-delay: calc(var(--dur-twinkle) * -0.55); }
  .star:nth-child(11) { top: 44%; left: 30%; width: var(--star-size-sm); animation-delay: calc(var(--dur-twinkle) * -0.35); }
  .star:nth-child(12) { top: 46%; right: 32%; width: var(--star-size-sm); animation-delay: calc(var(--dur-twinkle) * -0.65); }
  @keyframes twinkle {
    0%, 100% { transform: scale(1) rotate(0deg); opacity: 1; }
    50% { transform: scale(0.55) rotate(25deg); opacity: 0.6; }
  }

  /* Gesperrt: Tresortür */
  .safe {
    display: flex; flex-direction: column; align-items: center; text-align: center; gap: var(--space-3);
    max-width: 640px; margin: 0 auto; padding: var(--space-8) var(--space-6);
    border: var(--bw) solid var(--gold); border-radius: var(--radius-lg); box-shadow: var(--shadow-gold);
    background: var(--night);
  }
  .door {
    display: grid; place-items: center; width: 132px; aspect-ratio: 1; border-radius: 50%;
    background: var(--gold-foil); border: var(--bw) solid var(--on-accent); box-shadow: var(--shadow-new);
  }
  .dial {
    display: grid; place-items: center; width: 64%; aspect-ratio: 1; border-radius: 50%;
    background: var(--night); color: var(--gold-light); border: var(--bw-sm) dashed var(--gold);
    font-size: var(--fs-3xl); --icon-size: 1em;
  }
  .safe h2 { margin: var(--space-2) 0 0; font-size: var(--fs-2xl); }
  .safe p { margin: 0; color: var(--on-night-muted); }
  .progress {
    --p: 0;
    width: 100%; height: var(--space-5); margin-top: var(--space-2);
    border: var(--bw-sm) solid var(--gold); border-radius: var(--radius-pill); background: var(--night); overflow: hidden;
  }
  .progress-fill { display: block; height: 100%; width: calc(var(--p) * 100%); background: var(--gold-foil); }
  .best { font-family: var(--font-display); font-weight: 700; color: var(--gold-light); }
  .safe .best { color: var(--gold-light); }

  /* Knopf in Blattgold */
  .gold-btn { background: var(--gold-foil); color: var(--on-accent); border-color: var(--on-accent); box-shadow: var(--shadow-gold); }
  .gold-btn:hover { box-shadow: var(--shadow-gold-xl); }

  /* Freigeschaltet: Pergament-Tafel mit doppeltem Goldrahmen und Eck-Ornamenten */
  .open { max-width: 820px; margin: 0 auto; }
  .plaque {
    position: relative; padding: var(--space-11) var(--space-10) var(--space-10);
    background: var(--parchment); color: var(--on-accent);
    border: var(--bw-accent) double var(--gold-deep); border-radius: var(--radius-sm);
    outline: var(--bw-sm) solid var(--gold); outline-offset: var(--space-2);
    box-shadow: var(--shadow-gold-xl);
    font-size: var(--fs-lg);
  }
  [data-unlocked] .plaque { animation: reveal var(--dur-reveal) var(--ease-pop) both; }
  @keyframes reveal {
    0% { opacity: 0; transform: translateY(40px) scale(0.94) rotate(-1deg); }
    100% { opacity: 1; transform: none; }
  }
  .plaque::after {
    content: ''; position: absolute; inset: 0; pointer-events: none; border-radius: inherit;
    background: var(--gold-shine); transform: translateX(-120%);
  }
  [data-unlocked] .plaque::after { animation: sweep calc(var(--dur-reveal) * 1.6) var(--ease) calc(var(--dur-reveal) * 0.6) both; }
  @keyframes sweep { to { transform: translateX(120%); } }
  .corner { position: absolute; font-size: var(--fs-xl); line-height: 1; color: var(--gold-deep); }
  .corner:nth-child(1) { top: var(--space-3); left: var(--space-4); }
  .corner:nth-child(2) { top: var(--space-3); right: var(--space-4); }
  .corner:nth-child(3) { bottom: var(--space-3); left: var(--space-4); }
  .corner:nth-child(4) { bottom: var(--space-3); right: var(--space-4); }
  .lead { margin: 0; font-family: var(--font-display); font-size: var(--fs-3xl); font-weight: 700; line-height: 1.25; letter-spacing: -0.02em; text-align: center; text-wrap: balance; }
  .divider { margin: var(--space-6) 0; text-align: center; color: var(--gold-deep); letter-spacing: 0.6em; font-size: var(--fs-md); }
  .text { margin: 0; line-height: 1.75; }
  .text::first-letter {
    float: left; margin: var(--space-1) var(--space-3) 0 0; padding: 0 var(--space-2);
    font-family: var(--font-display); font-size: var(--fs-emoji-md); font-weight: 800; line-height: 0.9;
    background: var(--gold-foil); color: var(--on-accent); border: var(--bw-sm) solid var(--on-accent); border-radius: var(--radius-sm);
  }
  .evidence { margin-top: var(--space-9); padding-top: var(--space-6); border-top: var(--bw-sm) dashed var(--gold-deep); font-size: var(--fs-sm); color: var(--parchment-muted); scroll-margin-top: var(--space-12); }
  .evidence h2 { margin: 0 0 var(--space-3); font-size: var(--fs-md); text-transform: uppercase; letter-spacing: 0.14em; color: var(--on-accent); }
  .evidence ol { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-2); counter-reset: ev; }
  .evidence li { counter-increment: ev; display: flex; gap: var(--space-3); align-items: baseline; }
  .evidence li::before {
    content: counter(ev); flex: 0 0 auto; display: grid; place-items: center; width: var(--space-6); aspect-ratio: 1;
    border-radius: 50%; background: var(--gold-foil); border: var(--bw-xs) solid var(--on-accent);
    color: var(--on-accent); font-family: var(--font-display); font-size: var(--fs-xs); font-weight: 800;
  }
  .evidence a { color: var(--parchment-muted); }

  /* Werbung: ein ausgesuchtes Stück, klar gekennzeichnet */
