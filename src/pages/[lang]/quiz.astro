---
// Quiz-Seite /de/quiz/ und /en/quiz/ (Wunsch von Eric, 2026-10-15): Der Menüpunkt „Quiz“ führt hierher statt auf die
// Startseite. Gelber Kopf wie die Kategorien-Seite, darunter dieselben Spiele wie auf der Startseite (Wahr oder Fake, Was war zuerst).
import Base from '../../layouts/Base.astro';
import TrueOrFake from '../../components/home/TrueOrFake.astro';
import WhatFirst from '../../components/home/WhatFirst.astro';
import Icon from '../../components/Icon.astro';
import { LANGS, type Lang } from '../../config';
import { t, quizPath } from '../../i18n/ui';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const q = t(lang).quiz;
const other: Lang = lang === 'de' ? 'en' : 'de';
---
<Base lang={lang} title={q.pageTitle} description={q.pageIntro} altUrl={quizPath(other)}>
  <section class="sec sec--yellow qhero">
    <div class="wrap">
      <span class="pill">{q.pageKicker}</span>
      <h1 class="mega word">{q.pageTitle}</h1>
      <p class="intro">{q.pageIntro}</p>
      <div class="acts">
        <a class="btn btn--pink" href="#wof">{q.playWof} <Icon name="chevron-down" /></a>
        <a class="btn btn--ghost" href="#first">{q.playFirst} <Icon name="chevron-down" /></a>
      </div>
    </div>
  </section>
  <TrueOrFake lang={lang} />
  <WhatFirst lang={lang} />
</Base>

<style>
  .qhero { padding: var(--space-10) 0 calc(var(--space-12) + var(--bleed)); overflow: clip; }
  .pill { display: inline-block; padding: var(--space-2) var(--space-4); border-radius: var(--radius-pill); background: var(--on-accent); color: var(--yellow); font-family: var(--font-display); font-weight: 700; font-size: var(--fs-lg); transform: rotate(-3deg); }
  .word { margin: var(--space-5) calc(-1 * var(--space-4)) 0; font-size: var(--fs-huge); text-transform: uppercase; text-shadow: var(--shift-mega) var(--shift-mega) 0 var(--pink); transform: rotate(-2deg); }
  .intro { max-width: 46ch; margin: var(--space-12) 0 0; font-size: var(--fs-xl); font-weight: 600; }
  .acts { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-7); }
  .acts .btn { border-color: var(--on-accent); box-shadow: var(--shadow-accent-sm); }
  .acts .btn--ghost { background: var(--surface); color: var(--ink); }
  /* Sprungziele der Knöpfe: Platz für Kopfzeile und die Quizkarte, die über den Abschnitt ragt */
  :global(#wof), :global(#first) { scroll-margin-top: calc(var(--space-12) + var(--bleed)); }
  @media (max-width: 760px) {
    .pill { font-size: var(--fs-md); }
    .intro { margin-top: var(--space-8); font-size: var(--fs-lg); }
    .acts .btn { flex: 1 1 auto; justify-content: center; }
  }
</style>
