---
// Startseite im Design „E“ (Wunsch von Eric, 2026-10-10). Reihenfolge und Flächen:
// Gelb Datum (DayHero) → montags Pink Abstimmung → Nacht Fakt des Tages → Nacht Heute neu → Papier Labor →
// Pink/Lime Wahr oder Fake → Violett Was war zuerst → Papier Woche → Nacht Kategorien. Regeln: docs/design-system.md.
import Base from '../../layouts/Base.astro';
import DayHero from '../../components/home/DayHero.astro';
import FactOfDay from '../../components/home/FactOfDay.astro';
import TodayNew from '../../components/home/TodayNew.astro';
import Labor from '../../components/home/Labor.astro';
import TrueOrFake from '../../components/home/TrueOrFake.astro';
import WhatFirst from '../../components/home/WhatFirst.astro';
import WeekBlock from '../../components/home/WeekBlock.astro';
import CatsGrid from '../../components/home/CatsGrid.astro';
import Vote from '../../components/Vote.astro';
import Icon from '../../components/Icon.astro';
import { LANGS, type Lang } from '../../config';
import { t, catsPath, chartsPath } from '../../i18n/ui';
import { postsFor } from '../../lib';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const ui = t(lang);
const posts = await postsFor(lang);
const catsUrl = catsPath(lang);
const chartsUrl = chartsPath(lang);
---
<Base lang={lang}>
  <DayHero lang={lang} catsUrl={catsUrl} posts={posts} />
  <section class="sec sec--pink monvote" data-edge data-focus-day="1">
    <span class="focus-tag">{ui.home.dayFocus}</span>
    <div class="wrap"><Vote lang={lang} posts={posts} /></div>
  </section>
  <FactOfDay lang={lang} posts={posts} />
  <TodayNew lang={lang} posts={posts} allUrl="#facts" />
  <Labor lang={lang} posts={posts} catsUrl={catsUrl} />
  <TrueOrFake lang={lang} />
  <WhatFirst lang={lang} />
  <WeekBlock lang={lang} posts={posts} chartsUrl={chartsUrl} />
  <section class="sec sec--night cats-sec" data-edge="left" data-focus-day="0">
    <span class="focus-tag">{ui.home.dayFocus}</span>
    <div class="wrap">
      <div class="sec-head"><h2>{ui.home.catsTitle}</h2><a class="more-link" href={catsUrl}>{ui.home.allCategories} <Icon name="chevron-right" /></a></div>
      <CatsGrid lang={lang} posts={posts} />
    </div>
  </section>
</Base>

<style>
  /* Montags-Abstimmung: nur sichtbar, wenn Vote.astro sich einblendet (montags) */
  .monvote { padding-block: var(--space-10); }
  .monvote:has(.wrap > [hidden]) { display: none; }
  .monvote :global(.vote) { border-color: var(--on-accent); box-shadow: var(--shadow-2xl); margin-top: calc(-1 * var(--bleed) - var(--space-10)); position: relative; z-index: 2; }
  .cats-sec { padding-block: calc(var(--space-12) + var(--space-4)) calc(var(--space-12) + var(--space-8)); }
  .cats-sec h2 { color: var(--on-night); }
</style>
