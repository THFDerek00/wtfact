---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { LANGS, CATEGORIES, type Lang } from '../../config';
import { t } from '../../i18n/ui';
import { postsFor } from '../../lib';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const ui = t(lang);
const posts = await postsFor(lang);
const [hero, ...rest] = posts;
const used = new Set(posts.map((p) => p.data.category));
---
<Base lang={lang}>
  <section class="wrap intro">
    <h1>{ui.tagline}</h1>
  </section>

  {hero && <section class="wrap"><PostCard post={hero} big /></section>}

  <section class="wrap list">
    <div class="head">
      <h2>{ui.latest}</h2>
      <div class="filters" role="group">
        <button class="chip on" data-filter="all" type="button">{ui.allCategories}</button>
        {CATEGORIES.filter((c) => used.has(c)).map((c) => (
          <button class:list={['chip', `cat-${c}`]} data-filter={c} type="button">{ui.categories[c]}</button>
        ))}
      </div>
    </div>
    <div class="grid">
      {rest.map((p) => <PostCard post={p} />)}
    </div>
  </section>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      buttons.forEach((x) => x.classList.toggle('on', x === b));
      const f = b.dataset.filter;
      document.querySelectorAll<HTMLElement>('.grid [data-cat]').forEach((card) => {
        card.hidden = f !== 'all' && card.dataset.cat !== f;
      });
    }),
  );
</script>

<style>
  .intro h1 { font-size: clamp(30px, 6vw, 56px); margin: 12px 0 28px; max-width: 18ch; }
  .list { margin-top: 56px; }
  .head { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; justify-content: space-between; margin-bottom: 20px; }
  .head h2 { margin: 0; font-size: 28px; }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; }
  .filters .chip { cursor: pointer; background: var(--surface); color: var(--ink); }
  .filters .chip[class*='cat-'] { color: #141414; }
  .filters .chip.on { box-shadow: 2px 2px 0 var(--line); transform: translate(-1px, -1px); outline: 2px solid var(--line); }
  .filters .chip:not(.on) { opacity: .75; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 24px; }
  [hidden] { display: none !important; }
</style>
