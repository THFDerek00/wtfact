---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProductBox from '../../components/ProductBox.astro';
import ShareBar from '../../components/ShareBar.astro';
import PostCard from '../../components/PostCard.astro';
import NewBadge from '../../components/NewBadge.astro';
import Thumbs from '../../components/Thumbs.astro';
import Icon from '../../components/Icon.astro';
import { LANGS } from '../../config';
import { t, dateFmt } from '../../i18n/ui';
import { postsFor, langOf, slugOf, postUrl, translationOf, readingMinutes, factNumber, type Post } from '../../lib';
import { ogPath } from '../../og';

export async function getStaticPaths() {
  const all = (await Promise.all(LANGS.map(postsFor))).flat();
  return all.map((post) => ({ params: { lang: langOf(post), slug: slugOf(post) }, props: { post } }));
}
const { post } = Astro.props as { post: Post };
const lang = langOf(post);
const ui = t(lang);
const d = post.data;
const { Content } = await render(post);
const alt = await translationOf(post);
const all = await postsFor(lang);
const i = all.findIndex((p) => p.id === post.id);
// Nächster Fakt = der davor veröffentlichte (beim ältesten wieder der neueste), so entsteht eine Kette.
const next = all.length > 1 ? all[(i + 1) % all.length] : undefined;
const related = all.filter((p) => p.id !== post.id && p.id !== next?.id && p.data.category === d.category).slice(0, 2);
const no = String(factNumber(post, all)).padStart(3, '0');
---
<Base lang={lang} title={d.title} description={d.teaser} altUrl={alt ? postUrl(alt) : undefined} image={ogPath(post)}>
  <div class="progress" aria-hidden="true"><span></span></div>
  <section class:list={['banner', `cat-${d.category}`]}>
    <div class="wrap banner-inner">
      <div class="meta">
        <span class="chip">{ui.categories[d.category]}</span>
        <span class="no">{ui.factNo} #{no}</span>
        <NewBadge lang={lang} date={d.date} />
      </div>
      <h1>{d.title}</h1>
      <p class="info">{dateFmt(lang, d.date)} · {ui.readingTime(readingMinutes(post.body))} · <a href="#sources"><Icon name="badge-check" /> {ui.sourcesCount(d.sources.length)}</a></p>
      <span class="big-emoji" aria-hidden="true">{d.emoji}</span>
    </div>
  </section>

  <div class="wrap fact-layout">
  <article class="fact-main" data-fact-key={d.translationKey}>
    <p class="hook card"><span class="hook-label">WTF?!</span>{d.hook}</p>

    <Thumbs lang={lang} factKey={d.translationKey} place="inline" />

    <div class="content"><Content /></div>

    <ProductBox lang={lang} products={d.products} category={d.category} />


    {d.sources.length > 0 && (
      <section class="sources" id="sources">
        <h2>{ui.sources}</h2>
        <ol>{d.sources.map((s) => <li><a href={s.url} rel="noopener" target="_blank">{s.label}</a></li>)}</ol>
      </section>
    )}

    <ShareBar lang={lang} title={d.title} />
  </article>

  <aside class="fact-side">
  <Thumbs lang={lang} factKey={d.translationKey} place="side" />
  {next && (
    <section class="nextup">
      <a class="next card" href={postUrl(next)}>
        <span class="next-label">{ui.next} <Icon name="chevron-right" /></span>
        <span class="next-title"><span aria-hidden="true">{next.data.emoji}</span> {next.data.title}</span>
      </a>
    </section>
  )}

  {related.length > 0 && (
    <section class="related">
      <h2>{ui.categories[d.category]}</h2>
      <div class="related-grid">{related.map((p) => <PostCard post={p} no={factNumber(p, all)} />)}</div>
    </section>
  )}
  </aside>
  </div>
</Base>

<script>
  import { markRead } from '../../scripts/fame';
  // Für das Sammelalbum in der Hall of Fame: Dieser Fakt gilt als gelesen.
  const key = document.querySelector<HTMLElement>('[data-fact-key]')?.dataset.factKey;
  if (key) markRead(key);
  const bar = document.querySelector<HTMLElement>('.progress span');
  const update = () => {
    const max = document.documentElement.scrollHeight - innerHeight;
    if (bar) bar.style.transform = `scaleX(${max > 0 ? Math.min(1, scrollY / max) : 0})`;
  };
  addEventListener('scroll', update, { passive: true });
  update();
</script>

<style>
  .progress { position: fixed; top: 0; left: 0; right: 0; height: 5px; z-index: 6; pointer-events: none; }
  .progress span { display: block; height: 100%; background: var(--pink); transform-origin: left; transform: scaleX(0); }

  .banner { position: relative; overflow: hidden; border-bottom: var(--bw) solid var(--line); padding: var(--space-10) 0 var(--space-12); --dots-size: var(--dots-size-lg); }
  .banner-inner { position: relative; }
  .meta { display: flex; flex-wrap: wrap; gap: var(--space-3); align-items: center; }
  .no { font-family: var(--font-display); font-weight: 700; font-size: var(--fs-sm); }
  h1 { position: relative; z-index: 1; font-size: var(--fs-display-lg); margin: var(--space-4) 0 var(--space-4); max-width: 24ch; }
  .info { position: relative; z-index: 1; margin: 0; font-size: var(--fs-sm); font-weight: 600; }
  .big-emoji {
    position: absolute; right: calc(-2 * var(--space-12)); bottom: calc(-1 * var(--space-12));
    font-size: var(--fs-emoji-2xl); transform: rotate(12deg); filter: var(--emoji-shadow); opacity: 0.9;
  }

  /* Breites Layout (Wunsch von Eric, 2026-10-02): Fakt links, „Noch ein Fakt“ und Verwandtes rechts daneben */
  .fact-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(280px, 380px); gap: var(--space-11); align-items: start; }
  .fact-main { font-size: var(--fs-lg); }
  .fact-side { position: sticky; top: var(--space-12); display: flex; flex-direction: column; gap: var(--space-8); margin-top: var(--space-8); }

  .hook {
    position: relative; margin: calc(-1 * var(--space-9)) 0 var(--space-8); padding: var(--space-6) var(--space-5) var(--space-5);
    font-family: var(--font-display); font-size: var(--fs-xl); font-weight: 600; line-height: 1.4;
    box-shadow: var(--shadow-lg);
  }
  .hook-label {
    position: absolute; top: calc(-1 * var(--space-4)); left: var(--space-5);
    padding: 0 var(--space-2); border: var(--bw-sm) solid var(--line); border-radius: var(--radius-sm);
    background: var(--yellow); color: var(--on-accent); font-size: var(--fs-sm); font-weight: 800; transform: rotate(-3deg);
  }

  .content :global(h2) { font-size: var(--fs-2xl); margin-top: var(--space-9); }
  .content :global(blockquote) {
    position: relative; margin: var(--space-9) 0; padding: var(--space-6) var(--space-5) var(--space-5);
    border: var(--bw) solid var(--line); border-radius: var(--radius-md); box-shadow: var(--shadow-md);
    background: var(--cyan); color: var(--on-accent); font-family: var(--font-display); font-weight: 600;
  }
  .content :global(blockquote p) { margin: 0; }
  .content :global(blockquote)::before {
    content: 'Bonus fact'; position: absolute; top: calc(-1 * var(--space-4)); left: var(--space-5);
    padding: 0 var(--space-2); border: var(--bw-sm) solid var(--line); border-radius: var(--radius-sm);
    background: var(--surface); color: var(--ink); font-size: var(--fs-sm); font-weight: 800;
  }
  .content :global(blockquote:lang(de))::before { content: 'Bonus-Fakt'; }
  .content :global(strong) { background: linear-gradient(transparent 60%, color-mix(in srgb, var(--pink) 35%, transparent) 0); }

  .sources { margin: var(--space-9) 0; font-size: var(--fs-sm); color: var(--muted); scroll-margin-top: var(--space-12); }
  .sources h2 { font-size: var(--fs-lg); color: var(--ink); margin: 0 0 var(--space-2); }
  .sources ol { margin: 0; padding-left: var(--space-5); }

  .next {
    display: flex; flex-direction: column; gap: var(--space-2); padding: var(--space-6);
    background: var(--night); color: var(--on-night); text-decoration: none; --focus: var(--yellow);
    transition: transform var(--dur) var(--ease-pop), box-shadow var(--dur) var(--ease);
  }
  .next:hover { transform: translate(-3px, -3px) rotate(-0.6deg); box-shadow: var(--shadow-xl); }
  .next-label { display: inline-flex; align-items: center; gap: var(--space-1); font-family: var(--font-display); font-size: var(--fs-sm); font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; color: var(--yellow); }
  .next-title { font-family: var(--font-display); font-size: var(--fs-2xl); font-weight: 700; line-height: 1.1; }

  .related h2 { font-size: var(--fs-2xl); margin: 0 0 var(--space-5); }
  .related-grid { display: grid; gap: var(--space-6); }

  @media (max-width: 960px) {
    .fact-layout { grid-template-columns: minmax(0, 1fr); gap: var(--space-4); }
    .fact-side { position: static; margin-top: 0; }
    .related-grid { grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); }
  }

  @media (max-width: 560px) {
    .big-emoji { font-size: var(--fs-emoji-sm); top: 0; bottom: auto; right: 0; }
  }
</style>
