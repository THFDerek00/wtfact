---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProductBox from '../../components/ProductBox.astro';
import ShareBar from '../../components/ShareBar.astro';
import PostCard from '../../components/PostCard.astro';
import { LANGS } from '../../config';
import { t, dateFmt } from '../../i18n/ui';
import { postsFor, langOf, slugOf, postUrl, translationOf, readingMinutes, type Post } from '../../lib';

export async function getStaticPaths() {
  const all = (await Promise.all(LANGS.map(postsFor))).flat();
  return all.map((post) => ({ params: { lang: langOf(post), slug: slugOf(post) }, props: { post } }));
}
const { post } = Astro.props as { post: Post };
const lang = langOf(post);
const ui = t(lang);
const d = post.data;
const { Content } = await render(post);
const alt = await translationOf(post);
const others = (await postsFor(lang)).filter((p) => p.id !== post.id);
const next = others.find((p) => p.data.category !== d.category) ?? others[0];
---
<Base lang={lang} title={d.title} description={d.teaser} altUrl={alt ? postUrl(alt) : undefined}>
  <article class="narrow">
    <header>
      <div class="meta">
        <span class:list={['chip', `cat-${d.category}`]}>{ui.categories[d.category]}</span>
        <span>{dateFmt(lang, d.date)} · {ui.readingTime(readingMinutes(post.body))}</span>
      </div>
      <h1>{d.title}</h1>
      <p class="hook card accent"><span aria-hidden="true">{d.emoji}</span>{d.hook}</p>
    </header>

    <div class="content"><Content /></div>

    <ProductBox lang={lang} products={d.products} />

    {d.sources.length > 0 && (
      <details class="sources">
        <summary>{ui.sources}</summary>
        <ul>{d.sources.map((s) => <li><a href={s.url} rel="noopener" target="_blank">{s.label}</a></li>)}</ul>
      </details>
    )}

    <ShareBar lang={lang} title={d.title} />
  </article>

  {next && (
    <section class="narrow nextup">
      <h2>{ui.next} 👇</h2>
      <PostCard post={next} />
    </section>
  )}
</Base>

<style>
  header { margin-top: var(--space-3); }
  .meta { display: flex; flex-wrap: wrap; gap: var(--space-3); align-items: center; font-size: var(--fs-sm); color: var(--muted); }
  h1 { font-size: var(--fs-display-lg); margin: var(--space-4) 0 var(--space-6); }
  .hook { display: flex; gap: var(--space-4); align-items: center; padding: var(--space-5); margin: 0 0 var(--space-7); font-family: var(--font-display); font-size: var(--fs-lg); font-weight: 600; line-height: 1.45; }
  .hook span { font-size: var(--fs-emoji-sm); }
  .content :global(h2) { font-size: var(--fs-2xl); margin-top: var(--space-9); }
  .content :global(blockquote) { margin: var(--space-6) 0; padding: var(--space-1) var(--space-5); border-left: var(--bw-accent) solid var(--pink); font-style: italic; }
  .content :global(strong) { background: linear-gradient(transparent 60%, color-mix(in srgb, var(--pink) 35%, transparent) 0); }
  .sources { font-size: var(--fs-sm); color: var(--muted); }
  .sources summary { cursor: pointer; font-weight: 600; }
  .nextup { margin-top: var(--space-10); }
  .nextup h2 { font-size: var(--fs-2xl); }
</style>
