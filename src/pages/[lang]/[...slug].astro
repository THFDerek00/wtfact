---
// Faktseite im Design „E“ (Wunsch von Eric, 2026-10-10): Plakat mit großer Zahl, Band mit Slogan, Schätzfrage,
// Text auf Papier mit gelbem Streifen und daneben Daumen plus zwei weitere Fakten, Werbung über die ganze Breite,
// Beweise auf der Nacht, WTF-Barometer (nur hier) und seit 2026-10-21 der Kaninchenbau (RabbitHole.astro) statt „Noch ein WTF zum Schluss“.
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProductBox from '../../components/ProductBox.astro';
import ProductTeaser from '../../components/ProductTeaser.astro';
import ShareBar from '../../components/ShareBar.astro';
import NewBadge from '../../components/NewBadge.astro';
import Thumbs from '../../components/Thumbs.astro';
import Icon from '../../components/Icon.astro';
import FestDeco from '../../components/FestDeco.astro';
import FestArt from '../../components/FestArt.astro';
import RabbitHole from '../../components/RabbitHole.astro';
import { LANGS } from '../../config';
import { t, dateFmt } from '../../i18n/ui';
import { postsFor, langOf, slugOf, postUrl, translationOf, readingMinutes, factNumber, bigNumber, guessFor, festFor, type Post } from '../../lib';
import { ogPath } from '../../og';

export async function getStaticPaths() {
  const all = (await Promise.all(LANGS.map(postsFor))).flat();
  return all.map((post) => ({ params: { lang: langOf(post), slug: slugOf(post) }, props: { post } }));
}
const { post } = Astro.props as { post: Post };
const lang = langOf(post);
const ui = t(lang);
const fp = ui.factPage;
const d = post.data;
const { Content } = await render(post);
const alt = await translationOf(post);
const all = await postsFor(lang);
const i = all.findIndex((p) => p.id === post.id);
// Nächster Fakt = der davor veröffentlichte (beim ältesten wieder der neueste), so entsteht eine Kette.
const next = all.length > 1 ? all[(i + 1) % all.length] : undefined;
const others = all.filter((p) => p.id !== post.id);
// Zwei Fakten neben dem Text: erst aus derselben Kategorie, sonst die nächsten.
const side = [...others.filter((p) => p.data.category === d.category && p.id !== next?.id), ...others].filter((p, k, arr) => arr.indexOf(p) === k).slice(0, 2);
const no = String(factNumber(post, all)).padStart(3, '0');
const big = bigNumber(post);
const guess = guessFor(post);
const sideTile = (p: Post) => ({ p, big: bigNumber(p) });
// Feiertags- und Grusel-Fakten: ganze Seite in der Farbwelt des Themas, Deko im Kopf, Band mit dem Feiertag.
const fest = festFor(post);
// Normale Kategorien haben seit 2026-10-20 auch ein Thema (Farbe und Deko), behalten aber den Slogan im Band.
const festName = fest?.holiday ? fest.holiday[lang] : fest?.theme === 'grusel' ? ui.fest.grusel : '';
// Das Band läuft über die ganze Breite: so oft wiederholen, dass es auch auf breiten Bildschirmen nicht abreißt (Eric, 2026-10-15).
const tapeWord = festName || ui.slogan;
const tapeText = Array(Math.max(5, Math.ceil(400 / (tapeWord.length + 3)))).fill(tapeWord).join(' · ');
---
<Base lang={lang} title={d.title} description={d.teaser} altUrl={alt ? postUrl(alt) : undefined} image={ogPath(post)} section="facts" fest={fest?.theme}>
  <div class="progress" aria-hidden="true"><span></span></div>

  <section class:list={['sec', 'sec--night', 'fhero', fest && 'fest-sky']}>
    {fest && <FestDeco deco={fest.deco} size="lg" />}
    <div class="wrap poster">
      <a class="crumb" href={`/${lang}/?cat=${d.category}#facts`}>{ui.categories[d.category]} <Icon name="chevron-right" /></a>
      {!fest?.holiday && <span class:list={['slab', fest ? 'fest-a' : `cat-${d.category}`]} aria-hidden="true"><span>{d.emoji}</span></span>}
      {fest?.holiday
        ? <div class="fest-art bleed"><FestArt theme={fest.theme} emoji={fest.holiday.emoji} art={fest.holiday.art} /></div>
        : big
        ? <p class="mega big bleed" aria-hidden="true" data-len={Math.min(big.show.length, 8)}>{big.show}{big.below && <span class="unit">{big.below}</span>}</p>
        : <p class="big-emoji bleed" aria-hidden="true">{d.emoji}</p>}
      <div class="card hcard bleed">
        <span class="sticker">WTF?!</span>
        <div class="meta">
          <span class:list={['chip', `cat-${d.category}`]}>{ui.categories[d.category]}</span>
          <span class="chip">{ui.factNo} #{no}</span>
          <NewBadge lang={lang} date={d.date} />
          {fest?.holiday && <span class="chip fest-chip">{ui.fest.on(fest.holiday[lang])}</span>}
        </div>
        <h1>{d.title}</h1>
        <p class="hook" data-fact-key={d.translationKey}>{d.hook}</p>
        <p class="info">{dateFmt(lang, d.date)} · {ui.readingTime(readingMinutes(post.body))} · <a href="#sources"><Icon name="badge-check" /> {ui.sourcesCount(d.sources.length)}</a></p>
      </div>
    </div>
  </section>
  <div class="tape bleed" aria-hidden="true"><span>{tapeText}</span></div>

  <section class="sec sec--paper body-sec">
    <div class="wrap">
      {guess && (
        <div class="card guess" data-guess={d.translationKey} data-correct={guess.correct} data-stat={fp.guessStat(9001)}>
          <div class="g-q">
            <span class="g-kicker">{fp.guessKicker}</span>
            <p class="g-title">{fp.guessQ}</p>
            <p class="g-text">{guess.before}<span class="gap" data-gap>___</span>{guess.after}</p>
          </div>
          <div class="g-ans" role="group" aria-label={fp.guessLabel}>
            {guess.options.map((o, k) => <button class="g-btn" type="button" aria-pressed="false" data-opt={k}>{o}</button>)}
          </div>
          <p class="g-res" data-res aria-live="polite" hidden>
            <b data-ok-text={fp.guessRight} data-no-text={`${fp.guessWrong} ${guess.options[guess.correct]}.`}></b> <span data-pct></span>
          </p>
        </div>
      )}

      <div class="cols">
        <article class="paper" data-fact-key={d.translationKey}>
          <Thumbs lang={lang} factKey={d.translationKey} place="inline" />
          {d.products[0] && <ProductTeaser lang={lang} product={d.products[0]} category={d.category} place="inline" factKey={d.translationKey} />}
          <div class="content"><Content /></div>
        </article>
        <aside class="aside">
          <Thumbs lang={lang} factKey={d.translationKey} place="side" />
          {side.length > 0 && (
            <div class="two">
              <p class="side-h">{fp.twoFacts}</p>
              {side.map(sideTile).map(({ p, big: b }, k) => (
                <a class:list={['stile', k === 0 && b ? `cat-${p.data.category}` : 'stile--paper']} href={postUrl(p)}>
                  <span class:list={['chip', k === 0 && b ? 'chip-light' : `cat-${p.data.category}`]}>{ui.categories[p.data.category]}</span>
                  {k === 0 && b ? <span class="s-big" aria-hidden="true">{b.show}{b.below && <small>{b.below}</small>}</span> : <span class="s-emoji" aria-hidden="true">{p.data.emoji}</span>}
                  <span class="s-title">{p.data.title}</span>
                </a>
              ))}
            </div>
          )}
        </aside>
      </div>
    </div>
  </section>

  {d.products.length > 0 && (
    <section class:list={['sec', 'pickband', fest?.holiday ? 'fest-sky' : 'sec--yellow']} data-edge>
      <div class="wrap"><ProductBox lang={lang} products={d.products} category={d.category} factKey={d.translationKey} wide
        fest={fest?.holiday ? { name: festName, icon: fest.holiday.art ?? fest.holiday.emoji } : undefined} /></div>
    </section>
  )}

  {d.sources.length > 0 && (
    <section class="sec sec--night proofs" id="sources" data-edge="left">
      <div class="wrap">
        <h2>{fp.proofs}</h2>
        <ol class="srcs">{d.sources.map((s, k) => <li><b>{k + 1}</b><a href={s.url} rel="noopener" target="_blank">{s.label}</a></li>)}</ol>
        <ShareBar lang={lang} title={d.title} />
      </div>
    </section>
  )}

  <section class="sec sec--pink baro" data-edge data-baro={d.translationKey} data-avg={fp.baroAvg('§', 9001)} data-avg-one={fp.baroAvg('§', 1)} data-thanks={fp.baroThanks}>
    <div class="wrap b-in">
      <h2>{fp.baroTitle}</h2>
      <p>{fp.baroIntro}</p>
      <div class="slider">
        <input type="range" min="0" max="10" step="1" value="5" aria-label={fp.baroLabel} data-range />
        <div class="lbls" aria-hidden="true"><span>{fp.baroLow}</span><span>{fp.baroMid}</span><span>{fp.baroHigh}</span></div>
      </div>
      <div class="b-row">
        <output class="b-val" data-val>5</output>
        <button class="btn btn--ghost" type="button" data-send>{fp.baroSave}</button>
      </div>
      <p class="b-avg" data-avg-out aria-live="polite"></p>
    </div>
  </section>

  <RabbitHole lang={lang} post={post} others={others} />
</Base>

<script>
  import { markRead } from '../../scripts/fame';
  import { markActive } from '../../scripts/streak';
  import { answer, myAnswer, tallies, localTally, share, total, type Tally } from '../../scripts/quiz';
  // Für das Sammelalbum in den WTF-Charts: Dieser Fakt gilt als gelesen.
  const key = document.querySelector<HTMLElement>('[data-fact-key]')?.dataset.factKey;
  if (key) markRead(key);
  // Ein gelesener Fakt hält die Serie am Leben (Seite „Ich“)
  markActive();
  const bar = document.querySelector<HTMLElement>('.progress span');
  const update = () => {
    const max = document.documentElement.scrollHeight - innerHeight;
    if (bar) bar.style.transform = `scaleX(${max > 0 ? Math.min(1, scrollY / max) : 0})`;
  };
  addEventListener('scroll', update, { passive: true });
  update();

  // ---------- Schätzfrage ----------
  const g = document.querySelector<HTMLElement>('[data-guess]');
  if (g) {
    const id = g.dataset.guess!;
    const correct = Number(g.dataset.correct);
    const btns = [...g.querySelectorAll<HTMLButtonElement>('[data-opt]')];
    const show = (pick: number, counts: Tally) => {
      btns.forEach((b, k) => {
        b.disabled = true;
        b.setAttribute('aria-pressed', String(k === pick));
        b.dataset.result = k === correct ? 'ok' : k === pick ? 'no' : '';
      });
      g.querySelector('[data-gap]')!.textContent = btns[correct].textContent;
      const res = g.querySelector<HTMLElement>('[data-res]')!;
      const b = res.querySelector<HTMLElement>('b')!;
      b.textContent = (pick === correct ? b.dataset.okText : b.dataset.noText) ?? '';
      b.toggleAttribute('data-ok', pick === correct);
      res.querySelector('[data-pct]')!.textContent = total(counts) > 1 ? g.dataset.stat!.replace('9001', String(100 - share(counts, correct))) : '';
      res.hidden = false;
    };
    const mine = myAnswer('guess', id);
    if (mine !== undefined) tallies('guess', id).then((t) => show(mine, t?.[id] ?? localTally('guess', id)));
    btns.forEach((b, k) => b.addEventListener('click', async () => {
      show(k, localTally('guess', id));
      const counts = await answer('guess', id, k);
      if (counts) show(k, counts);
    }));
  }

  // ---------- WTF-Barometer ----------
  const baro = document.querySelector<HTMLElement>('[data-baro]');
  if (baro) {
    const id = baro.dataset.baro!;
    const range = baro.querySelector<HTMLInputElement>('[data-range]')!;
    const val = baro.querySelector<HTMLOutputElement>('[data-val]')!;
    const out = baro.querySelector<HTMLElement>('[data-avg-out]')!;
    const avg = (c: Tally) => {
      const n = total(c);
      if (!n) return;
      const sum = Object.entries(c).reduce((s, [k, v]) => s + Number(k) * v, 0);
      const a = (sum / n).toLocaleString(document.documentElement.lang, { maximumFractionDigits: 1 });
      out.textContent = (n === 1 ? baro.dataset.avgOne! : baro.dataset.avg!.replace('9001', String(n))).replace('§', a);
    };
    const sync = () => { val.textContent = range.value; baro.style.setProperty('--v', range.value); };
    range.addEventListener('input', sync);
    const mine = myAnswer('baro', id);
    if (mine !== undefined) range.value = String(mine);
    sync();
    tallies('baro', id).then((t) => t?.[id] && avg(t[id]));
    baro.querySelector('[data-send]')!.addEventListener('click', async () => {
      const counts = (await answer('baro', id, Number(range.value))) ?? localTally('baro', id);
      avg(counts);
      out.textContent = `${baro.dataset.thanks} ${out.textContent}`;
    });
  }
</script>

<style>
  .progress { position: fixed; top: 0; left: 0; right: 0; height: var(--space-1); z-index: 6; pointer-events: none; }
  .progress span { display: block; height: 100%; background: var(--pink); transform-origin: left; transform: scaleX(0); }

  /* Plakat */
  .fhero { padding: var(--space-8) 0 calc(var(--space-12) + var(--space-8)); }
  .poster { position: relative; display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: var(--space-8); align-items: end; min-height: 32rem; }
  .crumb { position: absolute; top: 0; left: 0; z-index: 3; display: inline-flex; align-items: center; gap: var(--space-1); font-family: var(--font-display); font-weight: 700; color: var(--yellow); text-decoration: none; }
  .crumb:hover { text-decoration: underline; }
  .slab {
    position: absolute; right: 4%; top: var(--space-2); width: 40%; height: 70%; display: grid; place-items: center; overflow: hidden;
    border: var(--bw-strong) solid var(--on-accent); border-radius: var(--radius-lg); box-shadow: var(--shadow-night-lime); transform: rotate(2.5deg);
  }
  .slab span { font-size: var(--fs-emoji-2xl); transform: rotate(-10deg); filter: var(--emoji-shadow); }
  .big { grid-column: 1; align-self: center; margin: var(--space-10) 0 0 calc(-1 * var(--space-2)); font-size: calc(var(--fs-mega) * 0.9 * var(--fit, 1)); text-shadow: var(--shift-mega) var(--shift-mega) 0 var(--pink); }
  .big[data-len='4'] { --fit: 0.85; }
  .big[data-len='5'] { --fit: 0.72; }
  .big[data-len='6'] { --fit: 0.6; }
  .big[data-len='7'], .big[data-len='8'] { --fit: 0.5; }
  .unit { display: block; margin-top: var(--space-4); font-size: var(--fs-display-md); letter-spacing: -0.02em; -webkit-text-stroke: 0; color: var(--yellow); text-shadow: none; }
  .big-emoji { grid-column: 1; margin: 0; font-size: var(--fs-huge); line-height: 1; transform: rotate(-8deg); filter: var(--emoji-shadow); }
  .hcard {
    grid-column: 2; position: relative; z-index: 3; display: flex; flex-direction: column; gap: var(--space-3); padding: var(--space-8) var(--space-7) var(--space-7);
    margin-bottom: calc(-1 * var(--space-12) - var(--space-12)); background: var(--surface); color: var(--ink); border: var(--bw-strong) solid var(--on-accent); box-shadow: var(--shadow-2xl);
  }
  .hcard .sticker { position: absolute; top: calc(-1 * var(--space-5)); left: var(--space-6); font-family: var(--font-display); font-weight: 800; font-size: var(--fs-xl); border: var(--bw-sm) solid var(--on-accent); }
  /* Feiertags-Fakt: riesiges Motiv des Festes statt Zahl und Emoji-Block */
  .fest-art { grid-column: 1; align-self: center; width: 100%; max-width: 34rem; }
  .fest-chip { background: var(--fest-a); color: var(--on-accent); border-color: var(--on-accent); }
  .meta { display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: center; }
  h1 { margin: var(--space-2) 0 0; font-size: var(--fs-display-md); line-height: 1.05; letter-spacing: -0.03em; }
  .hook { margin: 0; font-size: var(--fs-lg); color: var(--muted); }
  .info { margin: 0; font-size: var(--fs-sm); font-weight: 600; }
  .info a { display: inline-flex; align-items: center; gap: var(--space-1); }
  /* Band mit Slogan, ragt schräg über beide Abschnitte */
  .tape {
    margin: calc(-1 * var(--space-6)) calc(-1 * var(--space-6)) 0; padding: var(--space-3) 0; overflow: hidden; white-space: nowrap;
    background: var(--lime); color: var(--on-accent); border-block: var(--bw-strong) solid var(--on-accent); transform: rotate(-1.6deg);
    font-family: var(--font-display); font-weight: 800; font-size: var(--fs-xl); text-transform: uppercase; letter-spacing: 0.02em;
  }

  /* Schätzfrage */
  .body-sec { padding-top: var(--space-12); }
  .guess {
    display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: var(--space-6) var(--space-8); align-items: center;
    padding: var(--space-7); margin-bottom: var(--space-11); border-width: var(--bw-strong); box-shadow: var(--shadow-xl); transform: rotate(-0.4deg);
  }
  .g-kicker { display: inline-block; padding: var(--space-1) var(--space-3); border: var(--bw-sm) solid var(--on-accent); border-radius: var(--radius-sm); background: var(--yellow); color: var(--on-accent); font-family: var(--font-display); font-weight: 800; font-size: var(--fs-sm); transform: rotate(-3deg); }
  .g-title { margin: var(--space-3) 0 var(--space-2); font-family: var(--font-display); font-size: var(--fs-2xl); font-weight: 700; line-height: 1.15; }
  .g-text { margin: 0; color: var(--muted); }
  .gap { display: inline-block; min-width: 3ch; padding: 0 var(--space-1); border-bottom: var(--bw-strong) solid var(--pink); color: var(--ink); font-weight: 800; }
  .g-ans { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-3); }
  .g-btn {
    padding: var(--space-4) var(--space-2); border: var(--bw-strong) solid var(--line); border-radius: var(--radius-md); background: var(--surface); color: var(--ink);
    font-family: var(--font-display); font-size: var(--fs-2xl); font-weight: 800; cursor: pointer; box-shadow: var(--shadow-md);
    transition: transform var(--dur) var(--ease-pop), box-shadow var(--dur) var(--ease);
  }
  .g-btn:not(:disabled):hover { transform: translate(-2px, -2px) rotate(-2deg); box-shadow: var(--shadow-lg); }
  .g-btn:disabled { cursor: default; }
  .g-btn[data-result='ok'] { background: var(--lime); color: var(--on-accent); border-color: var(--on-accent); }
  .g-btn[data-result='no'] { background: var(--pink); color: var(--on-accent); border-color: var(--on-accent); text-decoration: line-through; }
  .g-res { grid-column: 1 / -1; margin: 0; font-weight: 600; }
  .g-res b { padding: var(--space-1) var(--space-3); border-radius: var(--radius-sm); background: var(--pink); color: var(--on-accent); font-family: var(--font-display); }
  .g-res b[data-ok] { background: var(--lime); }

  /* Text auf Papier mit gelbem Streifen, daneben Daumen und zwei Fakten */
  .cols { display: grid; grid-template-columns: minmax(0, 54rem) minmax(280px, 1fr); gap: var(--space-11); align-items: start; }
  .paper {
    padding: var(--space-9) var(--space-10); background: var(--surface); color: var(--ink); font-size: var(--fs-lg);
    border: var(--bw-strong) solid var(--line); border-left: var(--bw-stripe) solid var(--yellow); border-radius: var(--radius-lg); box-shadow: var(--shadow-2xl);
  }
  .content > :global(:first-child) { margin-top: 0; }
  .content :global(h2) { font-size: var(--fs-display-sm); margin-top: var(--space-10); }
  .content :global(p:first-child)::first-letter { font-family: var(--font-display); font-weight: 800; }
  /* Bonus-Fakt: gelbes Band, ragt links und rechts über das Papier hinaus */
  .content :global(blockquote) {
    position: relative; margin: var(--space-10) calc(-1 * var(--space-12)); padding: var(--space-8) var(--space-12) var(--space-7);
    background: var(--dots), var(--yellow); background-size: var(--dots-size-md) var(--dots-size-md); color: var(--on-accent);
    border-block: var(--bw-strong) solid var(--on-accent); transform: rotate(-1deg);
    font-family: var(--font-display); font-size: var(--fs-2xl); font-weight: 700; line-height: 1.3;
  }
  .content :global(blockquote p) { margin: 0; }
  .content :global(blockquote)::before {
    content: 'Bonus fact'; position: absolute; top: calc(-1 * var(--space-4)); left: var(--space-12);
    padding: var(--space-1) var(--space-3); border: var(--bw-sm) solid var(--on-accent); border-radius: var(--radius-sm);
    background: var(--pink); color: var(--on-accent); font-size: var(--fs-sm); font-weight: 800; transform: rotate(-3deg);
  }
  .content :global(blockquote:lang(de))::before { content: 'Bonus-Fakt'; }
  .content :global(strong) { background: linear-gradient(transparent 60%, color-mix(in srgb, var(--yellow) 70%, transparent) 0); }
  .aside { position: sticky; top: var(--space-12); display: flex; flex-direction: column; gap: var(--space-8); }
  .side-h { margin: 0 0 var(--space-3); font-family: var(--font-display); font-weight: 800; font-size: var(--fs-sm); text-transform: uppercase; letter-spacing: 0.08em; }
  .two { display: grid; gap: var(--space-6); }
  .stile {
    position: relative; display: flex; flex-direction: column; gap: var(--space-2); min-height: 12rem; padding: var(--space-5); overflow: hidden;
    border: var(--bw-strong) solid var(--on-accent); border-radius: var(--radius-lg); box-shadow: var(--shadow-lg); text-decoration: none;
    transition: transform var(--dur) var(--ease-pop), box-shadow var(--dur) var(--ease);
  }
  .stile:hover { transform: translate(-3px, -3px) rotate(-1.5deg); box-shadow: var(--shadow-xl); }
  .stile:nth-child(2) { transform: rotate(1deg); }
  .stile--paper { background: var(--surface); color: var(--ink); border-color: var(--line); border-left: var(--bw-stripe) solid var(--yellow); }
  .stile .chip { align-self: flex-start; }
  .chip-light { background: var(--surface); color: var(--ink); }
  .s-big { font-family: var(--font-display); font-weight: 800; font-size: var(--fs-display-lg); line-height: 0.9; letter-spacing: -0.05em; color: var(--on-night); -webkit-text-stroke: var(--bw-strong) var(--on-accent); paint-order: stroke fill; }
  .s-big small { font-size: var(--fs-lg); -webkit-text-stroke: 0; color: var(--on-accent); margin-left: var(--space-1); letter-spacing: 0; }
  .s-emoji { position: absolute; right: calc(-1 * var(--space-2)); top: var(--space-6); font-size: var(--fs-emoji-md); transform: rotate(12deg); filter: var(--emoji-shadow); }
