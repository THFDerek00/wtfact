---
// Kopf der Startseite (Design „E“, Wunsch von Eric, 2026-10-10): gelbe Fläche mit heutigem Wochentag und Datum.
// Wechselt jeden Tag um Mitternacht (deutsche Zeit) im Browser, auch wenn die Seite nicht neu gebaut wurde.
// Jeder Wochentag hat eigene Farbe, eigene Überschrift und einen Abschnitt „im Fokus“ (data-focus-day an den Abschnitten):
// Montag Abstimmung, Dienstag Fakt der Woche, Mittwoch Wahr oder Fake, Donnerstag Was war zuerst, Freitag Top 5,
// Samstag neue Quizfragen, Sonntag Kategorien.
// Am Feiertag (Wunsch von Eric, 2026-10-15) übernimmt das Fest den Kopf: Name des Festes riesig, riesiges Motiv
// (Kürbis, Flagge …), Farben und Deko des Themas und der Feiertags-Fakt des Tages groß in der Mitte.
// Am nächsten Tag schaltet der Browser von selbst zurück auf den Wochentag.
import type { Lang } from '../../config';
import { t } from '../../i18n/ui';
import { berlinDay, postDay } from '../../week';
import { holidayOn, festOfHoliday } from '../../data/holidays';
import { postUrl, type Post } from '../../lib';
import Icon from '../Icon.astro';
import FestDeco from '../FestDeco.astro';
import FestArt from '../FestArt.astro';
interface Props { lang: Lang; catsUrl: string; posts: Post[] }
const { lang, catsUrl, posts } = Astro.props;
const ui = t(lang);
const h = ui.home;
const today = berlinDay();
const wd = new Date(`${today}T12:00:00Z`).getUTCDay();
const dateText = new Intl.DateTimeFormat(lang === 'de' ? 'de-DE' : 'en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${today}T12:00:00Z`));
const hrefs = [catsUrl, '#vote', '#week', '#wof', '#first', '#week', '#wof'];
const holiday = holidayOn(today);
const fest = holiday && festOfHoliday(holiday);
const festFact = holiday && posts.find((p) => p.data.category === 'holiday' && postDay(p.data.date) === today);
const festName = holiday?.[lang] ?? '';
const festWord = holiday?.word?.[lang] ?? festName;
---
{fest && holiday && (
  <section class="sec fest-sky fest-hero" data-fest={fest.theme} data-fest-hero={today}>
    <FestDeco deco={fest.deco} size="lg" />
    <div class="wrap top-row">
      <span class="pill">{dateText}</span>
    </div>
    <p class="mega fest-word" aria-hidden="true" data-len={Math.min(festWord.length, 14)}>{festWord}</p>
    <div class="wrap fest-row">
      <div class="fest-art"><FestArt theme={fest.theme} emoji={holiday.emoji} /></div>
      <div class="card fest-card">
        <span class="sticker">{ui.fest.greeting(festName)}</span>
        {festFact ? (
          <>
            <span class="chip fest-chip">{holiday.emoji} {ui.fest.holiday}</span>
            <h1><a href={postUrl(festFact)}>{festFact.data.title}</a></h1>
            <p class="fest-hook">{festFact.data.hook}</p>
            <div class="acts">
              <a class="btn fest-btn" href={postUrl(festFact)}>{ui.fest.read} <Icon name="chevron-right" /></a>
              <a class="btn btn--ghost" href="#today">{ui.fest.more} <Icon name="chevron-down" /></a>
            </div>
          </>
        ) : (
          <>
            <h1>{ui.fest.greeting(festName)}</h1>
            <div class="acts"><a class="btn btn--ghost" href="#today">{ui.fest.more} <Icon name="chevron-down" /></a></div>
          </>
        )}
      </div>
    </div>
  </section>
)}
<section class="sec sec--yellow day-hero" data-day-hero data-weekday={wd} data-lang={lang} hidden={!!fest}>
  <div class="wrap top-row">
    <span class="pill" data-date>{dateText}</span>
  </div>
  <p class="mega day-word" aria-hidden="true" data-day-word data-len={h.days[wd].length}>{h.days[wd]}</p>
  <div class="wrap row">
    {h.dayTitles.map((title, i) => (
      <div class="variant" data-variant={i} hidden={i !== wd}>
        <h1>{title}</h1>
        <div class="acts">
          <a class="btn btn--ghost" href={hrefs[i]}>{h.dayCtas[i]} <Icon name="chevron-right" /></a>
          <a class="btn btn--pink" href="#today">{h.go} <Icon name="chevron-down" /></a>
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  import { berlinDay, nextDayStart } from '../../week';
  // Feiertags-Kopf nur am Feiertag selbst, danach wieder der Wochentag
  const festHero = document.querySelector<HTMLElement>('[data-fest-hero]');
  if (festHero && festHero.dataset.festHero !== berlinDay()) {
    festHero.remove();
    document.querySelector<HTMLElement>('[data-day-hero]')?.removeAttribute('hidden');
  }
  const root = document.querySelector<HTMLElement>('[data-day-hero]');
  if (root) {
    const lang = root.dataset.lang === 'en' ? 'en-GB' : 'de-DE';
    const apply = () => {
      const today = berlinDay();
      const noon = new Date(`${today}T12:00:00Z`);
      const wd = noon.getUTCDay();
      root.dataset.weekday = String(wd);
      root.querySelector('[data-date]')!.textContent = new Intl.DateTimeFormat(lang, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(noon);
      const word = root.querySelector<HTMLElement>('[data-day-word]')!;
      word.textContent = new Intl.DateTimeFormat(lang, { weekday: 'long', timeZone: 'UTC' }).format(noon);
      word.dataset.len = String(word.textContent.length);
      root.querySelectorAll<HTMLElement>('[data-variant]').forEach((v) => (v.hidden = v.dataset.variant !== String(wd)));
      // Abschnitt des Tages markieren
      document.querySelectorAll<HTMLElement>('[data-focus-day]').forEach((s) => s.toggleAttribute('data-focus', s.dataset.focusDay!.split(',').includes(String(wd))));
      // Um Mitternacht weiterschalten
      setTimeout(apply, Math.max(1000, nextDayStart(today) - Date.now() + 1000));
    };
    apply();
  }
</script>

<style>
  .day-hero[hidden] { display: none; }
  /* Feiertags-Kopf */
  .fest-hero { position: relative; padding: var(--space-8) 0 calc(var(--space-12) + var(--bleed)); overflow: clip; }
  .fest-hero .top-row, .fest-word, .fest-row { position: relative; z-index: 1; }
  .fest-hero .pill { background: var(--fest-a); color: var(--on-accent); }
  .fest-word {
    margin: var(--space-4) calc(-1 * var(--space-6)) 0; font-size: calc(var(--fs-mega) * var(--fit, 1)); text-transform: uppercase;
    text-shadow: var(--shift-mega) var(--shift-mega) 0 var(--fest-b); transform: rotate(-3deg); transform-origin: left center;
  }
  .fest-word[data-len='8'], .fest-word[data-len='9'] { --fit: 0.8; }
  .fest-word[data-len='10'], .fest-word[data-len='11'] { --fit: 0.66; }
  .fest-word[data-len='12'], .fest-word[data-len='13'], .fest-word[data-len='14'] { --fit: 0.5; }
  .fest-row { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: var(--space-8); align-items: center; margin-top: var(--space-6); }
  .fest-art { max-width: 30rem; justify-self: center; width: 100%; }
  .fest-card {
    position: relative; display: flex; flex-direction: column; gap: var(--space-3); padding: var(--space-9) var(--space-7) var(--space-7);
    background: var(--surface); color: var(--ink); border: var(--bw-strong) solid var(--on-accent); box-shadow: var(--shadow-on-night); transform: rotate(-1deg);
  }
  .fest-card .sticker { position: absolute; top: calc(-1 * var(--space-5)); left: var(--space-6); background: var(--fest-b); font-family: var(--font-display); font-weight: 800; font-size: var(--fs-xl); border: var(--bw-sm) solid var(--on-accent); }
  .fest-chip { align-self: flex-start; background: var(--fest-a); color: var(--on-accent); border-color: var(--on-accent); }
  .fest-card h1 { margin: 0; max-width: none; padding: 0; background: none; border: 0; box-shadow: none; transform: none; font-size: var(--fs-display-md); }
  .fest-card h1 a { color: inherit; text-decoration: none; }
  .fest-card h1 a:hover { text-decoration: underline; }
  .fest-hook { margin: 0; color: var(--muted); font-size: var(--fs-lg); }
  .fest-btn { background: var(--fest-a); color: var(--on-accent); }
  @media (max-width: 860px) {
    .fest-row { grid-template-columns: minmax(0, 1fr); }
    .fest-art { max-width: 18rem; }
    .fest-word { margin-inline: calc(-1 * var(--space-2)); }
  }
  .day-hero { padding: var(--space-8) 0 calc(var(--space-12) + var(--bleed)); overflow: clip; border-bottom: none; }
  .top-row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); }
  .pill {
    display: inline-block; padding: var(--space-2) var(--space-4); border-radius: var(--radius-pill);
    background: var(--on-accent); color: var(--yellow); font-family: var(--font-display); font-weight: 700; font-size: var(--fs-lg);
    transform: rotate(-2deg);
  }
  .day-word {
    margin: var(--space-4) calc(-1 * var(--space-6)) 0; font-size: calc(var(--fs-mega) * var(--fit, 1)); text-transform: uppercase;
    text-shadow: var(--shift-mega) var(--shift-mega) 0 var(--day-accent, var(--pink));
    transform: rotate(-3deg); transform-origin: left center;
  }
  /* Lange Wochentage etwas kleiner, damit das Wort lesbar bleibt und trotzdem über den Rand ragt */
  .day-word[data-len='7'] { --fit: 0.92; }
  .day-word[data-len='8'] { --fit: 0.82; }
  .day-word[data-len='9'] { --fit: 0.74; }
  .day-word[data-len='10'] { --fit: 0.68; }
  .row { margin-top: calc(-1 * var(--space-8)); position: relative; }
  .variant { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: var(--space-6); }
  .variant[hidden] { display: none; }
  h1 {
    margin: 0; max-width: 20ch; font-size: var(--fs-display-lg); line-height: 1.02; letter-spacing: -0.04em;
    padding: var(--space-4) var(--space-5); background: var(--yellow); border: var(--bw-strong) solid var(--on-accent);
    border-radius: var(--radius-md); box-shadow: var(--shadow-accent); transform: rotate(-1deg);
  }
  .acts { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .acts .btn { border-color: var(--on-accent); box-shadow: var(--shadow-accent-sm); }
  .acts .btn--ghost { background: var(--surface); color: var(--ink); }
  /* Farbe je Wochentag: Schatten des Riesenworts */
  [data-weekday='1'] { --day-accent: var(--pink); }
  [data-weekday='2'] { --day-accent: var(--lime); }
  [data-weekday='3'] { --day-accent: var(--cyan); }
  [data-weekday='4'] { --day-accent: var(--violet); }
  [data-weekday='5'] { --day-accent: var(--orange); }
  [data-weekday='6'] { --day-accent: var(--teal); }
  [data-weekday='0'] { --day-accent: var(--blue); }
  @media (max-width: 760px) {
    .day-hero { padding-top: var(--space-5); }
    .day-word { margin-inline: calc(-1 * var(--space-2)); }
    /* Lange Wochentage etwas kleiner, damit das Wort lesbar bleibt und trotzdem über den Rand ragt */
  .day-word[data-len='7'] { --fit: 0.92; }
  .day-word[data-len='8'] { --fit: 0.82; }
  .day-word[data-len='9'] { --fit: 0.74; }
  .day-word[data-len='10'] { --fit: 0.68; }
  .row { margin-top: calc(-1 * var(--space-4)); }
    .acts { width: 100%; }
    .acts .btn { flex: 1 1 auto; }
  }
</style>
