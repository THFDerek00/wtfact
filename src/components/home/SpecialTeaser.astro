---
// Hinweis auf die Sonderseite zum neuen Tesla Roadster (Wunsch von Eric, 2026-10-17), nur auf der deutschen Startseite.
// Dunkle Bühne im Thema „nature“ (2026-10-20) zwischen „Heute neu“ und Labor; zum Entfernen die Zeile in src/pages/[lang]/index.astro löschen.
import Icon from '../Icon.astro';
import FestDeco from '../FestDeco.astro';
import type { Lang } from '../../config';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
{lang === 'de' && (
  <section class="sec fest-sky special" data-fest="nature" data-edge>
    <FestDeco deco={['bolt', 'sprout', 'sparkle', 'question']} size="lg" />
    <div class="wrap row">
      <span class="emoji" aria-hidden="true">🐌</span>
      <div class="text">
        <span class="chip chip--new">Sonderseite</span>
        <h2>Kann ein Auto kopfüber fahren?</h2>
        <p>Was der neue Tesla Roadster wirklich gezeigt hat, was nur behauptet ist, und warum eine Schnecke das schon immer kann.</p>
      </div>
      <a class="btn btn--go" href="/de/kopfueber/">Zum Faktencheck <Icon name="chevron-right" /></a>
    </div>
  </section>
)}
<style>
  .special { padding-block: var(--space-10) calc(var(--space-10) + var(--edge)); }
  .special { --fest-glow-y: 60%; }
  .special .row { position: relative; z-index: 1; }
  .row { display: grid; grid-template-columns: auto 1fr auto; gap: var(--space-6); align-items: center; }
  .emoji { position: relative; display: inline-block; justify-self: start; font-size: var(--fs-emoji-lg); transform: scaleX(-1) rotate(-8deg); filter: var(--emoji-shadow); }
  .emoji::before {
    content: ''; position: absolute; inset: -40%; z-index: -1; border-radius: 50%;
    background: radial-gradient(circle closest-side, color-mix(in srgb, var(--fest-a) 55%, transparent), transparent);
  }
  .chip--new { background: var(--fest-b); color: var(--on-accent); border-color: var(--on-accent); }
  .btn--go { background: var(--fest-a); color: var(--on-accent); }
  h2 { margin: var(--space-2) 0; font-size: var(--fs-display-sm); }
  p { margin: 0; max-width: var(--measure); font-weight: 600; color: var(--on-night); }
  @media (max-width: 760px) {
    .row { grid-template-columns: 1fr; }
    .emoji { font-size: var(--fs-emoji-md); }
  }
</style>
