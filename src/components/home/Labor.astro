---
// „Frisch aus dem Labor“ (Design „E“, Karten aus Entwurf A): alle Fakten als Kacheln auf Papier, mit Filter nach Kategorie.
// Alle Kacheln gleich gebaut (Wunsch von Eric, 2026-10-15): Kategoriefarbe, Emoji, Titel im weißen Kasten.
// Raster (Wunsch von Eric, 2026-10-15): neuester Fakt groß (2 × 2), zweit- und drittneuester als breite Karten (2 × 1)
// rechts daneben, darunter acht kleine Karten, dann die Werbung als Band über die ganze Breite. Die Karten sehen am
// Desktop aus wie am Handy (kompakt, Titel im weißen Kasten). Handy und Tablet: 2 Spalten, der neueste über die ganze Breite.
// Filter: Raster aus „Alle“ + Kategorien, damit keine Kategorie allein in einer Zeile steht. Bei 15 Kategorien:
// Desktop 2 × 8, Tablet 4 × 4, Handy „Alle“ über die ganze Breite und darunter 5 × 3. Seit Grusel und Feiertage
// (2026-10-15) rechnet die Komponente die Spalten aus der Zahl der Filter aus (Desktop 2 Zeilen, Tablet 4 bis 6 Spalten).
// ?cat=<kategorie> in der Adresse filtert direkt (Links von der Kategorien-Seite). Beim Filtern sind alle Karten klein.
import type { Lang } from '../../config';
import { CATEGORIES } from '../../config';
import { t } from '../../i18n/ui';
import { postUrl, factNumber, festFor, type Post } from '../../lib';
import { berlinDay, postDay } from '../../week';
import FestDeco from '../FestDeco.astro';
import FestIcon from '../FestIcon.astro';
import NewBadge from '../NewBadge.astro';
import AdCard from '../AdCard.astro';
import Icon from '../Icon.astro';
interface Props { lang: Lang; posts: Post[]; catsUrl: string }
const { lang, posts: all, catsUrl } = Astro.props;
// Am Feiertag steht der Feiertags-Fakt den ganzen Tag als große Karte vorn (Wunsch von Eric, 2026-10-15).
const today = berlinDay();
const pinned = all.find((p) => p.data.category === 'holiday' && postDay(p.data.date) === today);
const posts = pinned ? [pinned, ...all.filter((p) => p !== pinned)] : all;
const ui = t(lang);
const PAGE = 11;
const count = (c: string) => posts.filter((p) => p.data.category === c).length;
const cats = CATEGORIES.filter((c) => count(c) > 0);
const hero = posts[0];
const n = cats.length + 1;
const tablet = [4, 6, 5].reduce((best, c) => ((c - (n % c)) % c < (best - (n % best)) % best ? c : best));
const filterVars = { fDesk: Math.ceil(n / 3), fTab: tablet, fAllSpan: (n - 1) % 3 === 0 ? '1 / -1' : 'auto' };
---
<section class="sec sec--paper labor" id="facts" data-edge="left">
  <div class="wrap">
    <div class="sec-head">
      <h2>{ui.home.laborTitle[0]} <span class="mark">{ui.home.laborTitle[1]}</span></h2>
      <a class="more-link" href={catsUrl}>{ui.home.allCategories} <Icon name="chevron-right" /></a>
    </div>
    <div class="filters" role="group" aria-label={ui.filterLabel}>
      <button class="chip all" data-filter="all" type="button" aria-pressed="true">{ui.allCategories}</button>
      {cats.map((c) => (
        <button class:list={['chip', `cat-${c}`]} data-filter={c} type="button" aria-pressed="false">{ui.categories[c]}</button>
      ))}
    </div>
    <div class="grid paged all" data-grid>
      {posts.map((p, i) => {
        const d = p.data;
        // Feiertags- und Grusel-Fakten: Karte in der Farbwelt des Themas mit Deko (src/data/holidays.ts)
        const fest = festFor(p);
        return (
          <>
            <a href={postUrl(p)} data-fest={fest?.theme} class:list={['tile', fest ? 'fest-sky' : `cat-${d.category}`, `tilt-${i % 4}`, i === 0 && 'tile--big', (i === 1 || i === 2) && 'tile--wide']} data-cat={d.category} data-page={i >= PAGE ? 'later' : undefined} hidden={i >= PAGE}>
              {fest && <FestDeco deco={fest.deco} />}
              <span class="top">
                <span class="chip chip-light">{fest?.holiday ? fest.holiday[lang] : ui.categories[d.category]}</span>
                <NewBadge lang={lang} date={d.date} />
              </span>
              <span class="emoji" aria-hidden="true">{fest?.holiday?.art ? <FestIcon name={fest.holiday.art} /> : d.emoji}</span>
              <span class="title">{d.title}</span>
              <span class="foot"><span>#{String(factNumber(p, all)).padStart(3, '0')}</span><span class="go">{ui.readMore} <Icon name="chevron-right" /></span></span>
            </a>
            {i === PAGE - 1 && hero?.data.products[0] && (
              <AdCard lang={lang} product={hero.data.products[0]} category={hero.data.category} factKey={hero.data.translationKey} factTitle={hero.data.title} />
            )}
          </>
        );
      })}
    </div>
    {posts.length > PAGE && (
      <div class="loadmore"><button class="btn" type="button" data-loadmore>{ui.loadMore}</button></div>
    )}
  </div>
</section>

<script>
  const root = document.getElementById('facts');
  if (root) {
    const buttons = root.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const cards = root.querySelectorAll<HTMLElement>('.grid [data-cat]');
    const more = root.querySelector<HTMLButtonElement>('[data-loadmore]');
    const grid = root.querySelector<HTMLElement>('[data-grid]');
    let expanded = false;
    const apply = (filter: string) => {
      grid?.classList.toggle('paged', filter === 'all' && !expanded);
      grid?.classList.toggle('all', filter === 'all');
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.filter === filter)));
      cards.forEach((card) => {
        const matches = filter === 'all' || card.dataset.cat === filter;
        const paged = filter === 'all' && !expanded && card.dataset.page === 'later';
        card.hidden = !matches || paged;
      });
      if (more) more.hidden = filter !== 'all' || expanded;
    };
    buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter ?? 'all')));
    more?.addEventListener('click', () => { expanded = true; apply('all'); });
    // Von der Kategorien-Seite: /?cat=space#facts
    const cat = new URLSearchParams(location.search).get('cat');
    if (cat && [...buttons].some((b) => b.dataset.filter === cat)) apply(cat);
    // Kategorie-Kacheln weiter unten auf der Startseite filtern direkt hier
    document.querySelectorAll<HTMLElement>('[data-jump]').forEach((el) =>
      el.addEventListener('click', (e) => {
        if (!document.getElementById('facts')) return;
        e.preventDefault();
        apply(el.dataset.jump ?? 'all');
        root.scrollIntoView();
      }),
    );
  }
</script>

<style define:vars={filterVars}>
  /* Unten Platz für die Quizkarte, die von unten in den Abschnitt ragt (TrueOrFake.astro) */
  .labor { scroll-margin-top: var(--space-10); padding-bottom: calc(2 * var(--space-12)); }
  /* Alle Knöpfe gleich groß (Eric, 2026-10-15): Reihen so hoch wie der höchste Knopf, drei Reihen auf dem Desktop, damit nichts umbricht */
  .filters { display: grid; grid-template-columns: repeat(var(--fDesk), minmax(0, 1fr)); grid-auto-rows: 1fr; gap: var(--space-2); margin-bottom: var(--space-9); }
  .filters .chip { cursor: pointer; justify-content: center; text-align: center; padding: var(--space-2) var(--space-3); font-size: var(--fs-sm); box-shadow: var(--shadow-xs); }
  @media (max-width: 1060px) { .filters { grid-template-columns: repeat(var(--fTab), minmax(0, 1fr)); } }
  @media (max-width: 600px) {
    .filters { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .filters .all { grid-column: var(--fAllSpan); }
    .filters .chip { padding-inline: var(--space-2); font-size: var(--fs-xs); }
  }
  .grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-6) var(--space-5); align-items: stretch; }
  /* Karten wie am Handy: kompakt, Emoji in der Ecke, Titel im weißen Kasten */
  .tile {
    position: relative; display: flex; flex-direction: column; gap: var(--space-2); min-height: 15rem; padding: var(--space-4);
    border: var(--bw-strong) solid var(--on-accent); border-radius: var(--radius-lg); box-shadow: var(--shadow-lg);
    text-decoration: none; overflow: hidden;
    transition: transform var(--dur) var(--ease-pop), box-shadow var(--dur) var(--ease);
  }
  .tile[data-fest] { border-color: var(--fest-a); }
  .tile:hover { transform: translate(-3px, -4px) rotate(-1.5deg); box-shadow: var(--shadow-2xl); }
  .tilt-1 { transform: rotate(0.8deg); }
  .tilt-3 { transform: rotate(-0.8deg); }
  .top { display: flex; flex-wrap: wrap; gap: var(--space-2); position: relative; z-index: 1; }
  .chip-light { background: var(--surface); color: var(--ink); }
  .emoji { position: absolute; right: calc(-1 * var(--space-4)); top: var(--space-9); font-size: var(--fs-emoji-md); line-height: 1; transform: rotate(12deg); filter: var(--emoji-shadow); transition: transform var(--dur) var(--ease-pop); }
  .tile:hover .emoji { transform: rotate(-6deg) scale(1.08); }
  .title {
    margin-top: auto; position: relative; z-index: 1; padding: var(--space-2) var(--space-3);
    background: var(--surface); color: var(--ink); border: var(--bw-sm) solid var(--on-accent); border-radius: var(--radius-md);
    font-family: var(--font-display); font-size: var(--fs-lg); font-weight: 700; line-height: 1.15; letter-spacing: -0.02em;
    hyphens: auto; overflow-wrap: break-word;
  }
  .foot { display: flex; justify-content: flex-end; align-items: center; gap: var(--space-2); font-family: var(--font-display); font-weight: 700; font-size: var(--fs-sm); position: relative; z-index: 1; }
  .foot span:first-child { display: none; }
  .go { display: inline-flex; align-items: center; gap: var(--space-1); }
  /* Die drei neuesten (nur ohne Filter): groß links, zwei breite rechts daneben */
  .all .tile--big { grid-column: span 2; grid-row: span 2; padding: var(--space-6); }
  .all .tile--big .emoji { font-size: var(--fs-emoji-2xl); top: var(--space-12); right: calc(-1 * var(--space-2)); }
  .all .tile--big .title { font-size: var(--fs-3xl); padding: var(--space-4) var(--space-5); }
  .all .tile--big .foot { font-size: var(--fs-md); }
  .all .tile--wide { grid-column: span 2; min-height: 0; }
  .all .tile--wide .title { font-size: var(--fs-xl); max-width: 80%; }
  /* Werbung als breites Band unter den ersten elf Fakten */
  .grid :global(.pickcard) { grid-column: 1 / -1; border-radius: var(--radius-lg); }
  @media (min-width: 561px) {
    .grid :global(.pickcard) { flex-direction: row; }
    .grid :global(.pickcard .art) { flex: 0 0 30%; aspect-ratio: auto; border-bottom: 0; border-right: var(--bw) solid var(--line); }
  }
  .loadmore { display: flex; justify-content: center; margin-top: var(--space-10); }
  @media (max-width: 1060px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); }
    .all .tile--big { grid-row: auto; min-height: 18rem; padding: var(--space-4); }
    .all .tile--big .title { font-size: var(--fs-2xl); }
    .all .tile--big .emoji { font-size: var(--fs-emoji-lg); top: var(--space-9); }
    .all .tile--wide { grid-column: auto; min-height: 15rem; }
    .all .tile--wide .title { font-size: var(--fs-lg); max-width: none; }
  }
  @media (max-width: 520px) {
    .tile { padding: var(--space-3); }
    .emoji { top: var(--space-9); }
    .title, .all .tile--wide .title { font-size: var(--fs-md); padding: var(--space-2); }
    .all .tile--big .title { font-size: var(--fs-xl); padding: var(--space-3); }
  }
</style>
