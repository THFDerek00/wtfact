---
// Tagesleiste (Wunsch von Eric, 2026-10-21) direkt unter dem Wochentag: drei Kacheln, jede führt direkt ins Ziel.
// Als Leuchtkarten (.glow) im Stil der Kategorien, damit sie nicht als bunte Flächen aus dem Kopf herausstechen.
// Serie (src/scripts/streak.ts), Tageszahl (offen oder gelöst) und Fakt des Tages. Den Stand füllt der Browser.
// Weitere Kacheln: einen Eintrag in `tiles` ergänzen. Mit `from`/`to` (MM-TT, deutscher Tag) erscheint eine Kachel
// nur in diesem Zeitraum, z. B. { from: '12-01', to: '12-24' } für einen Adventskalender. Geprüft wird im Browser.
import type { Lang } from '../../config';
import { x, mePath, numberPath } from '../../i18n/extras';
import { at, adventPath } from '../../i18n/advent';
interface Props { lang: Lang }
type Tile = { id: string; href: string; emoji: string; cls: string; fest: string; label: string; value: string; from?: string; to?: string };
const { lang } = Astro.props;
const s = x(lang).strip;
const xa = at(lang).tile;
const tiles: Tile[] = [
  { id: 'streak', href: mePath(lang), emoji: '🔥', cls: 'cat-history', fest: 'history', label: s.streak, value: s.streakOff },
  { id: 'number', href: numberPath(lang), emoji: '🎯', cls: 'cat-nature', fest: 'nature', label: s.number, value: s.numberOpen },
  { id: 'fotd', href: '#fotd', emoji: '⭐', cls: 'cat-weird', fest: 'weird', label: s.fotd, value: s.fotdText },
  // Adventskalender (src/data/advent.ts): Türchen des Tages, vom 1. bis 24.12.
  { id: 'advent', href: adventPath(lang), emoji: '🎁', cls: 'cat-food', fest: 'xmas', label: xa.label, value: xa.value.replace('{n}', '1'), from: '12-01', to: '12-24' },
];
const texts = { advent: xa.value, adventDone: xa.done, streakOff: s.streakOff, streakDays: [s.streakDays(1), s.streakDays(9001)], open: s.numberOpen, won: s.numberWon(9001), wonOne: s.numberWon(1), lost: s.numberLost };
---
<nav class="strip-sec" aria-label={s.label} data-strip data-texts={JSON.stringify(texts)}>
  <ul class="strip">
    {tiles.map((tl) => (
      <li data-tile={tl.id} data-from={tl.from} data-to={tl.to} hidden={!!(tl.from || tl.to)}>
        <a class="glow tile" data-fest={tl.fest} href={tl.href}>
          <span class:list={['glow-tile', 't-emoji', tl.cls]} aria-hidden="true"><span>{tl.emoji}</span></span>
          <span class="t-text"><span class="t-label">{tl.label}</span><span class="t-value" data-value>{tl.value}</span></span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<script>
  import { streakInfo } from '../../scripts/streak';
  import { stateFor } from '../../scripts/tageszahl';
  import { berlinDay } from '../../week';
  import { adventState } from '../../scripts/advent';
  // Die Leiste kann zweimal auf der Seite stehen (Wochentag- und Feiertags-Kopf), beide füllen
  document.querySelectorAll<HTMLElement>('[data-strip]').forEach((root) => {
    const T = JSON.parse(root.dataset.texts!);
    const md = berlinDay().slice(5);
    root.querySelectorAll<HTMLElement>('[data-tile]').forEach((li) => {
      const { from, to } = li.dataset;
      if (from || to) li.hidden = !((!from || md >= from) && (!to || md <= to));
    });
    const val = (id: string) => root.querySelector<HTMLElement>(`[data-tile="${id}"] [data-value]`);
    const n = streakInfo().current;
    const sv = val('streak');
    if (sv) sv.textContent = n ? (n === 1 ? T.streakDays[0] : `${T.streakDays[1].replace('9001', String(n))}`) : T.streakOff;
    const st = stateFor();
    const nv = val('number');
    if (nv) {
      nv.textContent = !st.done ? T.open : st.won ? (st.guesses.length === 1 ? T.wonOne : T.won.replace('9001', String(st.guesses.length))) : T.lost;
      nv.closest('li')!.toggleAttribute('data-open', !st.done);
    }
    const av = val('advent');
    if (av && !av.closest('li')!.hidden) {
      const day = berlinDay();
      const n = Number(day.slice(8));
      const done = adventState(Number(day.slice(0, 4))).open.includes(n);
      av.textContent = (done ? T.adventDone : T.advent).replace('{n}', String(n));
      av.closest('li')!.toggleAttribute('data-open', !done);
      av.closest('a')!.hash = `t${n}`;
    }
  });
</script>

<style>
  .strip { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr)); gap: var(--space-4); }
  .strip li { display: flex; }
  .strip li[hidden] { display: none; }
  .tile { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--space-4); align-items: center; width: 100%; padding: var(--space-3) var(--space-4); }
  .t-emoji { width: var(--space-10); height: var(--space-10); font-size: var(--fs-xl); }
  .t-text { display: flex; flex-direction: column; min-width: 0; }
  .t-label { font-family: var(--font-display); font-weight: 800; font-size: var(--fs-md); line-height: 1.2; color: var(--fest-a); }
  .t-value { font-size: var(--fs-sm); font-weight: 700; }
  [data-open] .t-value::after { content: ' ●'; color: var(--fest-a); }
  @media (max-width: 520px) {
    .strip { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-2); }
    /* Vier Kacheln (z. B. mit Adventskalender): zwei Reihen à zwei */
    .strip:has(> li:not([hidden]):nth-child(4)) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .tile { grid-template-columns: minmax(0, 1fr); justify-items: start; gap: var(--space-2); padding: var(--space-3); }
    .t-emoji { width: var(--space-9); height: var(--space-9); font-size: var(--fs-lg); }
    .t-label { font-size: var(--fs-sm); }
    .t-value { font-size: var(--fs-xs); }
  }
</style>
