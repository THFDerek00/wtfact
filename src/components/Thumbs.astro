---
// Daumen hoch / Daumen runter auf jeder Faktseite (Wunsch von Eric, 2026-10-08, neu gestaltet 2026-10-09).
// Kompakt in der rechten Spalte über „Noch ein Fakt“ (place="side", mitlaufend). Unter 960px gibt es keine
// rechte Spalte neben dem Text, dort steht derselbe Kasten direkt unter dem WTF?!-Kasten (place="inline").
// Beide zeigen dieselbe Bewertung und bleiben im Gleichschritt; sichtbar ist je nach Breite immer genau einer.
// Gleiche Bewertung wie die Wisch-Karte: Wer hier bewertet, hat auch beim Wischen bewertet und umgekehrt
// (rate() in src/scripts/community.ts). Zählt für Fakt des Tages und die Top 10 der WTF-Charts.
// Wie überall: links „weniger“, rechts „gefällt mir“.
import Icon from './Icon.astro';
import { t } from '../i18n/ui';
import type { Lang } from '../config';
interface Props { lang: Lang; factKey: string; place: 'side' | 'inline' }
const { lang, factKey, place } = Astro.props;
const ui = t(lang).thumbs;
const question = ui.question;
const share = ui.share(9001);
---
<section
  class="thumbs card" data-place={place} data-thumbs={factKey}
  data-thanks={ui.thanks} data-local={ui.local} data-share={share} data-first={ui.first}
>
  <span class="label">{ui.label}</span>
  <h2 class="q">{question}</h2>
  <div class="row" role="group" aria-label={question}>
    <button class="vote vote--meh" type="button" data-verdict="meh" aria-pressed="false">
      <Icon name="thumbs-down" /> <span class="sr-only">{ui.down}</span> <span class="n" data-count="meh">0</span>
    </button>
    <span class="meter" aria-hidden="true"><span class="meter-like"></span></span>
    <button class="vote vote--like" type="button" data-verdict="like" aria-pressed="false">
      <span class="n" data-count="like">0</span> <span class="sr-only">{ui.up}</span> <Icon name="thumbs-up" />
    </button>
  </div>
  <p class="share" data-share-text>{ui.first}</p>
  <p class="status" data-status aria-live="polite"></p>
</section>

<script>
  import { rate, myRating, ratingOf } from '../scripts/community';
  import type { Verdict } from '../week';

  // Ein Zustand pro Fakt, alle Kästen dieses Fakts zeichnen daraus (oben und am Ende).
  type State = { counts: { like: number; meh: number }; shared: boolean; boxes: HTMLElement[] };
  const states = new Map<string, State>();

  function draw(key: string, popped?: Verdict) {
    const s = states.get(key)!;
    const mine = myRating(key);
    // Ohne Server zählt nur die eigene Stimme.
    const c = s.shared ? s.counts : { like: mine === 'like' ? 1 : 0, meh: mine === 'meh' ? 1 : 0 };
    const total = c.like + c.meh;
    for (const box of s.boxes) {
      for (const b of box.querySelectorAll<HTMLButtonElement>('[data-verdict]')) {
        b.setAttribute('aria-pressed', String(b.dataset.verdict === mine));
        if (popped && b.dataset.verdict === popped) {
          b.removeAttribute('data-pop');
          void b.offsetWidth; // Animation neu starten
          b.setAttribute('data-pop', '');
        }
      }
      box.querySelector('[data-count="like"]')!.textContent = String(c.like);
      box.querySelector('[data-count="meh"]')!.textContent = String(c.meh);
      box.style.setProperty('--like', total ? String(c.like / total) : '0.5');
      box.toggleAttribute('data-empty', total === 0);
      box.querySelector('[data-share-text]')!.textContent = total
        ? box.dataset.share!.replace('9001', String(Math.round((c.like / total) * 100)))
        : box.dataset.first!;
    }
  }

  for (const box of document.querySelectorAll<HTMLElement>('[data-thumbs]')) {
    const key = box.dataset.thumbs!;
    if (!states.has(key)) {
      states.set(key, { counts: { like: 0, meh: 0 }, shared: false, boxes: [] });
      ratingOf(key).then((c) => {
        const s = states.get(key)!;
        if (c) [s.counts, s.shared] = [c, true];
        draw(key);
      });
    }
    states.get(key)!.boxes.push(box);

    for (const b of box.querySelectorAll<HTMLButtonElement>('[data-verdict]')) {
      b.addEventListener('click', async () => {
        const s = states.get(key)!;
        const verdict = b.dataset.verdict as Verdict;
        if (myRating(key) === verdict) return;
        const before = myRating(key);
        // Sofort anzeigen, der Server bestätigt danach mit den echten Zahlen.
        if (s.shared) {
          if (before) s.counts[before]--;
          s.counts[verdict]++;
        }
        const pending = rate(key, verdict);
        draw(key, verdict);
        const c = await pending;
        if (c) [s.counts, s.shared] = [c, true];
        draw(key);
        const status = box.querySelector<HTMLElement>('[data-status]')!;
        status.textContent = s.shared ? box.dataset.thanks! : `${box.dataset.thanks} ${box.dataset.local}`;
      });
    }
    draw(key);
  }
</script>

<style>
  .thumbs {
    --like: 0.5;
    position: relative; display: flex; flex-direction: column; gap: var(--space-2);
    padding: var(--space-5) var(--space-4) var(--space-3);
  }
  .thumbs[data-place='inline'] { margin: 0 0 var(--space-8); }
  /* Je Breite genau ein Kasten: rechts neben dem Text oder (ohne rechte Spalte) unter dem WTF?!-Kasten */
  @media (max-width: 960px) { .thumbs[data-place='side'] { display: none; } }
  @media (min-width: 961px) { .thumbs[data-place='inline'] { display: none; } }

  /* Schräges Etikett auf der Kante, wie „WTF?!“ am Aufhänger */
  .label {
    position: absolute; top: calc(-1 * var(--space-3)); left: var(--space-4);
    padding: 0 var(--space-2); border: var(--bw-sm) solid var(--line); border-radius: var(--radius-sm);
    background: var(--lime); color: var(--on-accent);
    font-family: var(--font-display); font-size: var(--fs-xs); font-weight: 800; transform: rotate(2deg);
  }
  .q { margin: 0; font-size: var(--fs-md); }

  .row { display: flex; align-items: center; gap: var(--space-2); }

  /* Daumen-Knöpfe: links pink (weniger), rechts lime (gefällt mir) */
  .vote {
    display: inline-flex; align-items: center; gap: var(--space-1); flex: 0 0 auto;
    padding: var(--space-2) var(--space-3);
    border: var(--bw-sm) solid var(--line); border-radius: var(--radius-sm);
    color: var(--on-accent); box-shadow: var(--shadow-sm); cursor: pointer;
    font-family: var(--font-display); font-size: var(--fs-md); font-weight: 800; line-height: 1;
    transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }
  .vote--meh { background: var(--pink); }
  .vote--like { background: var(--lime); }
  .vote:hover { transform: translate(-2px, -2px) rotate(-3deg); box-shadow: var(--shadow-md); }
  .vote--like:hover { transform: translate(-2px, -2px) rotate(3deg); }
  .vote:active { transform: translate(2px, 2px); box-shadow: var(--shadow-xs); }
  .vote[aria-pressed='true'] { transform: translate(2px, 2px); box-shadow: var(--shadow-xs); }
  .vote[aria-pressed='true'] .n::after { content: ' ✓'; }
  .vote[data-pop] .icon { animation: pop var(--dur-pop) var(--ease-pop); }
  @keyframes pop {
    0% { transform: scale(1) rotate(0deg); }
    50% { transform: scale(1.45) rotate(-14deg); }
    100% { transform: scale(1) rotate(0deg); }
  }
  .n { font-variant-numeric: tabular-nums; min-width: 1ch; text-align: center; }

  /* Stimmungsbalken zwischen den Knöpfen: pink von links = weniger, lime von rechts = gefällt mir */
  .meter {
    position: relative; flex: 1 1 auto; height: var(--space-3); min-width: var(--space-8);
    border: var(--bw-sm) solid var(--line); border-radius: var(--radius-pill);
    background: var(--pink); overflow: hidden;
  }
  .meter-like {
    position: absolute; inset: 0 0 0 auto; width: calc(var(--like) * 100%);
    background: var(--lime); border-left: var(--bw-sm) solid var(--line);
    transition: width var(--dur) var(--ease);
  }
  [data-empty] .meter { background: var(--locked); }
  [data-empty] .meter-like { width: 0; border-left: 0; }

  .share { margin: 0; font-family: var(--font-display); font-size: var(--fs-xs); font-weight: 700; color: var(--muted); font-variant-numeric: tabular-nums; }
  .status { margin: 0; font-size: var(--fs-xs); color: var(--muted); }
  .status:empty { display: none; }
</style>
