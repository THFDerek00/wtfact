---
// „Seit du hier bist …“ (Wunsch von Eric, 2026-10-09): zählt live hoch, was auf der Welt passiert, während
// jemand auf der Seite ist. Werte und Quellen stehen in ui.live.note und unten in RATES.
import type { Lang } from '../config';
import { t } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const l = t(lang).live;
// pro Sekunde: Erde um die Sonne in km (NASA ~29,78), Blitze weltweit (NASA OTD ~44), Licht in Erdumrundungen (299792 / 40075)
const RATES = [
  { key: 'earth', rate: 29.78, digits: 0, cls: 'cat-space' },
  { key: 'lightning', rate: 44, digits: 0, cls: 'cat-weird' },
  { key: 'light', rate: 299792 / 40075, digits: 0, cls: 'cat-science' },
] as const;
---
<section class="card live" data-live data-locale={lang === 'de' ? 'de-DE' : 'en-US'}>
  <h2>{l.title}</h2>
  <ul>
    {RATES.map((r) => (
      <li>
        <span class:list={['num', r.cls]} data-rate={r.rate} data-digits={r.digits}>0</span>
        <span class="what">{l[r.key]}</span>
      </li>
    ))}
  </ul>
  <p class="note">{l.note}</p>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-live]').forEach((box) => {
    const fmt = new Intl.NumberFormat(box.dataset.locale);
    const nums = [...box.querySelectorAll<HTMLElement>('[data-rate]')];
    const start = performance.now();
    const tick = () => {
      const s = (performance.now() - start) / 1000;
      for (const n of nums) n.textContent = fmt.format(Math.floor(Number(n.dataset.rate) * s));
    };
    tick();
    setInterval(tick, 100);
  });
</script>

<style>
  .live { padding: var(--space-5) var(--space-5) var(--space-4); box-shadow: var(--shadow-md); color: var(--ink); }
  h2 { margin: 0 0 var(--space-4); font-size: var(--fs-xl); }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-3); }
  li { display: grid; grid-template-columns: minmax(7ch, auto) 1fr; align-items: center; gap: var(--space-3); }
  .num {
    padding: var(--space-1) var(--space-3); border: var(--bw-sm) solid var(--line); border-radius: var(--radius-sm);
    font-family: var(--font-display); font-size: var(--fs-xl); font-weight: 700; text-align: right;
    font-variant-numeric: tabular-nums; --dots-size: var(--dots-size-sm);
  }
  .what { font-size: var(--fs-md); line-height: 1.3; }
  .note { margin: var(--space-4) 0 0; font-size: var(--fs-xs); color: var(--muted); }
</style>
