---
// Schneehaube auf einer Karte (Look A): sitzt oben links auf dem Element, das position: relative hat.
---
<span class="x-cap xmas" aria-hidden="true">
  <svg viewBox="0 0 400 26" preserveAspectRatio="none">
    <path d="M0 22 C 10 6 30 4 50 10 C 70 2 96 2 120 10 C 140 4 168 0 190 12 C 214 4 240 6 262 14 C 290 4 320 6 340 14 C 360 8 384 8 400 20 L 400 26 L 0 26Z" />
  </svg>
</span>

<style>
  .x-cap { position: absolute; left: calc(-1 * var(--space-2)); right: 30%; top: calc(-1 * var(--space-4)); height: var(--xmas-cap-h); pointer-events: none; z-index: 3; }
  svg { display: block; width: 100%; height: 100%; }
  path { fill: var(--xmas-snow); stroke: var(--xmas-ink); stroke-width: 3; vector-effect: non-scaling-stroke; }
</style>
