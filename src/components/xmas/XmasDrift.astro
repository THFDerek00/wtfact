---
// Schneewehe auf der schrägen Kante über dem Fuß (Look A). Nur in der Weihnachtszeit sichtbar.
---
<div class="x-drift xmas" aria-hidden="true">
  <svg viewBox="0 0 1400 46" preserveAspectRatio="none">
    <path d="M0 30 C 80 6 160 8 240 22 C 330 4 420 6 520 24 C 600 10 700 2 800 20 C 900 6 1000 10 1080 26 C 1160 8 1260 6 1400 22 L1400 46 L0 46Z" />
  </svg>
</div>

<style>
  .x-drift { position: absolute; left: 0; right: 0; top: calc(-1 * var(--edge) - var(--space-1)); height: var(--xmas-drift-h); z-index: 3; pointer-events: none; }
  svg { display: block; width: 100%; height: 100%; }
  path { fill: var(--xmas-snow); stroke: var(--xmas-ink); stroke-width: 3; vector-effect: non-scaling-stroke; }
</style>
