---
// Lichterkette unter dem Kopf in der Weihnachtszeit (Look A, Wunsch von Eric, 2026-10-21). Nur sichtbar mit
// data-season='xmas' auf <html> (Klasse .xmas). Breite Bildschirme sehen mehr Birnen, die Grafik wird rechts abgeschnitten.
const W = 2600, SEG = 46;
const n = Math.floor(W / SEG);
let wire = 'M0 4';
for (let i = 0; i < n; i++) wire += ` Q${i * SEG + SEG / 2} 22 ${(i + 1) * SEG} 4`;
const bulbs = Array.from({ length: n }, (_, i) => ({ x: i * SEG + SEG / 2, r: i % 2 ? 8 : -8, c: (i % 4) + 1, d: (i * 7) % 5 }));
---
<div class="x-lights xmas" aria-hidden="true">
  <svg viewBox={`0 0 ${W} 40`} preserveAspectRatio="xMinYMin slice">
    <defs>
      <symbol id="x-bulb" viewBox="-17 -17 34 50" overflow="visible">
        <circle class="glow" r="16" />
        <rect class="cap" x="-4" y="-2" width="8" height="6" rx="1" />
        <path class="glass" d="M0 3 C 9 8 8 24 0 28 C -8 24 -9 8 0 3Z" />
        <path class="shine" d="M-2.5 9 C -4 13 -4 17 -3 20" />
      </symbol>
    </defs>
    <path class="wire" d={wire} />
    {bulbs.map((b) => <use href="#x-bulb" x={b.x - 17} y="-4" width="34" height="50" class={`b b${b.c} t${b.d}`} transform={`rotate(${b.r} ${b.x} 13)`} />)}
  </svg>
</div>

<style>
  .x-lights { position: absolute; left: 0; right: 0; top: 100%; height: var(--xmas-lights-h); pointer-events: none; z-index: 1; overflow: hidden; }
  svg { display: block; width: 100%; height: 100%; overflow: visible; }
  .wire { fill: none; stroke: var(--xmas-wire); stroke-width: 2.5; }
  .b1 { color: var(--xmas-bulb-1); }
  .b2 { color: var(--xmas-bulb-2); }
  .b3 { color: var(--xmas-bulb-3); }
  .b4 { color: var(--xmas-bulb-4); }
  symbol .glow { fill: currentColor; opacity: 0.28; animation: x-twinkle var(--dur-twinkle-xmas) var(--ease) infinite; }
  symbol .cap { fill: var(--xmas-ink); }
  symbol .glass { fill: currentColor; stroke: var(--xmas-ink); stroke-width: 2.2; }
  symbol .shine { fill: none; stroke: var(--xmas-snow); stroke-width: 2; opacity: 0.6; stroke-linecap: round; }
  .t1 { animation-delay: calc(var(--dur-twinkle-xmas) / -5); }
  .t2 { animation-delay: calc(var(--dur-twinkle-xmas) / -2.5); }
  .t3 { animation-delay: calc(var(--dur-twinkle-xmas) / -1.6); }
  .t4 { animation-delay: calc(var(--dur-twinkle-xmas) / -1.2); }
  @keyframes x-twinkle { 50% { opacity: 0.6; } }
</style>
