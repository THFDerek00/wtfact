---
// Kompakter Hinweis auf der Startseite: Fakt des Tages und Fakt der Woche in je einer Zeile,
// alles Weitere (Abstimmung, Verlauf, Tippspiel) steht auf der eigenen Seite /[lang]/hall-of-fame/.
// Welche Fakten gerade vorne sind, rechnet src/scripts/fame.ts im Browser aus.
import { FACTS_PER_DAY, type Lang } from '../config';
import { factInfo, type Post } from '../lib';
import { t } from '../i18n/ui';
import Icon from './Icon.astro';
interface Props { lang: Lang; posts: Post[] }
const { lang, posts } = Astro.props;
const ui = t(lang);
const f = ui.fame;
// Ein Fakt der Woche ist höchstens 15 Tage alt, der Fakt des Tages einen Tag.
const facts = posts.slice(0, 17 * FACTS_PER_DAY).map(factInfo);
const href = `/${lang}/hall-of-fame/`;
---
<section class="wrap pointer-wrap" aria-label={f.pointerLabel} data-fame-pointer data-facts={JSON.stringify(facts)}>
  <a class="card pointer" href={href}>
    <span class="pointer-head"><Icon name="trophy" /> {f.name}</span>
    <span class="minis">
      <span class="mini" data-mini="daily" hidden>
        <span class="mini-emoji" data-emoji aria-hidden="true"></span>
        <span class="mini-text">
          <span class="mini-label">{ui.daily.badge}</span>
          <span class="mini-title" data-title></span>
        </span>
      </span>
      <span class="mini" data-mini="week" hidden>
        <span class="mini-emoji" data-emoji aria-hidden="true"></span>
        <span class="mini-text">
          <span class="mini-label">{ui.weekly.badge}</span>
          <span class="mini-title" data-title></span>
        </span>
      </span>
      <span class="mini-empty" data-mini-empty>{f.intro}</span>
    </span>
    <span class="pointer-cta">{f.cta} <Icon name="chevron-right" /></span>
  </a>
  <a class="chip accent vote-chip" href={`${href}#vote`} data-pointer-vote hidden><Icon name="vote" /> {f.pointerVote}</a>
</section>

<script>
  import { current } from '../scripts/fame';
  import type { FactInfo } from '../lib';

  async function init() {
    const root = document.querySelector<HTMLElement>('[data-fame-pointer]');
    if (!root) return;
    const facts: FactInfo[] = JSON.parse(root.dataset.facts ?? '[]');
    const { state, daily, featured } = await current(facts);
    let shown = 0;
    const show = (name: string, key?: string) => {
      const fact = key && facts.find((x) => x.key === key);
      const el = root.querySelector<HTMLElement>(`[data-mini="${name}"]`)!;
      if (!fact) return;
      el.querySelector<HTMLElement>('[data-emoji]')!.textContent = fact.emoji;
      el.querySelector<HTMLElement>('[data-emoji]')!.classList.add(`cat-${fact.cat}`);
      el.querySelector<HTMLElement>('[data-title]')!.textContent = fact.title;
      el.hidden = false;
      shown++;
    };
    show('daily', daily?.key);
    show('week', featured?.key);
    root.querySelector<HTMLElement>('[data-mini-empty]')!.hidden = shown > 0;
    root.querySelector<HTMLElement>('[data-pointer-vote]')!.hidden = !state.openPoll;
  }
  init();
</script>

<style>
  .pointer-wrap { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); margin-top: var(--space-11); }
  .pointer {
    flex: 1 1 100%; min-width: 0; display: flex; align-items: center; gap: var(--space-5); padding: var(--space-3) var(--space-5);
    text-decoration: none; transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }
  .pointer:hover { transform: translate(-2px, -2px); box-shadow: var(--shadow-lg); }
  .pointer-head, .pointer-cta { display: inline-flex; align-items: center; gap: var(--space-2); }
  .pointer-head { flex: 0 0 auto; font-family: var(--font-display); font-size: var(--fs-lg); font-weight: 800; white-space: nowrap; }
  .minis { flex: 1; min-width: 0; display: flex; gap: var(--space-5); }
  .mini { flex: 1 1 0; min-width: 0; display: flex; align-items: center; gap: var(--space-3); }
  .mini[hidden], .mini-empty[hidden] { display: none; }
  .mini-emoji {
    flex: 0 0 auto; display: grid; place-items: center; width: var(--space-10); aspect-ratio: 1;
    border: var(--bw-sm) solid var(--line); border-radius: var(--radius-sm); font-size: var(--fs-xl); --dots-size: var(--dots-size-sm);
  }
  .mini-text { min-width: 0; display: flex; flex-direction: column; }
  .mini-label { font-size: var(--fs-xs); font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.04em; }
  .mini-title { font-family: var(--font-display); font-weight: 700; line-height: 1.2; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .mini-empty { color: var(--muted); font-size: var(--fs-sm); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pointer-cta { flex: 0 0 auto; font-family: var(--font-display); font-size: var(--fs-sm); font-weight: 700; color: var(--pink-text); white-space: nowrap; }
  .vote-chip { text-decoration: none; }

  @media (max-width: 760px) {
    .pointer { flex-wrap: wrap; gap: var(--space-3); padding: var(--space-4); }
    .minis { flex: 1 1 100%; order: 3; flex-direction: column; gap: var(--space-3); }
    .pointer-head { flex: 1; }
  }
</style>
