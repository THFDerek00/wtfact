---
// Werbe-Karte im Raster „Neueste Fakten“ auf der Startseite (Wunsch von Eric, 2026-10-09), klar als Werbung gekennzeichnet.
// Das Produkt gehört immer zum neuesten veröffentlichten Fakt: Die Startseite wird bei jeder Veröffentlichung neu
// gebaut, wer die Reihenfolge im Dashboard ändert, bekommt also automatisch das passende Produkt.
// Design „Schaufenster“ (Wunsch von Eric, 2026-10-20, Entwurf B): dunkle Bühne in der Farbwelt der Kategorie wie die
// Faktenkarten, links das Produkt groß mit Leuchten und Deko, rechts ein weißer Kasten mit „Werbung“-Sticker und Knopf.
import type { Lang, Category } from '../config';
import { amazonUrl } from '../lib';
import { t } from '../i18n/ui';
import { festOf } from '../data/holidays';
import Icon from './Icon.astro';
import FestDeco from './FestDeco.astro';
import { productArt } from '../product-art';
interface Props {
  lang: Lang;
  product: { name: string; query: string; why: string };
  category: Category;
  factKey: string;
  factTitle: string;
}
const { lang, product, category, factKey, factTitle } = Astro.props;
const ui = t(lang);
const art = productArt(product.name);
const fest = festOf(category, '');
const deco = ['gift', 'sparkle', ...(fest?.deco ?? []).slice(0, 2)];
---
<a
  class="pickcard fest-sky" data-fest={fest?.theme} href={amazonUrl(lang, product.query)} rel="sponsored nofollow noopener" target="_blank"
  data-umami-event="amazon" data-umami-event-fact={factKey} data-umami-event-place="home"
>
  <span class="stage" aria-hidden="true">
    <FestDeco deco={deco} />
    <span class="big">{art.main}</span>
    {art.topic && <span class="topic">{art.topic}</span>}
  </span>
  <span class="panel">
    <span class="sticker">{ui.adLabel}</span>
    <span class="for">{ui.teaserHome}: {factTitle}</span>
    <span class="name">{product.name}</span>
    <span class="why">{product.why}</span>
    <span class="cta btn btn--orange">{ui.productsCta} <Icon name="external-link" /></span>
  </span>
  <span class="sr-only">({ui.adLabel})</span>
</a>

<style>
  .pickcard {
    position: relative; display: flex; min-height: 16rem; overflow: hidden; text-decoration: none;
    border: var(--bw-strong) solid var(--fest-a); border-radius: var(--radius-lg); box-shadow: var(--shadow-lg);
    transition: transform var(--dur) var(--ease-pop), box-shadow var(--dur) var(--ease);
  }
  .pickcard:hover { transform: translate(-3px, -4px) rotate(-0.6deg); box-shadow: var(--shadow-2xl); }
  .stage { position: relative; flex: 0 0 42%; display: grid; place-items: center; }
  .stage::before {
    content: ''; position: absolute; width: 70%; aspect-ratio: 1; border-radius: 50%;
    background: radial-gradient(circle closest-side, color-mix(in srgb, var(--fest-a) 55%, transparent), transparent);
  }
  .big { position: relative; font-size: var(--fs-emoji-2xl); line-height: 1; transform: rotate(-8deg); filter: var(--emoji-shadow); transition: transform var(--dur) var(--ease-pop); }
  .pickcard:hover .big { transform: rotate(6deg) scale(1.08); }
  .topic {
    position: absolute; right: 14%; top: 14%; display: grid; place-items: center; width: var(--space-11); aspect-ratio: 1;
    border: var(--bw-sm) solid var(--on-accent); border-radius: 50%; background: var(--surface);
    font-size: var(--fs-2xl); line-height: 1; transform: rotate(8deg);
  }
  .panel {
    position: relative; flex: 1; display: flex; flex-direction: column; gap: var(--space-2);
    margin: var(--space-6) var(--space-6) var(--space-6) 0; padding: var(--space-6) var(--space-6) var(--space-5);
    background: var(--surface); color: var(--ink); border: var(--bw-strong) solid var(--on-accent); border-radius: var(--radius-md);
    box-shadow: var(--shadow-on-night);
  }
  .sticker {
    position: absolute; top: calc(-1 * var(--space-4)); left: var(--space-5); padding: var(--space-1) var(--space-3);
    background: var(--fest-a); color: var(--on-accent); border: var(--bw-sm) solid var(--on-accent); border-radius: var(--radius-sm);
    font-family: var(--font-display); font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; transform: rotate(-3deg);
  }
  .for { font-size: var(--fs-xs); font-weight: 600; color: var(--muted); }
  .name { font-family: var(--font-display); font-size: var(--fs-2xl); font-weight: 800; line-height: 1.1; }
  .why { color: var(--muted); font-size: var(--fs-md); }
  .cta { align-self: flex-start; margin-top: auto; }
  @media (max-width: 560px) {
    .pickcard { flex-direction: column; }
    .stage { flex-basis: 10rem; }
    .big { font-size: var(--fs-emoji-lg); }
    .panel { margin: var(--space-4); padding: var(--space-6) var(--space-4) var(--space-4); }
    .name { font-size: var(--fs-xl); }
    .why { font-size: var(--fs-sm); }
    .cta { align-self: stretch; justify-content: center; }
  }
</style>
