---
import type { Lang } from '../config';
import { amazonUrl } from '../lib';
import { t } from '../i18n/ui';
interface Props { lang: Lang; products: { name: string; query: string; why: string }[] }
const { lang, products } = Astro.props;
const ui = t(lang);
---
{products.length > 0 && (
  <aside class="card box">
    <h2>🛒 {ui.productsTitle} <span class="tag">{ui.adLabel}</span></h2>
    <p class="ad">{ui.affiliateShort}</p>
    <ul>
      {products.map((p) => (
        <li>
          <div>
            <strong>{p.name}</strong>
            <p>{p.why}</p>
          </div>
          <a class="btn" href={amazonUrl(lang, p.query)} rel="sponsored nofollow noopener" target="_blank">{ui.productsCta}</a>
        </li>
      ))}
    </ul>
  </aside>
)}

<style>
  .box { padding: 22px; margin: 36px 0; background: var(--surface); }
  h2 { margin: 0 0 6px; font-size: 22px; }
  .tag { font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); border: 1px solid var(--line); border-radius: 6px; padding: 2px 6px; vertical-align: middle; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  li { display: flex; gap: 16px; align-items: center; justify-content: space-between; padding: 14px; border: 2px dashed var(--line); border-radius: 10px; }
  li p { margin: 2px 0 0; font-size: 14px; color: var(--muted); }
  .btn { flex-shrink: 0; background: var(--orange); }
  .ad { margin: 0 0 14px; font-size: 12px; color: var(--muted); }
  @media (max-width: 560px) { li { flex-direction: column; align-items: stretch; } }
</style>
