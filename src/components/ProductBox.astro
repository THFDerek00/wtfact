---
// Amazon-Partnerlinks unter dem Fakt (neu gestaltet auf Wunsch von Eric, 2026-10-09): Produkte als eigene,
// ganz anklickbare Kacheln mit Bildfläche in der Kategoriefarbe des Fakts, damit sie neugierig machen.
// Das Emoji auf der Bildfläche passt zum Artikel (src/product-art.ts), bei Büchern 📚 mit dem Thema daneben.
// Klar als Werbung gekennzeichnet (Etikett oben rechts und Hinweis unten), wie es Amazon PartnerNet und
// das deutsche Recht verlangen. Links tragen rel="sponsored".
import type { Lang, Category } from '../config';
import { amazonUrl } from '../lib';
import { t } from '../i18n/ui';
import { SITE } from '../config';
import Icon from './Icon.astro';
import { productArt } from '../product-art';
interface Props { lang: Lang; products: { name: string; query: string; why: string }[]; category: Category; factKey: string }
const { lang, products, category, factKey } = Astro.props;
const ui = t(lang);
const host = SITE.amazon[lang].host.replace(/^www\./, '');
---
{products.length > 0 && (
  <aside class="card shop" id="passend" aria-labelledby="shop-title">
    <div class="head">
      <h2 id="shop-title"><Icon name="shopping-cart" /> {ui.productsTitle}</h2>
      <span class="ad-tag">{ui.adLabel}</span>
    </div>
    <p class="intro">{ui.productsIntro}</p>
    <ul class="grid" data-count={products.length}>
      {products.map((p) => { const art = productArt(p.name); return (
        <li>
          <a class="prod" href={amazonUrl(lang, p.query)} rel="sponsored nofollow noopener" target="_blank"
            data-umami-event="amazon" data-umami-event-fact={factKey} data-umami-event-place="box">
            <span class:list={['art', `cat-${category}`]} aria-hidden="true">
              <span class="emoji">{art.main}</span>
              {art.topic && <span class="topic">{art.topic}</span>}
              <span class="host">{host}</span>
            </span>
            <span class="body">
              <strong class="name">{p.name}</strong>
              <span class="why">{p.why}</span>
              <span class="btn btn--orange cta">{ui.productsCta} <Icon name="external-link" /></span>
            </span>
          </a>
        </li>
      ); })}
    </ul>
    <p class="ad">{ui.affiliateShort}</p>
  </aside>
)}

<style>
  .shop { position: relative; padding: var(--space-6); margin: var(--space-9) 0; box-shadow: var(--shadow-lg); scroll-margin-top: var(--space-12); }
  /* Kennzeichnung bleibt groß und kontraststark, nicht versteckt */
  .head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-2) var(--space-4); }
  .ad-tag {
    padding: 0 var(--space-2); border: var(--bw-sm) solid var(--line); border-radius: var(--radius-sm);
    background: var(--night); color: var(--on-night);
    font-family: var(--font-display); font-size: var(--fs-sm); font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em;
    transform: rotate(2deg);
  }
  h2 { display: flex; align-items: center; gap: var(--space-2); margin: 0; font-size: var(--fs-2xl); }
  .intro { margin: var(--space-1) 0 var(--space-5); font-size: var(--fs-md); color: var(--muted); }

  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: var(--space-5); }
  .grid[data-count='1'] { grid-template-columns: minmax(0, 1fr); }
  .grid li { display: flex; }

  /* Ganze Kachel ist der Link: Bildfläche in Kategoriefarbe, Name, warum es passt, Knopf */
  .prod {
    display: flex; flex-direction: column; width: 100%; overflow: hidden; text-decoration: none; color: var(--ink);
    background: var(--surface); border: var(--bw) solid var(--line); border-radius: var(--radius-md); box-shadow: var(--shadow-md);
    transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }
  .grid[data-count='1'] .prod { flex-direction: row; }
  .prod:hover { transform: translate(-3px, -3px) rotate(-0.5deg); box-shadow: var(--shadow-xl); }
  .prod:active { transform: translate(2px, 2px); box-shadow: var(--shadow-xs); }
  .art {
    position: relative; display: grid; place-items: center; min-height: 120px;
    border-bottom: var(--bw) solid var(--line);
  }
  .grid[data-count='1'] .art { flex: 0 0 160px; border-bottom: 0; border-right: var(--bw) solid var(--line); }
  .emoji { font-size: var(--fs-emoji-md); line-height: 1; transform: rotate(-8deg); filter: var(--emoji-shadow); transition: transform var(--dur) var(--ease-pop); }
  .prod:hover .emoji { transform: rotate(8deg) scale(1.15); }
  /* Thema eines Buchs oder Films als runder Aufkleber oben rechts */
  .topic {
    position: absolute; right: var(--space-3); top: var(--space-3);
    display: grid; place-items: center; width: var(--space-11); aspect-ratio: 1;
    border: var(--bw-sm) solid var(--line); border-radius: 50%; background: var(--surface);
    font-size: var(--fs-2xl); line-height: 1; box-shadow: var(--shadow-xs); transform: rotate(8deg);
  }
  .host {
    position: absolute; left: var(--space-3); bottom: var(--space-3);
    padding: 0 var(--space-2); border-radius: var(--radius-sm); background: var(--night); color: var(--on-night);
    font-family: var(--font-display); font-size: var(--fs-xs); font-weight: 700;
  }
  .body { display: flex; flex-direction: column; gap: var(--space-2); flex: 1; padding: var(--space-4) var(--space-5) var(--space-5); }
  .name { font-family: var(--font-display); font-size: var(--fs-xl); line-height: 1.15; letter-spacing: -0.01em; }
  .why { font-size: var(--fs-md); color: var(--muted); }
  .cta { align-self: flex-start; margin-top: auto; }
  .prod:hover .cta { box-shadow: var(--shadow-lg); transform: translate(-2px, -2px); }

  .ad { margin: var(--space-5) 0 0; font-size: var(--fs-xs); color: var(--muted); }

  @media (max-width: 560px) {
    .grid[data-count='1'] .prod { flex-direction: column; }
    .grid[data-count='1'] .art { flex-basis: auto; border-right: 0; border-bottom: var(--bw) solid var(--line); }
    .cta { align-self: stretch; }
  }
</style>
