---
// Kürbis-Leiste auf der Startseite (Wunsch von Eric, 2026-10-21, Look A „Kürbislicht“): steht in der Gruselwoche direkt
// unter dem Kopf. Links Text, die 13 Plätze (gefunden = Bonbon, versteckt = ?, kommt noch = gestrichelt, 13 = gold) und
// der Hinweis des Tages, rechts das Bonbonglas. Den Stand setzt der Browser (src/scripts/halloween.ts).
import type { Lang } from '../../config';
import FestIcon from '../FestIcon.astro';
import FestDeco from '../FestDeco.astro';
import Pumpkin from './Pumpkin.astro';
import { ht } from '../../i18n/halloween';
import { PUMPKIN_TOTAL, GOLD_NO } from '../../data/halloween';
interface Props { lang: Lang }
const { lang } = Astro.props;
const h = ht(lang);
const s = h.strip;
const slots = Array.from({ length: PUMPKIN_TOTAL }, (_, i) => i + 1);
// Bonbons im Glas: von unten nach oben, abwechselnd in vier Farben
const candies = slots.map((k, i) => ({ k, x: 30 + ((i * 37) % 120), y: 236 - Math.floor(i / 4) * 30 - (i % 2) * 8, r: ((i * 47) % 70) - 35, c: (i % 4) + 1 }));
---
<section class="sec fest-sky h-strip halloween" id="kuerbisse" data-fest="halloween" data-edge>
  <FestDeco deco={['bat', 'candy', 'web', 'black-cat']} size="lg" />
  <div class="wrap">
    <div class="txt">
      <span class="chip kick">🎃 {s.kicker}</span>
      <h2>{s.title}</h2>
      <p>{s.text}</p>
      <ol class="slots" aria-label={h.name}>
        {slots.map((k) => (
          <li data-h-slot={k} class:list={[k === GOLD_NO && 'slot-gold']}>
            <span class="n">{k}</span>
            <span class="ic"><FestIcon name="candy" /></span>
            <span class="sr-only" data-label-found>{s.found}</span>
          </li>
        ))}
      </ol>
      <p class="hint" data-h-hint={JSON.stringify(h.hints)} data-h-today={s.hint} data-h-old={s.hintOld} data-h-all={s.allFound} data-h-no={s.no} aria-live="polite">
        <span aria-hidden="true">🔦</span> <b data-h-hint-label>{s.hint}</b> <span data-h-hint-text></span>
      </p>
      <p class="legend"><span class="lg found"></span>{s.found} <span class="lg open"></span>{s.open} <span class="lg later"></span>{s.later} <span class="lg lg-gold"></span>{s.gold}</p>
    </div>
    <div class="jar-box">
      <svg class="jar" viewBox="0 0 200 290" role="img" aria-label={s.jar}>
        <ellipse class="shadow" cx="100" cy="282" rx="80" ry="8" />
        <path class="glass" d="M44 50 h112 v16 c16 12 22 36 22 82 v96 c0 20 -12 32 -32 32 h-92 c-20 0 -32 -12 -32 -32 v-96 c0 -46 6 -70 22 -82z" />
        {candies.map((c) => (
          <g class={`candy c${c.c}`} data-h-candy={c.k} hidden transform={`translate(${c.x} ${c.y}) rotate(${c.r} 20 0)`}>
            <path class="wrap-l" d="M2 0 l-10 -7 v14z M38 0 l10 -7 v14z" />
            <ellipse cx="20" cy="0" rx="18" ry="11" />
            <path class="stripe" d="M12 -8 l5 15 M22 -10 l5 17" />
          </g>
        ))}
        <rect class="lid" x="36" y="30" width="128" height="24" rx="8" />
        <text class="count" x="100" y="112" text-anchor="middle"><tspan data-h-count>0</tspan>/{PUMPKIN_TOTAL}</text>
      </svg>
      <span class="peek"><Pumpkin /></span>
    </div>
  </div>
</section>

<script>
  import { applySpooky } from '../../scripts/halloween';
  applySpooky();
  addEventListener('wtfact-pumpkins', () => applySpooky());
</script>

<style>
  .h-strip { padding-block: var(--space-10) calc(var(--space-12) + var(--bleed)); overflow-x: clip; }
  .h-strip > .wrap { position: relative; z-index: 2; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-10); align-items: center; }
  h2 { margin: var(--space-3) 0 var(--space-2); font-size: var(--fs-display-md); color: var(--on-night); }
  p { margin: 0 0 var(--space-4); color: var(--on-night-muted); max-width: 52ch; }
  .kick { background: var(--fest-a); color: var(--on-accent); border-color: var(--on-accent); }
  .slots { list-style: none; margin: 0 0 var(--space-4); padding: 0; display: grid; grid-template-columns: repeat(13, minmax(0, 1fr)); gap: var(--space-2); max-width: 42rem; }
  .slots li {
    position: relative; display: grid; place-items: center; aspect-ratio: 1; border-radius: var(--radius-sm);
    border: var(--bw-sm) dashed var(--on-night-faint); color: var(--on-night-faint); font-family: var(--font-display); font-weight: 700; font-size: var(--fs-sm);
  }
  .slots .ic { display: none; font-size: var(--fs-md); }
  .slots .ic :global(.fi) { filter: none; }
  .slots [data-label-found] { display: none; }
  .slots [data-state='open'] { border-style: solid; border-color: var(--on-night); color: var(--on-night); }
  .slots [data-state='found'] { background: var(--fest-a); border: var(--bw-sm) solid var(--on-accent); box-shadow: var(--shadow-night-sm); }
  .slots [data-state='found'] .n { display: none; }
  .slots [data-state='found'] [data-label-found] { display: block; }
  /* Bonbon mittig im Feld: als Raster statt Inline, sonst sitzt es auf der Textzeile oben links */
  .slots [data-state='found'] .ic { display: grid; place-items: center; inset: 0; position: absolute; font-size: var(--fs-xl); line-height: 0; }
  .slots .ic :global(.fi) { display: block; }
  .slots .slot-gold { border-color: var(--hw-gold); color: var(--hw-gold); }
  .slots .slot-gold[data-state='found'] { background: var(--hw-gold); }
  .hint {
    max-width: 42rem; padding: var(--space-3) var(--space-4); border: var(--bw-sm) solid var(--on-night-faint); border-radius: var(--radius-md);
    background: var(--hw-glass); color: var(--on-night);
  }
  .hint b { color: var(--fest-a); }
  .legend { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); font-size: var(--fs-xs); margin: 0; }
  .lg { display: inline-block; width: var(--space-3); height: var(--space-3); border-radius: var(--radius-sm); border: var(--bw-sm) dashed var(--on-night-faint); margin-left: var(--space-2); }
  .lg.found { background: var(--fest-a); border-style: solid; border-color: var(--on-accent); }
  .lg.open { border-style: solid; border-color: var(--on-night); }
  .lg.lg-gold { border-style: solid; border-color: var(--hw-gold); }
  .jar-box { position: relative; width: var(--hw-jar-w); }
  .jar { display: block; width: 100%; height: auto; overflow: visible; }
  .jar .shadow { fill: var(--hw-ink); opacity: 0.4; }
  .jar .glass { fill: var(--hw-glass); stroke: var(--on-night); stroke-width: 5; }
  .jar .lid { fill: var(--fest-b); stroke: var(--hw-ink); stroke-width: 4; }
  .jar .count { font-family: var(--font-headline); font-size: var(--fs-display-sm); fill: var(--on-night); }
  .candy ellipse, .candy .wrap-l { stroke: var(--hw-ink); stroke-width: 3; stroke-linejoin: round; }
  .candy .stripe { fill: none; stroke: var(--surface); stroke-width: 3; opacity: 0.7; }
  .c1 :is(ellipse, .wrap-l) { fill: var(--hw-candy-1); }
  .c2 :is(ellipse, .wrap-l) { fill: var(--hw-candy-2); }
  .c3 :is(ellipse, .wrap-l) { fill: var(--hw-candy-3); }
  .c4 :is(ellipse, .wrap-l) { fill: var(--hw-candy-4); }
  [data-h-candy][hidden] { display: none; }
  .peek { position: absolute; left: calc(-1 * var(--space-6)); bottom: calc(-1 * var(--space-2)); width: var(--hw-hidden); rotate: -12deg; }
  @media (max-width: 760px) {
    .h-strip > .wrap { grid-template-columns: minmax(0, 1fr); gap: var(--space-8); }
    .jar-box { width: var(--hw-jar-w-sm); margin-inline: auto; }
    .slots { grid-template-columns: repeat(7, minmax(0, 1fr)); }
  }
</style>
