---
// Fakten-Roulette (Wunsch von Eric, 2026-10-09): ein zufälliger Fakt, „Nochmal drehen“ lässt die Titel kurz
// durchrattern wie bei einem Spielautomaten und bleibt auf einem neuen stehen. Darunter: wie viele Fakten und
// geprüfte Quellen es schon gibt (passt zum Versprechen „Und ja, das stimmt wirklich.“).
import type { Lang } from '../config';
import { t } from '../i18n/ui';
import { postsFor, postUrl } from '../lib';
import Icon from './Icon.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
const posts = await postsFor(lang);
const items = posts.map((p) => ({ t: p.data.title, e: p.data.emoji, c: p.data.category, u: postUrl(p) }));
const sources = posts.reduce((n, p) => n + p.data.sources.length, 0);
const first = items[0];
---
{first && (
  <section class="card roulette" data-roulette={JSON.stringify(items)}>
    <h2><Icon name="dices" /> {ui.roulette.title}</h2>
    <a class="slot" href={first.u} data-slot>
      <span class:list={['emoji', `cat-${first.c}`]} data-emoji aria-hidden="true">{first.e}</span>
      <span class="title" data-title aria-live="polite">{first.t}</span>
    </a>
    <div class="row">
      <button class="btn btn--pink" type="button" data-spin><Icon name="dices" /> {ui.roulette.spin}</button>
      <a class="read" href={first.u} data-read>{ui.roulette.read} <Icon name="chevron-right" /></a>
    </div>
    <p class="stats">{ui.roulette.stats(items.length, sources)}</p>
  </section>
)}

<script>
  type Item = { t: string; e: string; c: string; u: string };
  document.querySelectorAll<HTMLElement>('[data-roulette]').forEach((box) => {
    const items: Item[] = JSON.parse(box.dataset.roulette ?? '[]');
    const slot = box.querySelector<HTMLAnchorElement>('[data-slot]')!;
    const read = box.querySelector<HTMLAnchorElement>('[data-read]')!;
    const emoji = box.querySelector<HTMLElement>('[data-emoji]')!;
    const title = box.querySelector<HTMLElement>('[data-title]')!;
    const btn = box.querySelector<HTMLButtonElement>('[data-spin]')!;
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    const show = (i: number) => {
      const it = items[i];
      emoji.className = `emoji cat-${it.c}`;
      emoji.textContent = it.e;
      title.textContent = it.t;
      slot.href = read.href = it.u;
    };
    const pick = () => { let i = current; while (items.length > 1 && i === current) i = Math.floor(Math.random() * items.length); return i; };
    // Startet beim Laden schon auf einem zufälligen Fakt, nicht immer auf dem neuesten
    current = pick(); show(current);
    btn.addEventListener('click', () => {
      const target = pick();
      if (calm) { current = target; show(current); return; }
      btn.disabled = true;
      box.classList.add('spinning');
      let step = 0;
      const steps = 12;
      const roll = () => {
        if (step++ < steps) { show(Math.floor(Math.random() * items.length)); setTimeout(roll, 40 + step * 12); return; }
        current = target; show(current);
        box.classList.remove('spinning');
        btn.disabled = false;
      };
      roll();
    });
  });
</script>

<style>
  .roulette { padding: var(--space-5); box-shadow: var(--shadow-md); color: var(--ink); }
  h2 { display: flex; align-items: center; gap: var(--space-2); margin: 0 0 var(--space-4); font-size: var(--fs-xl); }
  .slot {
    display: flex; align-items: center; gap: var(--space-4); padding: var(--space-3);
    border: var(--bw) solid var(--line); border-radius: var(--radius-md); background: var(--surface);
    color: var(--ink); text-decoration: none; min-height: calc(var(--space-12) + var(--space-4));
  }
  .emoji {
    flex: 0 0 auto; display: grid; place-items: center; width: var(--space-12); aspect-ratio: 1;
    border: var(--bw-sm) solid var(--line); border-radius: var(--radius-sm);
    font-size: var(--fs-emoji-sm); line-height: 1; --dots-size: var(--dots-size-sm);
  }
  .title { font-family: var(--font-display); font-size: var(--fs-lg); font-weight: 700; line-height: 1.2; }
  .spinning .slot { opacity: 0.7; }
  .row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-3); margin-top: var(--space-4); }
  .read { display: inline-flex; align-items: center; gap: var(--space-1); font-family: var(--font-display); font-size: var(--fs-sm); font-weight: 700; color: var(--pink-text); }
  .stats { margin: var(--space-4) 0 0; font-size: var(--fs-xs); color: var(--muted); }
</style>
