---
// Hintergrund im Dunkelmodus. Pro Sitzung wird eine von drei Varianten
// zufällig gezogen und bleibt bis zum Schließen des Tabs gleich (Wunsch von Eric, 2026-10-02):
//   dots   = Punktnacht: leises Punktraster, unter der Maus leuchten die Punkte gelb
//   shapes = Formenflug: Umriss-Formen in Kategoriefarben schweben langsam
//   glow   = Leuchtpunkte: Punktraster, einzelne Punkte glühen in Kategoriefarben auf
// Zum Ansehen einer bestimmten Variante: ?sky=dots|shapes|glow an die Adresse hängen.
// Regeln: docs/design-system.md, Abschnitt „Dunkler Hintergrund“.
import { CATEGORIES } from '../config';

// Formenflug: Kategorie, Form und Platz jeder Form (Platz und Größe stehen im <style>)
const SHAPES = [
  { cat: 'science', path: '<circle cx="35" cy="35" r="30"/>', box: 70 },
  { cat: 'body', path: '<path d="M33 6 60 58H6z"/>', box: 66 },
  { cat: 'weird', path: '<path d="M4 30q10-20 20 0t20 0 20 0 20 0"/>', box: 88 },
  { cat: 'nature', path: '<path d="M23 4v38M4 23h38"/>', box: 46 },
  { cat: 'tech', path: '<path d="M32 4l8 18 20 2-15 13 5 20-18-11-18 11 5-20L4 24l20-2z"/>', box: 64 },
  { cat: 'history', path: '<path d="M4 50a31 31 0 0 1 62 0"/>', box: 70 },
  { cat: 'survival', path: '<circle cx="15" cy="15" r="11"/>', box: 30 },
  { cat: 'sport', path: '<rect x="5" y="5" width="40" height="40" rx="8"/>', box: 50 },
] as const;
---
<div class="sky" aria-hidden="true" data-cats={JSON.stringify(CATEGORIES)}>
  <div class="sky-dots"></div>
  <div class="sky-spot"></div>
  <div class="sky-shapes">
    {SHAPES.map((s) => (
      <svg class={`shape shape--${s.cat}`} viewBox={`0 0 ${s.box} ${s.box}`} fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" set:html={s.path} />
    ))}
  </div>
  <canvas class="sky-glow"></canvas>
</div>

<script>
  const VARIANTS = ['dots', 'shapes', 'glow'] as const;
  type Variant = (typeof VARIANTS)[number];
  const KEY = 'wtfact-sky';
  const root = document.documentElement;
  const sky = document.querySelector<HTMLElement>('.sky');
  const dark = matchMedia('(prefers-color-scheme: dark)');
  const still = matchMedia('(prefers-reduced-motion: reduce)');

  function pick(): Variant {
    const asked = new URLSearchParams(location.search).get('sky') as Variant | null;
    let saved: string | null = null;
    try { saved = sessionStorage.getItem(KEY); } catch { /* Speicher gesperrt: dann pro Seitenaufruf neu */ }
    const v = asked && VARIANTS.includes(asked) ? asked
      : saved && VARIANTS.includes(saved as Variant) ? (saved as Variant)
      : VARIANTS[Math.floor(Math.random() * VARIANTS.length)];
    try { sessionStorage.setItem(KEY, v); } catch { /* s. o. */ }
    return v;
  }

  const variant = pick();
  let stop = () => {};

  // Punktnacht: Lichtkegel folgt der Maus; ohne Maus (Handy) wandert er langsam von selbst.
  // Sobald eine Maus da ist, bleibt er dort stehen, wo sie zuletzt war.
  function dots() {
    let hasMouse = false;
    let raf = 0;
    const t0 = performance.now();
    const move = (e: PointerEvent) => {
      if (e.pointerType !== 'mouse') return;
      root.style.setProperty('--sky-x', `${e.clientX}px`);
      root.style.setProperty('--sky-y', `${e.clientY}px`);
      hasMouse = true;
    };
    const wander = (now: number) => {
      if (!still.matches && !hasMouse) {
        const t = (now - t0) / 1000;
        root.style.setProperty('--sky-x', `${50 + 38 * Math.sin(t * 0.23)}%`);
        root.style.setProperty('--sky-y', `${40 + 30 * Math.sin(t * 0.31 + 1)}%`);
      }
      raf = requestAnimationFrame(wander);
    };
    addEventListener('pointermove', move, { passive: true });
    raf = requestAnimationFrame(wander);
    return () => { removeEventListener('pointermove', move); cancelAnimationFrame(raf); };
  }

  // Leuchtpunkte: Raster auf einem Canvas, Farben kommen aus den Tokens
  function glow() {
    const canvas = sky!.querySelector<HTMLCanvasElement>('.sky-glow')!;
    const ctx = canvas.getContext('2d')!;
    const css = getComputedStyle(root);
    const token = (name: string) => css.getPropertyValue(name).trim();
    const gap = parseFloat(token('--sky-gap'));
    const base = token('--sky-dot');
    const colors: string[] = JSON.parse(sky!.dataset.cats ?? '[]').map((c: string) => token(`--cat-${c}`)).filter(Boolean);
    type Lit = { i: number; j: number; c: string; t: number; d: number; k?: number };
    const lit: Lit[] = [];
    let w = 0, h = 0, cols = 0, rows = 0, raf = 0, next = 0;
    const grid = document.createElement('canvas');

    const fit = () => {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      w = innerWidth; h = innerHeight;
      cols = Math.ceil(w / gap) + 1; rows = Math.ceil(h / gap) + 1;
      for (const c of [canvas, grid]) { c.width = Math.round(w * dpr); c.height = Math.round(h * dpr); }
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const g = grid.getContext('2d')!;
      g.setTransform(dpr, 0, 0, dpr, 0, 0);
      g.fillStyle = base;
      for (let i = 0; i < cols; i++) for (let j = 0; j < rows; j++) {
        g.beginPath(); g.arc(i * gap + gap / 2, j * gap + gap / 2, 1.4, 0, Math.PI * 2); g.fill();
      }
      if (still.matches) seedStill();
      draw(performance.now());
    };
    const spawn = (now: number, k?: number) => lit.push({
      i: Math.floor(Math.random() * cols), j: Math.floor(Math.random() * rows),
      c: colors[Math.floor(Math.random() * colors.length)], t: now, d: 2600 + Math.random() * 2200, k,
    });
    // Bewegung reduziert: ein paar Punkte leuchten fest, nichts blinkt
    const seedStill = () => {
      lit.length = 0;
      for (let n = 0; n < 14; n++) spawn(0, 0.55 + Math.random() * 0.45);
    };
    const dot = (x: number, y: number, r: number, color: string, a: number) => {
      ctx.globalAlpha = a; ctx.fillStyle = color; ctx.shadowColor = color; ctx.shadowBlur = 16 * a;
      ctx.beginPath(); ctx.arc(x, y, r, 0, Math.PI * 2); ctx.fill();
    };
    const draw = (now: number) => {
      ctx.clearRect(0, 0, w, h);
      ctx.globalAlpha = 1; ctx.shadowBlur = 0;
      ctx.drawImage(grid, 0, 0, w, h);
      for (const p of lit) {
        const k = p.k ?? Math.sin(Math.min(1, (now - p.t) / p.d) * Math.PI);
        const x = p.i * gap + gap / 2, y = p.j * gap + gap / 2;
        dot(x, y, 1.4 + 2.6 * k, p.c, 0.95 * k);
        for (const [di, dj] of [[1, 0], [-1, 0], [0, 1], [0, -1]]) dot(x + di * gap, y + dj * gap, 1.4 + 0.6 * k, p.c, 0.45 * k);
      }
      ctx.globalAlpha = 1; ctx.shadowBlur = 0;
    };
    const loop = (now: number) => {
      if (!still.matches) {
        for (let n = lit.length - 1; n >= 0; n--) if (lit[n].k !== undefined || now - lit[n].t > lit[n].d) lit.splice(n, 1);
        if (now > next && lit.length < 16) { spawn(now); next = now + 180 + Math.random() * 260; }
        draw(now);
      } else if (!lit.some((p) => p.k !== undefined)) { seedStill(); draw(now); }
      raf = requestAnimationFrame(loop);
    };
    fit();
    addEventListener('resize', fit);
    raf = requestAnimationFrame(loop);
    return () => { removeEventListener('resize', fit); cancelAnimationFrame(raf); };
  }

  // Nur im Dunkelmodus aktiv; wechselt das System das Farbschema, an- oder abschalten
  function apply() {
    stop();
    stop = () => {};
    if (!sky || !dark.matches) { delete root.dataset.sky; return; }
    root.dataset.sky = variant;
    if (variant === 'dots') stop = dots();
    if (variant === 'glow') stop = glow();
  }
  dark.addEventListener('change', apply);
  apply();
</script>

<style>
  .sky { display: none; }
  @media (prefers-color-scheme: dark) {
    .sky { display: block; position: fixed; inset: 0; z-index: -1; pointer-events: none; overflow: hidden; }
  }
  .sky > * { display: none; position: absolute; inset: 0; }
  :global(html[data-sky='dots']) .sky-dots,
  :global(html[data-sky='dots']) .sky-spot,
  :global(html[data-sky='shapes']) .sky-shapes,
  :global(html[data-sky='glow']) .sky-glow { display: block; }

  /* Punktnacht */
  .sky-dots {
    background-image: radial-gradient(var(--sky-dot) 1.4px, transparent 1.8px);
    background-size: var(--sky-gap) var(--sky-gap);
    mask-image: radial-gradient(ellipse 90% 80% at 50% 40%, black 30%, transparent 100%);
  }
  .sky-spot {
    background-image: radial-gradient(var(--sky-spot) 1.6px, transparent 2px);
    background-size: var(--sky-gap) var(--sky-gap);
    mask-image: radial-gradient(circle var(--sky-spot-size) at var(--sky-x, 30%) var(--sky-y, 30%), black 0%, transparent 100%);
  }

  /* Leuchtpunkte */
  .sky-glow { width: 100%; height: 100%; }

  /* Formenflug: nur Umrisse, damit keine Kategoriefläche ohne Punktmuster entsteht */
  .shape {
    position: absolute; inset: auto; overflow: visible; opacity: var(--sky-shape-opacity);
    animation: sky-drift var(--dur-sky-drift) ease-in-out infinite alternate;
  }
  .shape--science { color: var(--cat-science); left: 4%; top: 18%; width: 70px; --tx: 30px; --ty: -20px; --r: 0deg; }
  .shape--body { color: var(--cat-body); left: 46%; top: 12%; width: 56px; --tx: -20px; --ty: 26px; --r: 40deg; animation-delay: calc(var(--dur-sky-drift) * -0.15); animation-duration: calc(var(--dur-sky-drift) * 1.15); }
  .shape--weird { color: var(--cat-weird); left: 86%; top: 24%; width: 80px; --tx: -26px; --ty: 18px; --r: 12deg; animation-delay: calc(var(--dur-sky-drift) * -0.3); animation-duration: calc(var(--dur-sky-drift) * 0.85); }
  .shape--nature { color: var(--cat-nature); left: 32%; top: 60%; width: 46px; --tx: 22px; --ty: 24px; --r: 90deg; animation-delay: calc(var(--dur-sky-drift) * -0.45); animation-duration: calc(var(--dur-sky-drift) * 0.8); }
  .shape--tech { color: var(--cat-tech); left: 70%; top: 72%; width: 64px; --tx: -30px; --ty: -22px; --r: 60deg; animation-delay: calc(var(--dur-sky-drift) * -0.6); animation-duration: calc(var(--dur-sky-drift) * 1.3); }
  .shape--history { color: var(--cat-history); left: 10%; top: 82%; width: 70px; --tx: 26px; --ty: -18px; --r: -30deg; animation-delay: calc(var(--dur-sky-drift) * -0.75); animation-duration: calc(var(--dur-sky-drift) * 1.08); }
  .shape--survival { color: var(--cat-survival); left: 58%; top: 42%; width: 30px; --tx: 18px; --ty: 30px; --r: 0deg; animation-delay: calc(var(--dur-sky-drift) * -0.9); animation-duration: calc(var(--dur-sky-drift) * 0.7); }
  .shape--sport { color: var(--cat-sport); left: 92%; top: 86%; width: 50px; --tx: -24px; --ty: -26px; --r: 45deg; animation-delay: calc(var(--dur-sky-drift) * -1.05); animation-duration: calc(var(--dur-sky-drift) * 1.23); }
  @keyframes sky-drift {
    0% { transform: translate(0, 0) rotate(0deg); }
    50% { transform: translate(var(--tx), var(--ty)) rotate(var(--r)); }
    100% { transform: translate(calc(var(--tx) * -0.6), calc(var(--ty) * 0.4)) rotate(calc(var(--r) * -0.5)); }
  }
  @media (max-width: 640px) {
    .shape { scale: 0.7; }
    .shape--survival, .shape--nature { display: none; }
  }
</style>
