---
// Geschenkfinder (Wunsch von Eric, 2026-10-21): /de/geschenke/ und /en/gifts/, das ganze Jahr erreichbar.
// Erst der Anlass (je nach Monat vorausgewählt, im Browser, src/data/gifts.ts; ?occasion=birthday wählt ihn per Link), dann für wen, Interesse und Budget.
// Alle Ideen stehen fertig im HTML, der Browser blendet nur aus und sortiert. Jede Idee hat einen WTF-Fakt als Aufhänger.
// Werbung: Etikett, Provisionshinweis und rel="sponsored" wie bei ProductBox.astro.
// Aussehen (2026-10-21, zweiter Wunsch): Filter und Ideen als Leuchtkarten (.glow) in der Farbwelt des Interesses.
import Base from '../../layouts/Base.astro';
import FestDeco from '../FestDeco.astro';
import Icon from '../Icon.astro';
import type { Lang } from '../../config';
import { SITE } from '../../config';
import { t } from '../../i18n/ui';
import { x, giftsPath } from '../../i18n/extras';
import { postsFor, postUrl, amazonUrl, categoryIcon } from '../../lib';
import { festOf } from '../../data/holidays';
import { GIFTS, OCCASIONS, OCCASION_EMOJI, OCCASION_BY_MONTH, WHO, INTERESTS, INTEREST_EMOJI, type Interest } from '../../data/gifts';
interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
const g = x(lang).gifts;
const other: Lang = lang === 'de' ? 'en' : 'de';
const posts = await postsFor(lang);
const byKey = new Map(posts.map((p) => [p.data.translationKey, p]));
const catOf: Record<Interest, string> = { space: 'space', nature: 'nature', science: 'science', tech: 'tech', food: 'food', history: 'history', mind: 'mind', fun: 'weird', sport: 'sport', language: 'language' };
const host = SITE.amazon[lang].host.replace(/^www\./, '');
const preset = OCCASION_BY_MONTH[new Date().getMonth()];
---
<Base lang={lang} title={g.title} description={g.intro} altUrl={giftsPath(other)}>
  <section class="sec fest-sky ghero" data-fest="fest">
    <FestDeco deco={['sparkle', 'star', 'question', 'bolt']} size="lg" />
    <div class="wrap">
      <span class="pill">{g.kicker}</span>
      <h1 class="mega word">{g.title}</h1>
      <p class="intro">{g.intro}</p>
    </div>
  </section>

  <section class="sec sec--night gplay" data-edge data-gifts data-by-month={JSON.stringify(OCCASION_BY_MONTH)} data-count-text={JSON.stringify([g.results(1), g.results(9001)])}>
    <div class="wrap">
      <div class="glow filters bleed" data-fest="fest">
        <fieldset>
          <legend>{g.occasion}</legend>
          <div class="pills" role="group" aria-label={g.occasion}>
            {OCCASIONS.map((o) => <button class="chip opt" type="button" aria-pressed={String(o === preset)} data-occasion={o}>{OCCASION_EMOJI[o]} {g.occasions[o]}</button>)}
          </div>
        </fieldset>
        <fieldset>
          <legend>{g.who}</legend>
          <div class="pills" role="group" aria-label={g.who}>
            <button class="chip opt" type="button" aria-pressed="true" data-who="">{g.any}</button>
            {WHO.map((w) => <button class="chip opt" type="button" aria-pressed="false" data-who={w}>{g.whos[w]}</button>)}
          </div>
        </fieldset>
        <fieldset>
          <legend>{g.likes}</legend>
          <div class="pills" role="group" aria-label={g.likes}>
            <button class="chip opt" type="button" aria-pressed="true" data-interest="">{g.any}</button>
            {INTERESTS.map((i) => <button class="chip opt" type="button" aria-pressed="false" data-interest={i}>{INTEREST_EMOJI[i]} {g.interests[i]}</button>)}
          </div>
        </fieldset>
        <fieldset>
          <legend>{g.budget}</legend>
          <div class="pills" role="group" aria-label={g.budget}>
            <button class="chip opt" type="button" aria-pressed="true" data-budget="">{g.any}</button>
            {([1, 2, 3] as const).map((b) => <button class="chip opt" type="button" aria-pressed="false" data-budget={b}>{g.budgets[b]}</button>)}
          </div>
        </fieldset>
      </div>

      <div class="res-head">
        <p class="count" data-count aria-live="polite"></p>
        <span class="pick-label">{ui.adLabel}</span>
      </div>
      <ul class="gifts" data-list>
        {GIFTS.map((gift) => {
          const tx = gift[lang];
          const fact = gift.fact ? byKey.get(gift.fact) : undefined;
          return (
            <li data-gift data-who={gift.who.join(' ')} data-interest={gift.interest} data-budget={gift.budget} data-occasions={(gift.occasions ?? []).join(' ')}>
              <article class="glow gift" data-fest={festOf(catOf[gift.interest], '')?.theme}>
                <span class="art" aria-hidden="true">
                  <span class:list={['glow-tile', 'emoji', `cat-${catOf[gift.interest]}`]}><span>{gift.emoji}</span></span>
                  <img class="glow-icon" src={categoryIcon(catOf[gift.interest])} alt="" width="64" height="64" loading="lazy" />
                  <span class="host">{host}</span>
                </span>
                <div class="body">
                  <h2 class="head-small name">{tx.name}</h2>
                  <p class="why">{tx.why}</p>
                  {fact && <a class="fact" href={postUrl(fact)}>{fact.data.emoji} {g.fact}: {fact.data.title}</a>}
                  <a class="btn btn--orange cta" href={amazonUrl(lang, tx.query)} rel="sponsored nofollow noopener" target="_blank"
                    data-umami-event="amazon" data-umami-event-fact={gift.fact ?? gift.id} data-umami-event-place="gifts">{g.cta} <Icon name="external-link" /></a>
                </div>
              </article>
            </li>
          );
        })}
      </ul>
      <p class="none" data-none hidden>{g.none} <button class="linkish" type="button" data-reset>{g.reset}</button></p>
      <p class="fine">{ui.affiliateShort} {g.priceNote}</p>
    </div>
  </section>
</Base>

<script>
  const root = document.querySelector<HTMLElement>('[data-gifts]');
  if (root) {
    const params = new URLSearchParams(location.search);
    const state: Record<'occasion' | 'who' | 'interest' | 'budget', string> = {
      occasion: params.get('occasion') ?? (JSON.parse(root.dataset.byMonth!) as string[])[new Date().getMonth()] ?? 'just',
      who: params.get('who') ?? '', interest: params.get('interest') ?? '', budget: '',
    };
    const counts = JSON.parse(root.dataset.countText!) as string[];
    const items = [...root.querySelectorAll<HTMLElement>('[data-gift]')];
    const list = root.querySelector<HTMLElement>('[data-list]')!;
    const apply = () => {
      (Object.keys(state) as (keyof typeof state)[]).forEach((k) =>
        root.querySelectorAll<HTMLButtonElement>(`[data-${k}]`).forEach((b) => b.tagName === 'BUTTON' && b.setAttribute('aria-pressed', String(b.dataset[k] === state[k]))),
      );
      const shown = items.filter((li) => {
        const ok = (!state.who || li.dataset.who!.split(' ').includes(state.who))
          && (!state.interest || li.dataset.interest === state.interest)
          && (!state.budget || li.dataset.budget === state.budget);
        li.hidden = !ok;
        return ok;
      });
      // Ideen für den gewählten Anlass zuerst, dann der Rest in fester Reihenfolge
      const fits = (li: HTMLElement) => li.dataset.occasions!.split(' ').includes(state.occasion);
      [...shown.filter(fits), ...shown.filter((li) => !fits(li)), ...items.filter((li) => li.hidden)].forEach((li) => list.append(li));
      root.querySelector('[data-count]')!.textContent = shown.length === 1 ? counts[0] : counts[1].replace('9001', String(shown.length));
      root.querySelector<HTMLElement>('[data-none]')!.hidden = shown.length > 0;
    };
    root.querySelectorAll<HTMLButtonElement>('button[data-occasion], button[data-who], button[data-interest], button[data-budget]').forEach((b) =>
      b.addEventListener('click', () => {
        const k = (['occasion', 'who', 'interest', 'budget'] as const).find((key) => key in b.dataset)!;
        state[k] = b.dataset[k] ?? '';
        apply();
      }),
    );
    root.querySelector('[data-reset]')!.addEventListener('click', () => { state.who = ''; state.interest = ''; state.budget = ''; apply(); });
    apply();
  }
</script>

<style>
  .ghero > .wrap { position: relative; z-index: 1; }
  .ghero { position: relative; padding: var(--space-10) 0 calc(var(--space-12) + var(--bleed)); overflow: clip; }
  .pill { display: inline-block; padding: var(--space-2) var(--space-4); border-radius: var(--radius-pill); background: var(--fest-a); color: var(--on-accent); font-family: var(--font-display); font-weight: 700; font-size: var(--fs-lg); transform: rotate(-3deg); }
  .word { margin: var(--space-5) calc(-1 * var(--space-4)) 0; font-size: var(--fs-display-2xl); text-transform: uppercase; text-shadow: var(--shift-mega) var(--shift-mega) 0 var(--fest-b); transform: rotate(-2deg); }
  .intro { max-width: 52ch; margin: var(--space-10) 0 0; font-size: var(--fs-xl); font-weight: 600; }
  .gplay { padding: 0 0 var(--space-12); }
  .filters { z-index: 2; margin-top: calc(-1 * var(--bleed)); padding: var(--space-6); display: grid; gap: var(--space-5); }
  .filters .chip { background: var(--night); color: var(--on-night); border-color: var(--on-night); }
  fieldset { margin: 0; padding: 0; border: 0; min-width: 0; }
  legend { margin-bottom: var(--space-2); font-family: var(--font-display); font-weight: 800; font-size: var(--fs-lg); color: var(--fest-a); }
  .pills { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .opt { cursor: pointer; }
  .filters .opt[aria-pressed='true'] { background: var(--fest-a); color: var(--on-accent); border-color: var(--on-accent); }
  .res-head { display: flex; justify-content: space-between; align-items: center; gap: var(--space-4); margin: var(--space-9) 0 var(--space-4); }
  .count { margin: 0; font-family: var(--font-display); font-weight: 800; font-size: var(--fs-xl); }
  .pick-label {
    padding: 0 var(--space-2); border: var(--bw-sm) solid var(--on-night); border-radius: var(--radius-sm); font-family: var(--font-display);
    font-size: var(--fs-sm); font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; transform: rotate(2deg);
  }
  .gifts { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr)); gap: var(--space-8) var(--space-6); }
  .gifts li { display: flex; }
  .gift { display: flex; flex-direction: column; width: 100%; }
  .art { position: relative; display: grid; place-items: center; min-height: 9rem; padding-top: var(--space-5); }
  .emoji { width: var(--space-12); height: var(--space-12); font-size: var(--fs-emoji-md); }
  .art .glow-icon { right: var(--space-3); bottom: auto; top: var(--space-3); width: var(--space-10); opacity: 0.7; }
  .host { position: absolute; left: var(--space-4); top: var(--space-3); font-size: var(--fs-xs); font-weight: 800; color: var(--on-night-muted); }
  .body { display: flex; flex-direction: column; gap: var(--space-2); flex: 1; padding: var(--space-4) var(--space-5) var(--space-5); }
  .name { margin: 0; font-size: var(--fs-lg); color: var(--fest-a); }
  .why { margin: 0; color: var(--on-night); font-size: var(--fs-md); }
  .fact { font-size: var(--fs-sm); font-weight: 700; color: var(--on-night-muted); }
  .fact:hover { color: var(--fest-a); }
  .cta { margin-top: auto; align-self: flex-start; border-color: var(--on-accent); }
  .none { font-weight: 700; }
  .linkish { font: inherit; color: inherit; background: none; border: 0; padding: 0; text-decoration: underline; cursor: pointer; }
  .fine { margin: var(--space-6) 0 0; font-size: var(--fs-sm); color: var(--on-night-muted); }
  @media (max-width: 760px) {
    .filters { padding: var(--space-5); }
    .intro { margin-top: var(--space-8); font-size: var(--fs-lg); }
  }
</style>
