---
// Du in Zahlen (Wunsch von Eric, 2026-10-21): /de/du-in-zahlen/ und /en/you-in-numbers/. Geburtstag eingeben,
// der Browser rechnet aus, was Körper und Erde seitdem geleistet haben. Nichts wird gesendet; das Datum bleibt
// nur im Browser, damit man beim nächsten Besuch nicht neu tippen muss. Rechenwerte und Quellen: x(lang).you.sources.
// „Als Bild speichern“ zeichnet eine Karte im WTFact-Look auf ein Canvas, Farben kommen aus den Tokens.
import Base from '../../layouts/Base.astro';
import FestDeco from '../FestDeco.astro';
import type { Lang } from '../../config';
import { x, youPath, giftsPath } from '../../i18n/extras';
interface Props { lang: Lang }
const { lang } = Astro.props;
const y = x(lang).you;
const other: Lang = lang === 'de' ? 'en' : 'de';
const texts = { milestone: y.milestone('§', '¶'), birthday: [y.birthday(0), y.birthday(1), y.birthday(9001)], share: y.shareText('§1', '§2', '§3'), copied: y.copied, invalid: y.invalid, imageTitle: y.imageTitle, url: 'wtfact.xyz' };
const stats = [
  { key: 'days', emoji: '📅', cls: 'cat-nature', label: y.days },
  { key: 'beats', emoji: '🫀', cls: 'cat-body', label: y.beats },
  { key: 'breaths', emoji: '🌬️', cls: 'cat-science', label: y.breaths },
  { key: 'orbit', emoji: '🌍', cls: 'cat-space', label: y.orbit },
  { key: 'sleep', emoji: '😴', cls: 'cat-tech', label: y.sleep },
  { key: 'moons', emoji: '🌕', cls: 'cat-weird', label: y.moons },
];
---
<Base lang={lang} title={y.title} description={y.intro} altUrl={youPath(other)}>
  <section class="sec fest-sky yhero" data-fest="body">
    <FestDeco deco={['sparkle', 'star', 'question', 'bolt']} size="lg" />
    <div class="wrap">
      <span class="pill">{y.kicker}</span>
      <h1 class="mega word">{y.title}</h1>
      <p class="intro">{y.intro}</p>
    </div>
  </section>

  <section class="sec sec--night yplay" data-edge data-you data-lang={lang} data-texts={JSON.stringify(texts)}>
    <div class="wrap">
      <form class="card yform bleed" data-form>
        <label for="you-birthday">{y.label}</label>
        <div class="row">
          <input id="you-birthday" type="date" required data-date />
          <button class="btn btn--pink" type="submit">{y.show}</button>
        </div>
        <p class="err" data-err aria-live="polite" hidden></p>
      </form>

      <div class="out" data-out hidden>
        <h2>{y.since}</h2>
        <ul class="stats">
          {stats.map((s) => (
            <li class="stat">
              <span class:list={['s-emoji', s.cls]} aria-hidden="true">{s.emoji}</span>
              <span><b data-stat={s.key}>0</b><small>{s.label}</small></span>
            </li>
          ))}
        </ul>
        <p class="next" data-milestone></p>
        <p class="next" data-birthday></p>
        <div class="acts">
          <button class="btn" type="button" data-share>{y.share}</button>
          <button class="btn btn--ghost" type="button" data-image>{y.image}</button>
          <a class="btn btn--ghost" href={`${giftsPath(lang)}?occasion=birthday`}>🎁 {y.gift}</a>
        </div>
        <p class="copied" data-copied aria-live="polite" hidden>{y.copied}</p>
        <canvas class="sr-only" width="1080" height="1350" data-canvas aria-hidden="true"></canvas>
      </div>
      <p class="src">{y.sources}</p>
    </div>
  </section>
</Base>

<script>
  import { berlinDay, daysBetween, addDays } from '../../week';
  import { markActive } from '../../scripts/streak';

  const root = document.querySelector<HTMLElement>('[data-you]');
  if (root) {
    const T = JSON.parse(root.dataset.texts!);
    const lang = root.dataset.lang!;
    const locale = lang === 'de' ? 'de-DE' : 'en-US';
    const KEY = 'wtfact:birthday';
    const $ = <E extends HTMLElement>(s: string) => root.querySelector<E>(s)!;
    const input = $<HTMLInputElement>('[data-date]');
    const today = berlinDay();
    input.max = today;
    const big = (n: number) => {
      // Große Zahlen lesbar: 1,1 Mrd. / 1.1 billion
      return new Intl.NumberFormat(locale, { notation: n >= 1e6 ? 'compact' : 'standard', compactDisplay: 'long', maximumFractionDigits: n >= 1e6 ? 1 : 0 }).format(n);
    };
    let last: Record<string, string> = {};
    const show = (birth: string) => {
      const days = daysBetween(birth, today);
      const err = $('[data-err]');
      if (!(days > 0)) { err.hidden = false; err.textContent = T.invalid; $('[data-out]').hidden = true; return; }
      err.hidden = true;
      const years = days / 365.2425;
      const v: Record<string, string> = {
        days: days.toLocaleString(locale),
        beats: big(days * 1440 * 80),
        breaths: big(days * 1440 * 16),
        orbit: big(years * 940e6),
        sleep: (years / 3).toLocaleString(locale, { maximumFractionDigits: 1 }),
        moons: Math.floor(days / 29.530589).toLocaleString(locale),
      };
      last = v;
      Object.entries(v).forEach(([k, s]) => ($(`[data-stat="${k}"]`).textContent = s));
      // Nächster runder Tag: 10.000, danach alle 5.000
      const target = days < 10000 ? 10000 : Math.ceil((days + 1) / 5000) * 5000;
      const when = new Date(`${addDays(birth, target)}T12:00:00Z`).toLocaleDateString(locale, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
      $('[data-milestone]').textContent = T.milestone.replace('§', target.toLocaleString(locale)).replace('¶', when);
      const [, m, d] = birth.split('-');
      let next = `${today.slice(0, 4)}-${m}-${d}`;
      if (next < today) next = `${Number(today.slice(0, 4)) + 1}-${m}-${d}`;
      const left = daysBetween(today, next);
      $('[data-birthday]').textContent = left <= 1 ? T.birthday[left] : T.birthday[2].replace('9001', String(left));
      $('[data-out]').hidden = false;
      try { localStorage.setItem(KEY, birth); } catch { /* privates Fenster */ }
      markActive();
    };
    try { const saved = localStorage.getItem(KEY); if (saved) { input.value = saved; show(saved); } } catch { /* ohne Speicher */ }
    $<HTMLFormElement>('[data-form]').addEventListener('submit', (e) => { e.preventDefault(); if (input.value) show(input.value); });

    const shareText = () => T.share.replace('§1', last.days).replace('§2', last.beats).replace('§3', last.orbit) + ` ${location.href.split('?')[0]}`;
    $('[data-share]').addEventListener('click', async () => {
      try {
        if (navigator.share) await navigator.share({ text: shareText() });
        else { await navigator.clipboard.writeText(shareText()); $('[data-copied]').hidden = false; }
      } catch { /* abgebrochen */ }
    });

    // Karte zum Speichern: dunkle Bühne, gelbe Überschrift, die sechs Zahlen in Kategoriefarben
    $('[data-image]').addEventListener('click', () => {
      const cv = $<HTMLCanvasElement>('[data-canvas]');
      const ctx = cv.getContext('2d')!;
      const css = getComputedStyle(document.documentElement);
      const tok = (n: string) => css.getPropertyValue(n).trim();
      const head = tok('--font-display') || 'sans-serif';
      ctx.fillStyle = tok('--night');
      ctx.fillRect(0, 0, cv.width, cv.height);
      ctx.fillStyle = tok('--yellow');
      ctx.font = `900 96px ${head}`;
      ctx.fillText(T.imageTitle, 80, 180);
      const colors = ['--cat-nature', '--cat-body', '--cat-science', '--cat-space', '--cat-tech', '--cat-weird'].map(tok);
      [...root.querySelectorAll<HTMLElement>('.stat')].forEach((li, k) => {
        const y0 = 290 + k * 160;
        ctx.fillStyle = colors[k];
        ctx.fillRect(80, y0, 16, 120);
        ctx.fillStyle = tok('--on-night');
        ctx.font = `800 72px ${head}`;
        ctx.fillText(li.querySelector('b')!.textContent ?? '', 130, y0 + 66);
        ctx.fillStyle = tok('--on-night-muted');
        ctx.font = `600 36px ${head}`;
        ctx.fillText(li.querySelector('small')!.textContent ?? '', 130, y0 + 114);
      });
      ctx.fillStyle = tok('--pink');
      ctx.font = `900 56px ${head}`;
      ctx.fillText(T.url, 80, 1290);
      cv.toBlob((blob) => {
        if (!blob) return;
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'wtfact-du-in-zahlen.png';
        a.click();
        setTimeout(() => URL.revokeObjectURL(a.href), 2000);
      });
    });
  }
</script>

<style>
  .yhero > .wrap { position: relative; z-index: 1; }
  .yhero { position: relative; padding: var(--space-10) 0 calc(var(--space-12) + var(--bleed)); overflow: clip; }
  .pill { display: inline-block; padding: var(--space-2) var(--space-4); border-radius: var(--radius-pill); background: var(--fest-a); color: var(--on-accent); font-family: var(--font-display); font-weight: 700; font-size: var(--fs-lg); transform: rotate(-3deg); }
  .word { margin: var(--space-5) calc(-1 * var(--space-4)) 0; font-size: var(--fs-display-2xl); text-transform: uppercase; text-shadow: var(--shift-mega) var(--shift-mega) 0 var(--fest-b); transform: rotate(-2deg); }
  .intro { max-width: 52ch; margin: var(--space-10) 0 0; font-size: var(--fs-xl); font-weight: 600; }
  .yplay { padding: 0 0 var(--space-12); }
  .yform {
    position: relative; z-index: 2; max-width: 36rem; margin-top: calc(-1 * var(--bleed)); padding: var(--space-6);
    display: grid; gap: var(--space-3); border: var(--bw-strong) solid var(--on-accent); box-shadow: var(--shadow-2xl);
  }
  label { font-family: var(--font-display); font-weight: 800; font-size: var(--fs-lg); }
  .row { display: flex; gap: var(--space-3); flex-wrap: wrap; }
  input { flex: 1 1 12rem; min-width: 0; padding: var(--space-3) var(--space-4); font: inherit; font-size: var(--fs-lg); font-weight: 700; border: var(--bw-strong) solid var(--line); border-radius: var(--radius-md); background: var(--surface); color: var(--ink); }
  .err { margin: 0; color: var(--pink-text); font-weight: 700; }
  .out { margin-top: var(--space-10); }
  h2 { margin: 0 0 var(--space-6); font-size: var(--fs-display-md); }
  .stats { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); gap: var(--space-4); }
  .stat { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--space-4); align-items: center; padding: var(--space-4); border: var(--bw) solid var(--on-night); border-radius: var(--radius-md); background: var(--night-2); }
  .s-emoji { display: grid; place-items: center; width: var(--space-12); height: var(--space-12); font-size: var(--fs-emoji-sm); border: var(--bw-sm) solid var(--on-accent); border-radius: var(--radius-sm); }
  .stat b { display: block; font-family: var(--font-display); font-size: var(--fs-2xl); font-weight: 800; line-height: 1.1; color: var(--yellow); }
  .stat small { color: var(--on-night-muted); font-size: var(--fs-sm); font-weight: 600; }
  .next { margin: var(--space-4) 0 0; font-weight: 700; }
  .acts { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-6); }
  .copied { font-weight: 700; }
  .src { margin: var(--space-10) 0 0; max-width: var(--measure); font-size: var(--fs-sm); color: var(--on-night-muted); }
  @media (max-width: 760px) {
    .yform { padding: var(--space-5); }
    .intro { margin-top: var(--space-8); font-size: var(--fs-lg); }
  }
</style>
