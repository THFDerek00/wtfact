---
// Adventskalender (Wunsch von Eric, 2026-10-21, Entwurf „Look A, Kerzenschein“ im Projektordner advent-2026/).
// 24 Türchen in gemischter Reihenfolge wie bei einem echten Kalender, jedes mit einem eigenen Fakt (src/data/advent.ts).
// Besondere Türchen: Quiz (Wahr oder Fake), Schätzen, Geschenk-Tipp, Nikolaus-Stiefel mit zwei Fakten, Finale.
// Daneben der WTF-Baum (eine Kugel je geöffnetes Türchen), die Legende und der Wichtel des Tages.
// Ein Türchen geht um 0 Uhr (deutsche Zeit) seines Tages auf, verpasste lassen sich nachholen. Den Stand hält der Browser
// (src/scripts/advent.ts). Mit #t15 in der Adresse geht Türchen 15 direkt auf.
import Base from '../../layouts/Base.astro';
import Icon from '../Icon.astro';
import FestIcon from '../FestIcon.astro';
import FestDeco from '../FestDeco.astro';
import Wreath from '../xmas/Wreath.astro';
import XmasTree from '../xmas/XmasTree.astro';
import Wichtel from '../xmas/Wichtel.astro';
import type { Lang } from '../../config';
import { t } from '../../i18n/ui';
import { giftsPath } from '../../i18n/extras';
import { at, adventPath } from '../../i18n/advent';
import { postsFor, postUrl, amazonUrl } from '../../lib';
import { berlinDay } from '../../week';
import { DOORS, QUIZ, GUESS, GUESS_TRIES, GUESS_HIT, calendarYear, kindOf, adventNo, firstAdvent } from '../../data/advent';
interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
const xa = at(lang);
const other: Lang = lang === 'de' ? 'en' : 'de';
const today = berlinDay();
const year = calendarYear(today);
const doors = DOORS[year] ?? {};
const posts = await postsFor(lang);
const byKey = new Map(posts.map((p) => [p.data.translationKey, p]));
const firstUrl = (door: number) => { const p = byKey.get(doors[door]?.[0] ?? ''); return p ? postUrl(p) : null; };
// Nur schon erschienene Fakten stehen in der Seite, alles andere bleibt bis zu seinem Tag geheim.
const data = Object.fromEntries(
  Array.from({ length: 24 }, (_, k) => k + 1).map((n) => {
    const facts = (doors[n] ?? []).map((key) => byKey.get(key)).filter((p) => !!p).map((p) => ({
      key: p.data.translationKey, title: p.data.title, hook: p.data.hook, url: postUrl(p), emoji: p.data.emoji,
      cat: ui.categories[p.data.category], catCls: `cat-${p.data.category}`,
      products: kindOf(n) === 'gift' ? p.data.products.map((pr) => ({ name: pr.name, why: pr.why, url: amazonUrl(lang, pr.query) })) : [],
    }));
    const quiz = (QUIZ[year]?.[n] ?? []).map((q) => ({ text: q.text[lang], ok: q.true, url: firstUrl(q.door) }));
    const g = GUESS[year]?.[n];
    return [n, { kind: kindOf(n), facts, quiz, guess: g ? { q: g.q[lang], answer: g.answer, unit: g.unit[lang] } : null }];
  }).filter(([, d]) => (d as { facts: unknown[] }).facts.length),
);
const cats = Object.fromEntries(Object.values(data).flatMap((d) => d.facts.map((f) => [f.key, f.cat])));
// Reihenfolge und Größen wie im Entwurf: gemischt, 6 (Stiefel) hoch, 24 groß, 15 breit, 18 hoch
const ORDER = [7, 18, 3, 22, 11, 1, 15, 24, 9, 20, 5, 13, 16, 2, 6, 19, 12, 8, 23, 4, 17, 10, 21, 14];
const SIZE: Record<number, string> = { 6: 'h2', 24: 'w2 h2', 15: 'w2', 18: 'h2' };
const BIG: Record<number, string> = { 6: 'boot', 24: 'fir', 15: 'bell', 18: 'candle' };
const ICONS = ['fir', 'star', 'bell', 'snowflake', 'gift', 'candle', 'orange'];
const adv = Math.max(1, adventNo(today));
const dateText = new Intl.DateTimeFormat(lang === 'de' ? 'de-DE' : 'en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${today}T12:00:00Z`));
const texts = {
  door: xa.door, next: xa.next, nextDone: xa.nextDone, preview: xa.preview, archive: xa.archive.replace('{y}', String(year)), units: xa.units,
  locked: xa.locked, notYet: xa.notYet, read: xa.read, ball: xa.ball, ballFull: xa.ballFull, balls: xa.balls, gold: xa.gold,
  share: xa.shareText, copied: xa.copied, quiz: xa.quiz, guess: xa.guess, gift: xa.gift, boot: xa.boot, finale: xa.finale, kinds: xa.kinds,
  wichtel: xa.wichtel, ad: ui.adLabel, giftsUrl: giftsPath(lang),
};
---
<Base lang={lang} title={xa.title} description={xa.description} altUrl={adventPath(other)}>
  <dialog class="dlg" data-x-dlg data-fest="xmas" aria-labelledby="x-dlg-title">
    <div class="open">
      <span class="confetti" aria-hidden="true">{Array.from({ length: 18 }, (_, k) => <i class={`c${k % 5}`}></i>)}</span>
      <div class="panel" aria-hidden="true"><span class="num" data-x-num></span></div>
      <div class="inside">
        <button type="button" class="close chip" data-x-close aria-label={xa.close}><Icon name="x" /></button>
        <div class="art" aria-hidden="true"><FestIcon name="star" /></div>
        <p class="chips"><span class="chip" data-x-kind></span></p>
        <h2 id="x-dlg-title" data-x-head></h2>
        <div data-x-body></div>
        <div class="ball" data-x-ballbox><XmasTree class="tsmall" /><span data-x-ball></span></div>
      </div>
    </div>
  </dialog>

  <section class="sec fest-sky xhero" data-fest="xmas">
    <FestDeco deco={['fir', 'star', 'snowflake', 'bell', 'gift', 'candle']} size="lg" />
    <span class="heroart" aria-hidden="true"><FestIcon name="fir" /></span>
    <div class="wrap">
      <div class="pills"><span class="pill" data-x-date>{dateText}</span><span class="xmas"><Wreath lit={adv} label={xa.advent.replace('{n}', String(adv))} tpl={xa.advent} /></span></div>
      <h1 class="word">{xa.word}</h1>
      <p class="sub">{xa.sub}</p>
      <p class="cd" data-x-cd aria-live="off"></p>
    </div>
  </section>

  <section class="sec fest-sky wall" data-fest="xmas" data-edge data-x-cal data-year={year} data-first={firstAdvent(year)}
    data-doors={JSON.stringify(data)} data-cats={JSON.stringify(cats)} data-texts={JSON.stringify(texts)} data-guess-tries={GUESS_TRIES} data-guess-hit={GUESS_HIT}>
    <div class="wrap">
      <ol class="grid" aria-label={xa.name}>
        {ORDER.map((n, i) => (
          <li class:list={['cell', SIZE[n]]}>
            <button type="button" class:list={['d', `p${((i * 3 + n) % 4) + 1}`, n === 24 && 'gold']} data-door={n} id={`t${n}`} aria-label={xa.door.replace('{n}', String(n))}>
              {kindOf(n) !== 'fact' && <span class="kind">{xa.kinds[kindOf(n)]}</span>}
              <span class="n">{n}</span>
              <span class="lock" aria-hidden="true">🔒</span>
              <span class="go" aria-hidden="true">{xa.strip.open.replace('{n}', String(n))} ›</span>
              {BIG[n] && <span class="big" aria-hidden="true"><FestIcon name={BIG[n]} /></span>}
              <span class="ic" aria-hidden="true"><FestIcon name={ICONS[n % ICONS.length]} /></span>
              <span class="tt" data-tt></span>
              <span class="ck" aria-hidden="true">✓</span>
            </button>
          </li>
        ))}
      </ol>
      <aside class="side">
        <div class="box">
          <h2>{xa.tree}</h2>
          <p>{xa.treeText}</p>
          <XmasTree class="treebig" label={xa.tree} />
          <p class="count" data-x-balls>{xa.balls.replace('{n}', '0')}</p>
          <p class="count gold-c" data-x-gold hidden></p>
          <button type="button" class="btn btn--ghost wide" data-x-share>{xa.share}</button>
          <p class="copied" data-x-copied hidden>{xa.copied}</p>
        </div>
        <div class="box">
          <h2>{xa.legend}</h2>
          <ul class="legend">
            {(['fact', 'quiz', 'guess', 'gift', 'boot', 'finale'] as const).map((k) => <li><i>{xa.kinds[k]}</i> {xa.kindText[k]}</li>)}
          </ul>
        </div>
        <div class="box wichtel">
          <Wichtel class="wi" />
          <div><h2>{xa.wichtel.title}</h2><p data-x-wichtel>{xa.wichtel.text}</p></div>
        </div>
      </aside>
    </div>
  </section>

</Base>

<script>
  import { xmasToday, fill } from '../../scripts/xmas';
  import { adventState, openDoor, paintTrees, saveGame } from '../../scripts/advent';
  import { doorDay, wichtelKey, inSeason } from '../../data/advent';
  import { daysBetween, nextDayStart, addDays } from '../../week';

  type Fact = { key: string; title: string; hook: string; url: string; emoji: string; cat: string; catCls: string; products: { name: string; why: string; url: string }[] };
  type Door = { kind: string; facts: Fact[]; quiz: { text: string; ok: boolean; url: string | null }[]; guess: { q: string; answer: number; unit: string } | null };

  const root = document.querySelector<HTMLElement>('[data-x-cal]');
  const dlg = document.querySelector<HTMLDialogElement>('[data-x-dlg]');
  if (root && dlg) {
    const T = JSON.parse(root.dataset.texts!);
    const DOORS: Record<string, Door> = JSON.parse(root.dataset.doors!);
    const CATS: Record<string, string> = JSON.parse(root.dataset.cats!);
    const year = Number(root.dataset.year);
    const tries = Number(root.dataset.guessTries);
    const hitShare = Number(root.dataset.guessHit);
    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls = '', text = '') => {
      const e = document.createElement(tag);
      if (cls) e.className = cls;
      if (text) e.textContent = text;
      return e;
    };
    const ready = (n: number) => xmasToday() >= doorDay(year, n);

    // ---------- Türchen einfärben ----------
    const paint = () => {
      const day = xmasToday();
      const v = paintTrees(year);
      root.querySelectorAll<HTMLButtonElement>('[data-door]').forEach((b) => {
        const n = Number(b.dataset.door);
        const open = v.open.includes(n) && !!DOORS[n];
        b.dataset.state = open ? 'open' : day === doorDay(year, n) ? 'today' : ready(n) ? 'ready' : 'locked';
        b.querySelector('[data-tt]')!.textContent = open ? DOORS[n].facts.map((f) => f.title).join(' · ') : '';
      });
      root.querySelector('[data-x-balls]')!.textContent = fill(T.balls, { n: v.open.length });
      const gold = root.querySelector<HTMLElement>('[data-x-gold]')!;
      gold.hidden = !v.wichtel.length;
      gold.textContent = fill(T.gold, { n: v.wichtel.length });
      // Wichtel des Tages
      const wk = wichtelKey(day);
      const w = root.querySelector('[data-x-wichtel]')!;
      if (v.wichtel.includes(day)) w.textContent = T.wichtel.found;
      else if (wk) w.textContent = `${T.wichtel.text} ${fill(T.wichtel.hint, { cat: CATS[wk] ?? '' })}`;
      else w.textContent = day < doorDay(year, 2) ? T.wichtel.soon : T.wichtel.gone;
    };

    // ---------- Countdown bis zum nächsten Türchen ----------
    const cd = document.querySelector<HTMLElement>('[data-x-cd]')!;
    const tick = () => {
      const day = xmasToday();
      const first = doorDay(year, 1);
      let target = '';
      if (day < first) target = first;
      else if (day < doorDay(year, 24)) target = addDays(day, 1);
      if (!target) { cd.textContent = day > `${year}-12-26` || !inSeason(day) ? T.archive : T.nextDone; return; }
      const ms = Math.max(0, nextDayStart(addDays(target, -1)) - Date.now());
      const parts = [Math.floor(ms / 864e5), Math.floor(ms / 36e5) % 24, Math.floor(ms / 6e4) % 60, Math.floor(ms / 1e3) % 60];
      const n = Number(target.slice(8));
      cd.textContent = `${fill(T.next, { n })} `;
      const units = [T.units.d, T.units.h, T.units.m, T.units.s];
      parts.forEach((p, k) => {
        if (k === 0 && !p) return;
        const b = el('b', '', String(p).padStart(k ? 2 : 1, '0'));
        b.title = units[k];
        cd.append(b, k < 3 ? (k === 0 ? ` ${units[0]} ` : ':') : '');
      });
      if (day < first && daysBetween(day, first) > 30) cd.textContent = T.preview;
    };
    tick();
    setInterval(tick, 1000);

    // ---------- Türchen öffnen ----------
    const head = dlg.querySelector('[data-x-head]')!;
    const body = dlg.querySelector<HTMLElement>('[data-x-body]')!;
    const factBlock = (f: Fact, big: boolean) => {
      const box = el('div', 'fact');
      const chip = el('span', `chip ${f.catCls}`, f.cat);
      const h = el(big ? 'p' : 'h3', big ? 'hook' : 'ft', big ? f.hook : f.title);
      box.append(chip);
      if (!big) box.append(h, el('p', 'hook', f.hook)); else box.append(h);
      const a = el('a', 'btn go', `${T.read} ›`);
      a.href = f.url;
      box.append(a);
      return box;
    };
    const quizBlock = (d: Door, n: number) => {
      const box = el('div', 'game');
      box.append(el('h3', '', T.quiz.title), el('p', 'small', T.quiz.intro));
      const list = el('ol', 'quiz');
      let answered = 0, right = 0;
      const score = el('p', 'score');
      d.quiz.forEach((q) => {
        const li = el('li');
        li.append(el('span', 'qt', q.text));
        const row = el('span', 'qb');
        const res = el('span', 'qr');
        [true, false].forEach((val) => {
          const b = el('button', 'chip', val ? T.quiz.yes : T.quiz.no);
          b.type = 'button';
          b.setAttribute('aria-pressed', 'false');
          b.addEventListener('click', () => {
            row.querySelectorAll('button').forEach((x) => ((x as HTMLButtonElement).disabled = true));
            b.setAttribute('aria-pressed', 'true');
            const ok = val === q.ok;
            res.textContent = `${ok ? T.quiz.right : T.quiz.wrong} ${q.ok ? T.quiz.yes : T.quiz.no}. `;
            res.dataset.ok = String(ok);
            if (q.url) { const a = el('a', '', T.quiz.more); a.href = q.url; res.append(a); }
            answered++; if (ok) right++;
            if (answered === d.quiz.length) { score.textContent = fill(T.quiz.score, { n: right }); saveGame(year, n, right === d.quiz.length); }
          });
          row.append(b);
        });
        li.append(row, res);
        list.append(li);
      });
      box.append(list, score);
      return box;
    };
    const guessBlock = (d: Door, n: number) => {
      const g = d.guess!;
      const box = el('div', 'game');
      box.append(el('h3', '', T.guess.title), el('p', 'qt', g.q));
      const form = el('form', 'gform');
      const input = el('input');
      input.type = 'number'; input.inputMode = 'decimal'; input.placeholder = T.guess.placeholder; input.required = true; input.min = '0';
      const unit = el('span', 'unit', g.unit);
      const btn = el('button', 'btn go', T.guess.submit);
      btn.type = 'submit';
      const res = el('p', 'score');
      res.setAttribute('aria-live', 'polite');
      let left = tries;
      form.append(input, unit, btn);
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const v = Number(input.value.replace(',', '.'));
        if (!Number.isFinite(v)) return;
        left--;
        const hit = Math.abs(v - g.answer) <= g.answer * hitShare;
        const done = hit || left <= 0;
        res.textContent = hit ? T.guess.hit : `${v < g.answer ? T.guess.more : T.guess.less} ${done ? '' : left === 1 ? T.guess.triesOne : fill(T.guess.tries, { n: left })}`;
        if (done) {
          res.append(' ', fill(T.guess.answer, { n: `${g.answer.toLocaleString(document.documentElement.lang)} ${g.unit}` }));
          input.disabled = true; btn.disabled = true;
          saveGame(year, n, hit);
        }
        input.value = '';
      });
      box.append(form, res);
      return box;
    };
    const giftBlock = (d: Door) => {
      const box = el('div', 'game gift');
      box.append(el('h3', '', T.gift.title));
      const ul = el('ul', 'prods');
      d.facts[0].products.forEach((p) => {
        const li = el('li');
        const a = el('a', '', p.name);
        a.href = p.url; a.rel = 'sponsored noopener'; a.target = '_blank';
        li.append(a, el('span', 'small', p.why));
        ul.append(li);
      });
      const fin = el('a', 'more', `${T.gift.finder} ›`);
      fin.href = T.giftsUrl;
      box.append(ul, el('p', 'small ad', T.ad), fin);
      return box;
    };

    const show = (n: number) => {
      const d = DOORS[n];
      dlg.querySelector('[data-x-num]')!.textContent = String(n);
      dlg.querySelector('[data-x-kind]')!.textContent = `${fill(T.door, { n })}${d && d.kind !== 'fact' ? ` · ${T.kinds[d.kind]}` : ''}`;
      body.textContent = '';
      const ballBox = dlg.querySelector<HTMLElement>('[data-x-ballbox]')!;
      if (!d) {
        head.textContent = fill(T.door, { n });
        body.append(el('p', 'hook', T.notYet));
        ballBox.hidden = true;
      } else {
        const first = openDoor(year, n);
        const v = adventState(year);
        if (d.kind === 'boot') {
          head.textContent = T.boot;
          d.facts.forEach((f) => body.append(factBlock(f, false)));
        } else {
          head.textContent = d.kind === 'finale' ? `${T.finale} ${d.facts[0].title}` : d.facts[0].title;
          if (d.kind === 'quiz' && d.quiz.length) body.append(quizBlock(d, n));
          if (d.kind === 'guess' && d.guess) body.append(guessBlock(d, n));
          body.prepend(factBlock(d.facts[0], true));
          if (d.kind === 'gift' && d.facts[0].products.length) body.append(giftBlock(d));
        }
        const left = 24 - v.open.length;
        dlg.querySelector('[data-x-ball]')!.textContent = fill(left ? T.ball : T.ballFull, { n: v.open.length, left });
        ballBox.hidden = false;
        dlg.toggleAttribute('data-first', first);
        paint();
      }
      if (!dlg.open) dlg.showModal();
      history.replaceState(null, '', `#t${n}`);
    };
    const wiggle = (b: HTMLElement, n: number) => {
      const days = daysBetween(xmasToday(), doorDay(year, n));
      b.dataset.msg = days === 1 ? T.locked.one : fill(T.locked.many, { n: days });
      b.removeAttribute('data-wiggle');
      void b.offsetWidth;
      b.setAttribute('data-wiggle', '');
    };
    root.querySelectorAll<HTMLButtonElement>('[data-door]').forEach((b) =>
      b.addEventListener('click', () => {
        const n = Number(b.dataset.door);
        if (ready(n)) show(n); else wiggle(b, n);
      }),
    );
    dlg.querySelector('[data-x-close]')!.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('close', () => history.replaceState(null, '', location.pathname + location.search));

    // Baum teilen
    root.querySelector('[data-x-share]')!.addEventListener('click', async () => {
      const text = `${fill(T.share, { n: adventState(year).open.length })} 🎄 ${location.origin}${location.pathname}`;
      try {
        if (navigator.share) await navigator.share({ text });
        else { await navigator.clipboard.writeText(text); root.querySelector<HTMLElement>('[data-x-copied]')!.hidden = false; }
      } catch { /* abgebrochen */ }
    });

    paint();
    addEventListener('wtfact-advent', paint);
    const m = location.hash.match(/^#t(\d{1,2})$/);
    if (m && ready(Number(m[1]))) show(Number(m[1]));
  }
</script>

<style>
  .xhero { position: relative; padding-block: calc(var(--space-6) + var(--xmas-lights-h)) var(--space-12); overflow: clip; }
  .xhero .wrap { position: relative; z-index: 2; }
  .heroart { position: absolute; right: 4%; top: 50%; translate: 0 -50%; z-index: 1; font-size: var(--fs-fest-art); line-height: 1; }
  .heroart :global(.fi) { filter: var(--fest-art-shadow); }
  .pills { display: flex; flex-wrap: wrap; gap: var(--space-3); align-items: center; }
  .pill {
    display: inline-block; padding: var(--space-2) var(--space-4); border-radius: var(--radius-pill); border: var(--bw) solid var(--on-accent);
    background: var(--surface); color: var(--ink); font-family: var(--font-display); font-weight: 700; box-shadow: var(--shadow-on-night); transform: rotate(-2deg);
  }
  .word { margin: var(--space-4) 0; font-family: var(--font-headline); font-weight: 400; font-size: var(--fs-huge); line-height: 0.9; color: var(--fest-a); max-width: 12ch; }
  .sub { margin: 0 0 var(--space-6); font-size: var(--fs-xl); line-height: 1.4; max-width: 40ch; color: var(--on-night); }
  .cd { display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: center; margin: 0; font-weight: 700; font-size: var(--fs-sm); min-height: var(--space-10); }
  .cd :global(b) {
    background: var(--fest-a); color: var(--on-accent); border: var(--bw) solid var(--on-accent); border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-3); font-family: var(--font-headline); font-weight: 400; font-size: var(--fs-2xl); line-height: 1; box-shadow: var(--shadow-night-pink);
  }
  .wall { padding-block: var(--space-10) var(--space-12); }
  .wall > .wrap { position: relative; z-index: 2; display: grid; grid-template-columns: minmax(0, 1fr) var(--xmas-side); gap: var(--space-8); align-items: start; }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); grid-auto-rows: var(--xmas-cell); gap: var(--space-4); grid-auto-flow: dense; }
  .cell { display: flex; }
  .w2 { grid-column: span 2; }
  .h2 { grid-row: span 2; }
  .d {
    position: relative; display: flex; flex-direction: column; justify-content: space-between; align-items: flex-start; width: 100%; overflow: hidden;
    padding: var(--space-3); border: var(--bw-strong) solid var(--on-accent); border-radius: var(--radius-md); color: var(--on-accent);
    box-shadow: var(--shadow-accent-sm); cursor: pointer; text-align: left; font: inherit;
    transition: transform var(--dur) var(--ease);
  }
  .d:hover { transform: translate(calc(-1 * var(--space-1)), calc(-1 * var(--space-1))); }
