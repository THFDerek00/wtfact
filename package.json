{
  "name": "wtfact",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "node --disable-warning=ExperimentalWarning scripts/facts-db.mjs build && node --disable-warning=ExperimentalWarning scripts/check-posts.mjs && node --disable-warning=ExperimentalWarning scripts/check-golden.mjs && node scripts/check-design.mjs && node scripts/check-slots.mjs && node scripts/check-quiz.mjs && node scripts/check-gifts.mjs",
    "prebuild": "node --disable-warning=ExperimentalWarning scripts/facts-db.mjs build && node --disable-warning=ExperimentalWarning scripts/check-posts.mjs && node --disable-warning=ExperimentalWarning scripts/check-golden.mjs && node scripts/check-design.mjs && node scripts/check-slots.mjs && node scripts/check-quiz.mjs && node scripts/check-gifts.mjs",
    "build": "astro build && node scripts/bundle-steuerung.mjs",
    "preview": "astro preview",
    "post": "node --disable-warning=ExperimentalWarning scripts/generate-post.mjs",
    "db:build": "node --disable-warning=ExperimentalWarning scripts/facts-db.mjs build",
    "db:dump": "node --disable-warning=ExperimentalWarning scripts/facts-db.mjs dump",
    "db:stats": "node --disable-warning=ExperimentalWarning scripts/facts-db.mjs stats",
    "check:design": "node scripts/check-design.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.0.0",
    "@fontsource-variable/inter": "^5.0.0",
    "@fontsource-variable/space-grotesk": "^5.0.0",
    "@fontsource/abril-fatface": "^5.3.0",
    "@fontsource/amatic-sc": "^5.3.0",
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/bungee-inline": "^5.3.0",
    "@fontsource/bungee-shade": "^5.3.0",
    "@fontsource/cherry-bomb-one": "^5.3.0",
    "@fontsource/cinzel-decorative": "^5.3.0",
    "@fontsource/creepster": "^5.3.0",
    "@fontsource/fascinate": "^5.3.0",
    "@fontsource/henny-penny": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/lobster": "^5.3.0",
    "@fontsource/monoton": "^5.3.0",
    "@fontsource/mountains-of-christmas": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@fontsource/pirata-one": "^5.3.0",
    "@fontsource/righteous": "^5.3.0",
    "@fontsource/rubik-wet-paint": "^5.3.0",
    "@fontsource/rye": "^5.3.0",
    "@fontsource/sancreek": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/uncial-antiqua": "^5.3.0",
    "@fontsource/unifrakturmaguntia": "^5.3.0",
    "@fontsource/yatra-one": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^5.0.0",
    "satori": "^0.33.5",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@types/three": "^0.170.0",
    "zod": "^4.6.5"
  }
}
